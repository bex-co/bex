# bex-api GraphQL endpoint (used by the browser / CSR)
# Development: local bex-api instance (see ../operator, docs/bex-api.md)
# Production: e.g. https://api.bex.co/graphql
# Prod via dev proxy:  http://localhost:5173/graphql (README "Local dev against
#                      prod" — never https://api.bex.co directly from a localhost
#                      page; prod CORS only allows dashboard.bex.co and the
#                      session cookie is host-only on localhost. vite.config.ts's
#                      /graphql proxy tunnels it same-origin, like /kratos.)
VITE_API_URL=http://localhost:8090/graphql

# SSR API URL (optional, used by the Node.js SSR server)
# When running in a cluster, the SSR server may need to reach bex-api via an
# internal service URL while the browser still uses the public VITE_API_URL above.
# If not set, defaults to VITE_API_URL.
# VITE_SSR_API_URL=http://bex-api.bex-system.svc:8090/graphql

# Ory Kratos public API (self-service login/registration/recovery/settings — docs/auth.md)
# Local mock cluster:  http://localhost:4433 (kubectl port-forward, README "Local dev")
# Prod via dev proxy:  http://localhost:5173/kratos (README "Local dev against prod" —
#                      never https://auth.bex.co directly from a localhost page; its
#                      SameSite=Lax cookies won't be sent cross-site)
VITE_KRATOS_PUBLIC_URL=https://auth.bex.co

# SSR Kratos URL (optional, used by the Node.js SSR server)
# The dashboard's own pod reaches Kratos via the in-cluster Service directly
# instead of going back out through the public ingress. If not set, defaults
# to VITE_KRATOS_PUBLIC_URL.
# VITE_KRATOS_SSR_URL=http://kratos-public.auth.svc:80
