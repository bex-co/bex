{
  "name": "dashboard",
  "private": true,
  "version": "0.0.0",
  "packageManager": "yarn@4.17.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5173",
    "local-bex": "node scripts/local-bex.mjs",
    "dev:local": "VITE_API_URL=http://localhost:8099/graphql VITE_KRATOS_PUBLIC_URL=http://localhost:8099 VITE_KRATOS_SSR_URL=http://localhost:8099 HYDRA_ADMIN_URL=http://localhost:8099 vite dev --port 5173",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "start": "PORT=5173 node .output/server/index.mjs",
    "generate-routes": "tsr generate",
    "preview": "yarn build && yarn start",
    "typecheck": "yarn generate-routes && tsc -b",
    "lint": "yarn generate-routes && tsc -b && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "codegen": "graphql-codegen --config codegen.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "kill": "lsof -n -i4TCP:5173 | grep LISTEN | awk '{ print $2 }' | xargs kill"
  },
