{
  "expo": {
    "name": "bex",
    "slug": "bex-mobile",
    "scheme": ["bex", "co.bex.mobile"],
    "version": "0.1.0",
    "platforms": ["ios", "android"],
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./src/assets/images/icon.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.bex.mobile",
      "associatedDomains": ["applinks:dashboard.bex.co"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "2"
    },
    "android": {
      "package": "co.bex.mobile",
      "permissions": [],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "dashboard.bex.co",
              "path": "/invite"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./src/assets/fonts/JetBrainsMono-Regular.ttf",
            "./src/assets/fonts/JetBrainsMono-Medium.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/icon.png",
          "resizeMode": "contain",
          "imageWidth": 160,
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-asset",
        {
          "assets": ["./src/assets/images/icon.png"]
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "defaultChannel": "bex-alerts",
          "color": "#16a34a"
        }
      ],
      "expo-router",
      "expo-status-bar",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dba70c4b-4aae-4bf9-a461-a19bcae69b3a"
      }
    },
    "owner": "puncsky"
  }
}
