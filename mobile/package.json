{
  "name": "@bex/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src --quiet",
    "test:unit": "node ./scripts/jest-lite-runner.js",
    "test": "yarn format:check && yarn typecheck && yarn lint && yarn test:unit && yarn expo:check",
    "format": "prettier . --cache --write",
    "format:check": "prettier . --cache --check",
    "expo:check": "expo install --check && expo config --type public",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:backend": "bash scripts/generate-graphql.sh",
    "bundle:ios": "expo export --platform ios --output-dir dist/ios",
    "bundle:android": "expo export --platform android --output-dir dist/android"
  },
  "dependencies": {
    "@apollo/client": "^4.2.9",
    "@callstack/react-theme-provider": "^3.0.9",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "expo": "~57.0.14",
    "expo-asset": "~57.0.12",
    "expo-auth-session": "~57.0.7",
    "expo-constants": "~57.0.12",
    "expo-crypto": "~57.0.1",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-linking": "~57.0.6",
    "expo-localization": "~57.0.0",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.14",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.0",
    "expo-web-browser": "~57.0.2",
    "graphql": "^16.11.0",
    "i18n-js": "^4.5.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "^6.0.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pager-view": "8.0.2",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/node": "^26.1.0",
    "@types/react": "~19.2.7",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "prettier": "^3.7.4",
    "typescript": "~6.0.3"
  }
}
