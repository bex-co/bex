# Public build-time configuration only. Never put credentials in EXPO_PUBLIC_*.
EXPO_PUBLIC_BEX_API_URL=https://api.bex.co
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_BEX_OAUTH_ISSUER=https://oauth.bex.co
EXPO_PUBLIC_BEX_OAUTH_CLIENT_ID=bex-mobile
# Must equal bex-api's canonical BEX_OAUTH_RESOURCE (config/api/deployment.yaml),
# not the bare API origin: auth.go rejects a token whose non-empty `aud` omits it.
EXPO_PUBLIC_BEX_OAUTH_AUDIENCE=https://api.bex.co/mcp

# App Store Connect listing metadata (`eas metadata:push`, store.config.js).
# Reviewer contact + demo account. Never commit real values.
ASC_REVIEW_FIRST_NAME=
ASC_REVIEW_LAST_NAME=
ASC_REVIEW_EMAIL=
ASC_REVIEW_PHONE=
ASC_DEMO_USERNAME=
ASC_DEMO_PASSWORD=
