{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BackupReaderListPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::__BUCKET__",
      "Condition": { "StringLike": { "s3:prefix": ["__PREFIX__", "__PREFIX__/*"] } }
    },
    {
      "Sid": "BackupReaderReadObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::__BUCKET__/__PREFIX__/*"
    }
  ]
}
