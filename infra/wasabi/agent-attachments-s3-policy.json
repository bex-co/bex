{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AgentAttachmentsBucketLocation",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::bex-agent-attachments"
    },
    {
      "Sid": "AgentAttachmentsObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::bex-agent-attachments/*"
    }
  ]
}
