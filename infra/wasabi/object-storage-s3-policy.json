{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ObjectStorageBucketLocationAndList",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::bex-objects-oregon", "arn:aws:s3:::bex-objects-frankfurt"]
    },
    {
      "Sid": "ObjectStorageObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::bex-objects-oregon/*", "arn:aws:s3:::bex-objects-frankfurt/*"]
    }
  ]
}
