{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DiskSnapshotReadBucketMetadata",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::bex-disk-snapshots"
    },
    {
      "Sid": "DiskSnapshotReadObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::bex-disk-snapshots/*"
    }
  ]
}
