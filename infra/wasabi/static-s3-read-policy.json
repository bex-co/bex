{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadStaticBucketMetadata",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::bex-static"
    },
    {
      "Sid": "ReadStaticObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::bex-static/*"
    }
  ]
}
