+// maxPendingRecordBytes bounds the partial chunks held per stream. A longer
+// record is written as it arrives, as before, once this much is pending.
+const maxPendingRecordBytes = 1 << 20
+
+// pendingRecord is one stream's logical record still awaiting its final chunk.
+type pendingRecord struct {
+	timestamp time.Time
+	log       []byte
+	open      bool
+	// streaming: an over-budget record was partly written; its remaining
+	// chunks follow unprefixed until it completes.
+	streaming bool
+}
+
+// recordAssembler writes each logical record whole, stamped with its first
+// chunk's time. The runtime splits a long line into partial chunks and a line
+// on the other stream can land between them; writing chunks as they came
+// joined the two records whenever stdout and stderr shared one writer.
+type recordAssembler struct {
+	writer  *logWriter
+	pending map[runtimeapi.LogStreamType]*pendingRecord
+}
+
+func newRecordAssembler(writer *logWriter) *recordAssembler {
+	return &recordAssembler{writer: writer, pending: map[runtimeapi.LogStreamType]*pendingRecord{}}
+}
+
+func (a *recordAssembler) write(msg *logMessage) error {
+	complete := len(msg.log) > 0 && msg.log[len(msg.log)-1] == eol[0]
+	p := a.pending[msg.stream]
+	if p == nil {
+		p = &pendingRecord{}
+		a.pending[msg.stream] = p
+	}
+	if p.streaming {
+		p.streaming = !complete
+		// The record's first-chunk time decides the since filter, as for its head.
+		return a.writer.write(&logMessage{timestamp: p.timestamp, stream: msg.stream, log: msg.log}, false)
+	}
+	if !p.open {
+		if complete {
+			return a.writer.write(msg, true)
 		}
+		p.timestamp, p.open = msg.timestamp, true
 	}
+	p.log = append(p.log, msg.log...)
+	if !complete && len(p.log) < maxPendingRecordBytes {
+		return nil
+	}
+	p.streaming = !complete
+	return a.emit(msg.stream, p)
+}
+
+// flush writes every record still incomplete when reading stops.
+func (a *recordAssembler) flush() error {
+	for _, stream := range []runtimeapi.LogStreamType{runtimeapi.Stdout, runtimeapi.Stderr} {
+		if p := a.pending[stream]; p != nil && p.open {
+			if err := a.emit(stream, p); err != nil {
+				if err == errMaximumWrite {
+					return nil
+				}
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+func (a *recordAssembler) emit(stream runtimeapi.LogStreamType, p *pendingRecord) error {
+	record := &logMessage{timestamp: p.timestamp, stream: stream, log: p.log}
+	p.log, p.open = nil, false
+	return a.writer.write(record, true)
 }
 
