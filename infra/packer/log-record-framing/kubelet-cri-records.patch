+		"2026-10-11T10:00:00.200000002Z {\"case\":\"mixed\",\"v\":\"" + head + head + "tail\"}\n",
+		"2026-10-11T10:00:01.100000007Z 2026-10-11T10:00:00Z looks-like-a-stamp\n",
+		"2026-10-11T10:00:01.000000006Z err-a-err-b\n",
