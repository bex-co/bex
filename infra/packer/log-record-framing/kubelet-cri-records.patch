+// bex w4/m200: an unterminated record is flushed at EOF, and a record above
+// the pending budget streams on instead of growing without bound.
+func TestReadLogsPendingRecordBounds(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "0.log")
+	chunk := strings.Repeat("b", 16384)
+	var b strings.Builder
+	for i := 0; i < maxPendingRecordBytes/len(chunk)+2; i++ {
+		b.WriteString("2026-10-11T10:00:00.000000001Z stdout P " + chunk + "\n")
+	}
+	b.WriteString("2026-10-11T10:00:00.000000002Z stdout F end\n")
+	b.WriteString("2026-10-11T10:00:00.000000003Z stderr P unterminated\n")
+	require.NoError(t, os.WriteFile(path, []byte(b.String()), 0o600))
+
+	var out, errOut bytes.Buffer
+	opts := NewLogOptions(&v1.PodLogOptions{}, time.Now())
+	require.NoError(t, ReadLogs(context.Background(), nil, path, "", opts, nil, &out, &errOut))
+	n := maxPendingRecordBytes/len(chunk) + 2
+	assert.Equal(t, strings.Repeat(chunk, n)+"end\n", out.String())
+	assert.Equal(t, "unterminated", errOut.String())
+
+	// A streamed over-budget record is filtered by its first chunk too: no
+	// orphan tail when that chunk is older than since.
+	out.Reset()
+	errOut.Reset()
+	since := NewLogOptions(&v1.PodLogOptions{SinceTime: &metav1.Time{Time: time.Date(2026, 10, 11, 10, 0, 0, 2, time.UTC)}}, time.Now())
+	require.NoError(t, ReadLogs(context.Background(), nil, path, "", since, nil, &out, &errOut))
+	assert.Empty(t, out.String())
+	assert.Equal(t, "unterminated", errOut.String())
+}
