+// reach a shared writer whole, stamped with its first chunk's time.
+func TestReadLogsKeepsInterleavedPartialRecordsWhole(t *testing.T) {
+	head := strings.Repeat("a", 16384)
+	lines := []string{
+		"2026-10-11T10:00:00.100000001Z stdout F short-out\n",
+		"2026-10-11T10:00:00.200000002Z stdout P {\"case\":\"mixed\",\"v\":\"" + head + "\n",
+		"2026-10-11T10:00:00.200000003Z stdout P " + head + "\n",
+		"2026-10-11T10:00:00.250000004Z stderr F {\"case\":\"mixed-err\"}\n",
+		"2026-10-11T10:00:00.380000005Z stdout F tail\"}\n",
+		"2026-10-11T10:00:01.000000006Z stderr P err-a-\n",
+		"2026-10-11T10:00:01.100000007Z stdout F 2026-10-11T10:00:00Z looks-like-a-stamp\n",
+		"2026-10-11T10:00:01.200000008Z stderr F err-b\n",
+		"2026-10-11T10:00:01.300000009Z stdout F \n",
+	}
+	path := filepath.Join(t.TempDir(), "0.log")
