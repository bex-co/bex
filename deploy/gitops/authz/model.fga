# bex platform authorization model (docs/ADR012-auth.md) — the human-readable source.
# The applied artifact is model.json (OpenFGA's wire format, same directory);
# when you edit this file, regenerate it:  fga model transform --file model.fga
# scripts/authz-model.sh applies model.json idempotently; scripts/
# gitops-validate.sh gates the pair against drift.
#
# The shape mirrors Render.com's permissions management, verified live against
# the real dashboard's GraphQL on 2026-07-06 (docs/render-artifacts/
# team-members.graphql) plus render.com/docs/team-members — bex is
# Render-consistent by design:
#
#   org        Render's Organization (Scale/Enterprise, docs/ADR115-
#              organizations.md): groups workspaces. Owner, Member and Guest.
#              An Owner manages the org but is NOT a workspace admin until
#              they join a workspace ("Org Owners are not automatically added
#              to any workspaces", render.com/docs/organizations).
#   workspace  Render's workspace — the same entity Render's GraphQL calls
#              `owner.team` (id prefix "tea-") and its resource parent `owner`
#              (owner = user | team). The billing/ownership unit.
#              Five member roles; Render's `role` enum is UPPERCASE on the wire
#              (ADMIN/DEVELOPER/CONTRIBUTOR/VIEWER/BILLING — live-verified), which
#              a future bex members API returns verbatim and maps to these
#              lowercase FGA relations. Render's names and semantics:
#     admin        full resources + org settings (members, billing, protected envs)
#     developer    full resource access, no org settings
#     contributor  works on resources but no sensitive fields (connection
#                  strings, env vars), no create/delete of most resources
#     viewer       read-only, and NOT logs or sensitive fields
#     billing      billing only (+ non-sensitive names)
#
# Derived permissions consumed by bex-api (lego/backend/internal/api/authz.go):
#   can_view            resource lists/details            viewer and up
#   can_view_activity   events, deploys, metrics          viewer and up, not billing
#                       (Render's "View service events/metrics", w9/m621)
#   can_view_logs       service logs                      contributor and up
#   can_operate         restart/suspend/resume services   contributor and up
#   can_create          create/delete resources           developer and up
#   can_view_sensitive  connection strings, env vars      developer and up
#   can_manage_keys     every member's API keys           developer and up
#   can_manage_ssh_keys own SSH and API keys (w9/m514)    every member role
#   can_manage          workspace settings/members        admin
#   can_manage_billing  billing settings                  billing or admin
#   can_view_billing    usage, cost, invoices, readiness  developer, admin, billing
#                       (Render's "View billing details", w9/m620)
#
# Subjects (`user`) are what the auth gate resolves via api.IdentityFrom: a
# Hydra client_id (API key) or a Kratos identity id. Each check targets the
# caller's workspace — workspace:tea-<id> for a tenant member or a bound key
# (w1/m9 mint-on-first-login + key→tenant binding) — falling back to
# workspace:default only for the platform bootstrap and the legacy store-off
# mode. Per-service (service:srv-<id>) tuples are a future grant; today the
# tenant label on each App CR scopes List/Get, not a service tuple.

model
  schema 1.1

type user

type org
  relations
    define owner: [user]
    define member: [user] or owner
    define guest: [user]

    # An Owner manages the org (name, members, invites, the org audit log)
    # and creates its workspaces; a Member or Guest reads it (a Guest only
    # their own workspace, which the service filters).
    define can_manage: owner
    define can_create: owner
    define can_view: member or guest

type workspace
  relations
    # org links every workspace of an org; public_org links it only while
    # the workspace is Public. An Org Member may add themselves to a Public
    # workspace, an Owner to any org workspace as admin (ADR115 D5).
    define org: [org]
    define public_org: [org]
    define can_join: member from public_org
    define can_join_as_admin: owner from org

    define admin: [user]
    define developer: [user]
    define contributor: [user]
    define viewer: [user]
    define billing: [user]

    define can_view: viewer or contributor or developer or admin or billing
    define can_view_activity: viewer or contributor or developer or admin
    define can_view_logs: contributor or developer or admin
    define can_operate: contributor or developer or admin
    define can_create: developer or admin
    define can_view_sensitive: developer or admin
    define can_manage_keys: developer or admin
    define can_manage_ssh_keys: viewer or contributor or developer or admin or billing
    define can_manage: admin
    define can_manage_billing: billing or admin
    define can_view_billing: developer or admin or billing

type service
  relations
    define workspace: [workspace]
    define can_view: can_view from workspace
    define can_operate: can_operate from workspace
    define can_manage: can_manage from workspace

type postgres
  relations
    define workspace: [workspace]
    define can_view: can_view from workspace
    define can_view_sensitive: can_view_sensitive from workspace
    define can_manage: can_manage from workspace

type api_key
  relations
    define workspace: [workspace]
    define can_view: can_view from workspace
    define can_manage: can_manage_keys from workspace

# Cloud coding-agent sessions are first-class authorization objects (ADR047
# gap 6). The sole direct tuple is workspace:<id> workspace
# agent_session:<id>; every decision is inherited from that parent, so callers
# cannot reach a session merely by knowing its id or by passing ownerId.
type agent_session
  relations
    define workspace: [workspace]
    define can_view: can_view from workspace
    define can_operate: can_operate from workspace
    # can_create is inherited so a session verb that provisions a FRESH
    # credential-bearing sandbox (Steer re-dispatches one with the workspace's
    # reusable model key and a caller-supplied prompt) can gate on the same
    # developer-and-up relation Create does, against the session object rather
    # than the caller's default workspace (codex round-4 #3).
    define can_create: can_create from workspace
    # can_view_sensitive gates a real shell into the session's sandbox — the
    # "Open in Zed" / ags-<id>@ssh.bex.co SSH path (ADR054 D2). A sandbox shell
    # reads the gateway-refreshed Git token, the BYO model key, and the whole
    # working tree, so — mirroring App SSH / Web Shell — it must gate on the
    # SINK's relation, not the transport's: can_operate (which attach/steer use)
    # is too weak, since a contributor holds can_operate + can_manage_ssh_keys
    # and could otherwise enroll a key and read credentials attach never reveals.
    define can_view_sensitive: can_view_sensitive from workspace
