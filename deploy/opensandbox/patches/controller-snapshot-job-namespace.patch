--- a/kubernetes/cmd/controller/main.go
+++ b/kubernetes/cmd/controller/main.go
@@ -226,6 +226,9 @@ func main() {
 	var resumePullSecret string
 	flag.StringVar(&resumePullSecret, "resume-pull-secret", "", "K8s Secret name for pulling snapshot images during resume.")
 
+	var snapshotJobNamespace string
+	flag.StringVar(&snapshotJobNamespace, "snapshot-job-namespace", "", "Namespace to run snapshot commit/unpause Jobs in instead of each SandboxSnapshot's own namespace. The Jobs mount the containerd socket via hostPath, which PodSecurity baseline forbids; a dedicated privileged namespace keeps sandbox namespaces hardened. In this mode snapshot repositories are additionally nested under the sandbox's namespace (<registry>/<namespace>/<sandbox>-<container>) so registry ACLs can be scoped per tenant. Empty preserves the same-namespace behavior and flat repository layout.")
+
 	opts := zap.Options{}
 	opts.BindFlags(flag.CommandLine)
 
@@ -465,6 +468,7 @@ func main() {
 		SnapshotRegistryInsecure: snapshotRegistryInsecure,
 		SnapshotPushSecret:       snapshotPushSecret,
 		ImageCommitterPullSecret: imageCommitterPullSecret,
+		SnapshotJobNamespace:     snapshotJobNamespace,
 	}).SetupWithManager(mgr); err != nil {
 		setupLog.Error(err, "unable to create controller", "controller", "SandboxSnapshot")
 		os.Exit(1)
