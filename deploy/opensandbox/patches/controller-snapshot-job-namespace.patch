+// qualifiedJobName disambiguates Jobs from equally-named snapshots in different
+// namespaces when they share a dedicated job namespace. The historical
+// same-namespace name is preserved when no dedicated namespace is configured.
+func (r *SandboxSnapshotReconciler) qualifiedJobName(snapshot *sandboxv1alpha1.SandboxSnapshot, verb string) string {
+	if r.jobNamespace(snapshot) == snapshot.Namespace {
+		return fmt.Sprintf("%s-%s", snapshot.Name, verb)
+	}
+	nsHash := sha256.Sum256([]byte(snapshot.Namespace))
+	return fmt.Sprintf("%s-%s-%x", snapshot.Name, verb, nsHash[:4])
