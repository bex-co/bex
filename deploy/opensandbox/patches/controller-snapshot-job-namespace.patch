+func TestHandleCommittingReadsJobFromDedicatedNamespace(t *testing.T) {
+	snapshot := jobNamespaceTestSnapshot("snap-a", "tenant-a")
+	snapshot.Status.Phase = sandboxv1alpha1.SandboxSnapshotPhaseCommitting
+
+	r := newTestSnapshotReconciler(snapshot)
+	r.SnapshotJobNamespace = "snapshot-jobs"
+
+	job := &batchv1.Job{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      r.getJobName(snapshot),
+			Namespace: "snapshot-jobs",
+			Labels: map[string]string{
+				LabelSandboxSnapshotName:      snapshot.Name,
+				LabelSandboxSnapshotNamespace: snapshot.Namespace,
+			},
+		},
+		Status: batchv1.JobStatus{Succeeded: 1},
+	}
+	require.NoError(t, r.Create(context.Background(), job))
+
+	_, err := r.handleCommitting(context.Background(), snapshot)
+	require.NoError(t, err)
+
+	updated := &sandboxv1alpha1.SandboxSnapshot{}
+	require.NoError(t, r.Get(context.Background(),
+		types.NamespacedName{Name: "snap-a", Namespace: "tenant-a"}, updated))
+	assert.Equal(t, sandboxv1alpha1.SandboxSnapshotPhaseSucceed, updated.Status.Phase)
+}
+
+func TestHandleDeletionRemovesJobsInDedicatedNamespace(t *testing.T) {
+	now := metav1.Now()
+	snapshot := jobNamespaceTestSnapshot("snap-a", "tenant-a")
+	snapshot.DeletionTimestamp = &now
+	snapshot.Finalizers = []string{SandboxSnapshotFinalizer}
+
+	r := newTestSnapshotReconciler(snapshot)
+	r.SnapshotJobNamespace = "snapshot-jobs"
+
+	commitJob := &batchv1.Job{ObjectMeta: metav1.ObjectMeta{
+		Name: r.getJobName(snapshot), Namespace: "snapshot-jobs",
+	}}
+	unpauseJob := &batchv1.Job{ObjectMeta: metav1.ObjectMeta{
+		Name: r.getUnpauseJobName(snapshot), Namespace: "snapshot-jobs",
+	}}
+	require.NoError(t, r.Create(context.Background(), commitJob))
+	require.NoError(t, r.Create(context.Background(), unpauseJob))
+
+	_, err := r.handleDeletion(context.Background(), snapshot)
+	require.NoError(t, err)
+
+	for _, name := range []string{commitJob.Name, unpauseJob.Name} {
+		getErr := r.Get(context.Background(),
+			types.NamespacedName{Name: name, Namespace: "snapshot-jobs"}, &batchv1.Job{})
+		assert.True(t, errors.IsNotFound(getErr), "job %s should be deleted", name)
+	}
+}
+
+func TestSnapshotImageURINestsNamespaceInDedicatedMode(t *testing.T) {
+	snapshot := jobNamespaceTestSnapshot("snap-a", "tenant-a")
+	bs := &sandboxv1alpha1.BatchSandbox{
+		ObjectMeta: metav1.ObjectMeta{Name: "sbx", Namespace: "tenant-a"},
+	}
+
+	r := newTestSnapshotReconciler(snapshot)
+	r.SnapshotRegistry = "registry.example.com/snapshots"
+
+	// Default mode keeps the historical flat layout.
+	flat := r.snapshotImageURI(snapshot, bs, "main")
+	assert.Equal(t, "registry.example.com/snapshots/sbx-main:"+publicSnapshotImageTag("snap-a"), flat)
+
+	// Dedicated-job-namespace mode nests under the source namespace so
+	// registry pull ACLs can be scoped to one tenant's snapshots.
+	r.SnapshotJobNamespace = "snapshot-jobs"
+	nested := r.snapshotImageURI(snapshot, bs, "main")
+	assert.Equal(t, "registry.example.com/snapshots/tenant-a/sbx-main:"+publicSnapshotImageTag("snap-a"), nested)
+
+	// Two equally-named sandboxes in different namespaces get distinct repos.
+	other := jobNamespaceTestSnapshot("snap-a", "tenant-b")
+	assert.NotEqual(t, nested, r.snapshotImageURI(other, bs, "main"))
+}
+
+func TestGetCommitJobResultReadsPodsFromDedicatedNamespace(t *testing.T) {
+	snapshot := jobNamespaceTestSnapshot("snap-a", "tenant-a")
+	snapshot.Status.Phase = sandboxv1alpha1.SandboxSnapshotPhaseCommitting
+
+	r := newTestSnapshotReconciler(snapshot)
+	r.SnapshotJobNamespace = "snapshot-jobs"
+
+	jobName := r.getJobName(snapshot)
+	pod := &corev1.Pod{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      jobName + "-pod",
+			Namespace: "snapshot-jobs",
+			Labels:    map[string]string{"job-name": jobName},
+		},
+		Status: corev1.PodStatus{
+			ContainerStatuses: []corev1.ContainerStatus{{
+				Name: CommitJobContainerName,
+				State: corev1.ContainerState{Terminated: &corev1.ContainerStateTerminated{
+					ExitCode: 0,
+					Message:  `{"containers":[{"name":"main","image":"img","digest":"sha256:abc"}]}`,
+				}},
+			}},
+		},
+	}
+	require.NoError(t, r.Create(context.Background(), pod))
+
+	result, found, err := r.getCommitJobResult(context.Background(), r.jobNamespace(snapshot), jobName)
+	require.NoError(t, err)
+	require.True(t, found)
+	require.Len(t, result.Containers, 1)
+	assert.Equal(t, "sha256:abc", result.Containers[0].Digest)
+}
