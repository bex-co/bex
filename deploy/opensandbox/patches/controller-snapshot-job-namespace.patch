+// setJobOwner ties the Job to its snapshot for garbage collection when they
+// share a namespace. A cross-namespace owner reference is invalid in
+// Kubernetes, so when the Job runs in a dedicated SnapshotJobNamespace the
+// linkage is carried by labels instead and cleanup relies on
+// TTLSecondsAfterFinished plus the explicit deletes in handleDeletion.
+func (r *SandboxSnapshotReconciler) setJobOwner(snapshot *sandboxv1alpha1.SandboxSnapshot, job *batchv1.Job) error {
+	if job.Namespace != snapshot.Namespace {
