+func jobNamespaceTestSnapshot(name, namespace string) *sandboxv1alpha1.SandboxSnapshot {
+	return &sandboxv1alpha1.SandboxSnapshot{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      name,
+			Namespace: namespace,
+		},
+		Spec: sandboxv1alpha1.SandboxSnapshotSpec{
+			SandboxName: "sbx",
+		},
+		Status: sandboxv1alpha1.SandboxSnapshotStatus{
+			SourcePodName:  "sbx-0",
+			SourceNodeName: "node-1",
+			Containers: []sandboxv1alpha1.ContainerSnapshot{
+				{ContainerName: "main", ImageURI: "registry.example.com/snapshots/sbx-main:snap-x"},
+			},
+		},
+	}
+}
+
+func TestBuildCommitJobDefaultsToSnapshotNamespaceWithOwnerReference(t *testing.T) {
+	snapshot := jobNamespaceTestSnapshot("snap-a", "tenant-a")
+	r := newTestSnapshotReconciler(snapshot)
+
+	job, err := r.buildCommitJob(snapshot)
+	require.NoError(t, err)
+
+	assert.Equal(t, "tenant-a", job.Namespace)
+	assert.Equal(t, "snap-a-commit", job.Name)
+	require.Len(t, job.OwnerReferences, 1)
+	assert.Equal(t, "SandboxSnapshot", job.OwnerReferences[0].Kind)
+	assert.Equal(t, "snap-a", job.OwnerReferences[0].Name)
+	assert.Equal(t, "tenant-a", job.Labels[LabelSandboxSnapshotNamespace])
+}
+
+func TestBuildCommitJobDedicatedNamespaceOmitsCrossNamespaceOwner(t *testing.T) {
+	snapshot := jobNamespaceTestSnapshot("snap-a", "tenant-a")
+	r := newTestSnapshotReconciler(snapshot)
+	r.SnapshotJobNamespace = "snapshot-jobs"
+
+	job, err := r.buildCommitJob(snapshot)
+	require.NoError(t, err)
+
+	assert.Equal(t, "snapshot-jobs", job.Namespace)
+	// A namespaced owner reference cannot cross namespaces; linkage is by label.
+	assert.Empty(t, job.OwnerReferences)
+	assert.Equal(t, "snap-a", job.Labels[LabelSandboxSnapshotName])
+	assert.Equal(t, "tenant-a", job.Labels[LabelSandboxSnapshotNamespace])
+	// The hostPath containerd mount and source-node pinning are preserved.
+	assert.Equal(t, "node-1", job.Spec.Template.Spec.NodeName)
+}
+
+func TestQualifiedJobNamesDisambiguateAcrossSourceNamespaces(t *testing.T) {
+	snapA := jobNamespaceTestSnapshot("snap-a", "tenant-a")
+	snapB := jobNamespaceTestSnapshot("snap-a", "tenant-b")
+	r := newTestSnapshotReconciler(snapA, snapB)
+	r.SnapshotJobNamespace = "snapshot-jobs"
+
+	commitA := r.getJobName(snapA)
+	commitB := r.getJobName(snapB)
+	assert.NotEqual(t, commitA, commitB,
+		"equally-named snapshots from different namespaces must not collide in the shared job namespace")
+	assert.NotEqual(t, r.getUnpauseJobName(snapA), r.getUnpauseJobName(snapB))
+	// Names stay deterministic for lookup and deletion.
+	assert.Equal(t, commitA, r.getJobName(snapA))
+}
+
+func TestBuildUnpauseJobDedicatedNamespace(t *testing.T) {
+	snapshot := jobNamespaceTestSnapshot("snap-a", "tenant-a")
+	r := newTestSnapshotReconciler(snapshot)
+	r.SnapshotJobNamespace = "snapshot-jobs"
+
+	job, err := r.buildUnpauseJob(snapshot)
+	require.NoError(t, err)
+
+	assert.Equal(t, "snapshot-jobs", job.Namespace)
+	assert.Empty(t, job.OwnerReferences)
+	assert.Equal(t, "tenant-a", job.Labels[LabelSandboxSnapshotNamespace])
+}
