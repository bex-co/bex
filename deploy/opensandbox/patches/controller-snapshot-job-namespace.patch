+// jobNamespace returns the namespace commit/unpause Jobs run in: the dedicated
+// SnapshotJobNamespace when configured, otherwise the snapshot's own namespace.
+func (r *SandboxSnapshotReconciler) jobNamespace(snapshot *sandboxv1alpha1.SandboxSnapshot) string {
+	if r.SnapshotJobNamespace != "" {
+		return r.SnapshotJobNamespace
+	}
+	return snapshot.Namespace
