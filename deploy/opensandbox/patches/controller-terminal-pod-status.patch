+func TestBuildRuntimeView_ProjectsTerminalPodFailure(t *testing.T) {
+	bs := &sandboxv1alpha1.BatchSandbox{
+		ObjectMeta: metav1.ObjectMeta{Name: "agent", Namespace: "default", Generation: 7},
+		Status:     sandboxv1alpha1.BatchSandboxStatus{Phase: sandboxv1alpha1.BatchSandboxPhasePending},
+	}
+	pod := &corev1.Pod{
+		ObjectMeta: metav1.ObjectMeta{Name: "agent-0", Namespace: "default"},
+		Status: corev1.PodStatus{
+			Phase: corev1.PodFailed,
+			ContainerStatuses: []corev1.ContainerStatus{{
+				Name: "sandbox",
+				State: corev1.ContainerState{Terminated: &corev1.ContainerStateTerminated{
+					ExitCode: 137, Signal: 9, Reason: "Error",
+				}},
+			}},
+		},
+	}
+
+	view := buildRuntimeView(bs, []*corev1.Pod{pod})
+	assert.Equal(t, sandboxv1alpha1.BatchSandboxPhaseFailed, view.status.Phase)
+	assert.Equal(t, int64(7), view.status.ObservedGeneration)
+	assert.Equal(t, int32(1), view.status.TaskFailed)
+	assert.Contains(t, view.status.TaskLastErrorMessage, "primary reason=Error")
+	var podFailed *sandboxv1alpha1.BatchSandboxCondition
+	for i := range view.status.Conditions {
+		if view.status.Conditions[i].Type == sandboxv1alpha1.BatchSandboxConditionPodFailed {
+			podFailed = &view.status.Conditions[i]
+		}
+	}
+	require.NotNil(t, podFailed)
+	assert.Equal(t, sandboxv1alpha1.ConditionTrue, podFailed.Status)
+	assert.Equal(t, "Error", podFailed.Reason)
+	assert.Contains(t, podFailed.Message, "1/1 observed pods failed")
+	reason, message, failed := getPodFailureReasonAndMessage(pod)
+	assert.True(t, failed)
+	assert.Equal(t, "Error", reason)
+	assert.Contains(t, message, "exitCode=137 signal=9")
+}
+
+func TestBuildRuntimeView_CleanPodExitIsTerminalButPausedPhaseIsStable(t *testing.T) {
+	pod := &corev1.Pod{
+		ObjectMeta: metav1.ObjectMeta{Name: "agent-0", Namespace: "default"},
+		Status:     corev1.PodStatus{Phase: corev1.PodSucceeded},
+	}
+	pending := &sandboxv1alpha1.BatchSandbox{Status: sandboxv1alpha1.BatchSandboxStatus{Phase: sandboxv1alpha1.BatchSandboxPhasePending}}
+	assert.Equal(t, sandboxv1alpha1.BatchSandboxPhaseFailed, buildRuntimeView(pending, []*corev1.Pod{pod}).status.Phase)
+	paused := &sandboxv1alpha1.BatchSandbox{Status: sandboxv1alpha1.BatchSandboxStatus{Phase: sandboxv1alpha1.BatchSandboxPhasePaused}}
+	assert.Equal(t, sandboxv1alpha1.BatchSandboxPhasePaused, buildRuntimeView(paused, []*corev1.Pod{pod}).status.Phase)
 }
 
 func TestBuildRuntimeView_PreservesConditionTransitionTimeWhenUnchanged(t *testing.T) {
diff --git a/kubernetes/internal/controller/batchsandbox_status.go b/kubernetes/internal/controller/batchsandbox_status.go
