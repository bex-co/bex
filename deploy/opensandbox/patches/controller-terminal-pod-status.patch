# Carried patch: project terminal sandbox Pods into BatchSandbox status.
#
# Upstream: https://github.com/alibaba/OpenSandbox
# Base commit: e95681e791b33b3893033940cbeaa5ab192bf21b (main, 2026-08-02)
# Why: upstream failure aggregation recognizes only a small set of Waiting
# reasons. A sandbox container that exits non-zero leaves its Pod Failed while
# BatchSandbox remains Pending forever, so the server and bex control plane keep
# trying pods/exec against a nonexistent container. This patch treats failed,
# succeeded, and non-zero-terminated long-lived sandbox Pods as terminal while
# preserving pause/resume-owned phases. It records only bounded Kubernetes
# reason/exit metadata, never the terminated process message/output.
# Tracking: .pm/w5/m72/t005.
#
# git apply runs from the upstream repository root.
diff --git a/kubernetes/internal/controller/batchsandbox_pause_resume_test.go b/kubernetes/internal/controller/batchsandbox_pause_resume_test.go
index 6e5f728d..1931a7a0 100644
--- a/kubernetes/internal/controller/batchsandbox_pause_resume_test.go
+++ b/kubernetes/internal/controller/batchsandbox_pause_resume_test.go
@@ -1804,7 +1804,7 @@ func TestBuildRuntimeView_AggregatesPodFailuresInSteadyState(t *testing.T) {
 	require.NotNil(t, podFailed)
 	assert.Equal(t, sandboxv1alpha1.ConditionTrue, podFailed.Status)
 	assert.Equal(t, "ErrImagePull", podFailed.Reason)
-	assert.Equal(t, "3/4 observed pods failed; primary reason=ErrImagePull; sample pod=err-image-0", podFailed.Message)
+	assert.Equal(t, "3/4 observed pods failed; primary reason=ErrImagePull; sample pod=err-image-0; detail=Pod err-image-0: ErrImagePull", podFailed.Message)
 }
 
