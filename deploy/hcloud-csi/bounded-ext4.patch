+
+// This deliberately uses a disposable local loop device, never a provider volume.
+// Run only in an explicitly authorized privileged test container.
+func TestBoundedExt4Kernel(t *testing.T) {
+	if os.Getenv("BEX_CSI_KERNEL_TEST") != "1" {
+		t.Skip("privileged disposable-container test")
+	}
+	if _, err := os.Stat("/.dockerenv"); err != nil {
+		t.Fatal("kernel test requires its disposable Docker container")
+	}
+	ctx := context.Background()
+	dir := t.TempDir()
+	image := filepath.Join(dir, "disk.img")
+	mountpoint := filepath.Join(dir, "mount")
+	f, err := os.Create(image)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = f.Truncate(10 << 30); err != nil {
+		t.Fatal(err)
+	}
+	f.Close()
+	run := func(name string, args ...string) string {
+		t.Helper()
+		out, err := osexec.Command(name, args...).CombinedOutput()
+		if err != nil {
+			t.Fatalf("%s %v: %v: %s", name, args, err, out)
+		}
+		return strings.TrimSpace(string(out))
+	}
+	loop := run("losetup", "--find", "--show", image)
+	mapping := "bex-csi-test-" + rand.Text()
+	device := "/dev/mapper/" + mapping
+	mounted := false
+	opened := false
+	t.Cleanup(func() {
+		if mounted {
+			if out, err := osexec.Command("umount", mountpoint).CombinedOutput(); err != nil {
+				t.Errorf("cleanup unmount: %v %s", err, out)
+			}
+		}
+		if opened {
+			if out, err := osexec.Command("cryptsetup", "close", mapping).CombinedOutput(); err != nil {
+				t.Errorf("cleanup mapping: %v %s", err, out)
+			}
+		}
+		if out, err := osexec.Command("losetup", "-d", loop).CombinedOutput(); err != nil {
+			t.Errorf("cleanup loop: %v %s", err, out)
+		}
+	})
+	crypt := func(args ...string) {
+		t.Helper()
+		cmd := osexec.Command("cryptsetup", args...)
+		cmd.Stdin = strings.NewReader("disposable-kernel-test-only")
+		if out, err := cmd.CombinedOutput(); err != nil {
+			t.Fatalf("cryptsetup: %v %s", err, out)
+		}
+	}
+	crypt("luksFormat", "--type", "luks1", "--batch-mode", "--key-file=-", loop)
+	crypt("open", "--key-file=-", loop, mapping)
+	opened = true
+	if err := boundedExt4(ctx, exec.New(), device, 1<<30, true, false); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.Mkdir(mountpoint, 0700); err != nil {
+		t.Fatal(err)
+	}
+	run("mount", device, mountpoint)
+	mounted = true
+	sentinel := []byte("bounded-filesystem-data-preservation\n")
+	sentinelPath := filepath.Join(mountpoint, "sentinel")
+	if err = os.WriteFile(sentinelPath, sentinel, 0600); err != nil {
+		t.Fatal(err)
+	}
+	fullPath := filepath.Join(mountpoint, "full")
+	full, err := os.Create(fullPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	chunk := make([]byte, 1<<20)
+	written := 0
+	fullErr := error(nil)
+	for written < 1100<<20 {
+		n, e := full.Write(chunk)
+		written += n
+		if e != nil {
+			fullErr = e
+			break
+		}
+	}
+	if err = full.Sync(); err != nil && fullErr == nil {
+		fullErr = err
+	}
+	full.Close()
+	if !errors.Is(fullErr, syscall.ENOSPC) || written > 1<<30 {
+		t.Fatalf("cap missing: written=%d error=%v", written, fullErr)
+	}
+	t.Logf("1GiB bounded filesystem returned ENOSPC at %d bytes", written)
+	if err = boundedExt4(ctx, exec.New(), device, 5<<30, false, false); err != nil {
+		t.Fatal(err)
+	}
+	full, err = os.OpenFile(fullPath, os.O_APPEND|os.O_WRONLY, 0600)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = full.Write(bytes.Repeat([]byte("g"), 64<<20)); err != nil {
+		t.Fatal(err)
+	}
+	full.Close()
+	if err = boundedExt4(ctx, exec.New(), device, 1<<30, false, false); err == nil {
+		t.Fatal("accepted shrink")
+	}
+	check := func() {
+		t.Helper()
+		got, e := os.ReadFile(sentinelPath)
+		if e != nil || sha256.Sum256(got) != sha256.Sum256(sentinel) {
+			t.Fatalf("data changed: %v", e)
+		}
+	}
+	check()
+	run("umount", mountpoint)
+	mounted = false
+	run("cryptsetup", "close", mapping)
+	opened = false
+	crypt("open", "--key-file=-", loop, mapping)
+	opened = true
+	run("mount", device, mountpoint)
+	mounted = true
+	check()
+	// Ordinary file-level backup/restore leaves the filesystem boundary intact.
+	archive := filepath.Join(dir, "snapshot.tgz")
+	run("tar", "-czf", archive, "-C", mountpoint, ".")
+	if err = os.Remove(fullPath); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.Remove(sentinelPath); err != nil {
+		t.Fatal(err)
+	}
+	run("tar", "-xzf", archive, "-C", mountpoint)
+	check()
+	if err = boundedExt4(ctx, exec.New(), device, 5<<30, false, true); err != nil {
+		t.Fatal(err)
+	}
+	t.Log("5GiB online grow, retained data, LUKS remount and file-level snapshot restore passed")
+	// The pre-patch resize command is a mutation control: it removes the bound.
+	run("resize2fs", device)
+	if err = boundedExt4(ctx, exec.New(), device, 5<<30, false, false); err == nil {
+		t.Fatal("unbounded resize control was not detected")
+	}
+	t.Log("whole-device resize control detected; no automatic shrink/reformat attempted")
+}
