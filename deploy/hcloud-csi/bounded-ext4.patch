@@ -0,0 +1,25 @@
+package volumes
+
+import (
+	"encoding/binary"
+	"testing"
+)
+
+func TestExt4BytesRejectsCorruptAndOverflowingMetadata(t *testing.T) {
+	s := make([]byte, 1024)
+	if _, err := ext4Bytes(s); err == nil {
+		t.Fatal("accepted bad magic")
+	}
+	binary.LittleEndian.PutUint16(s[56:], 0xef53)
+	binary.LittleEndian.PutUint32(s[24:], 2)
+	binary.LittleEndian.PutUint32(s[4:], 262144)
+	got, err := ext4Bytes(s)
+	if err != nil || got != 1<<30 {
+		t.Fatalf("bytes=%d error=%v", got, err)
+	}
+	binary.LittleEndian.PutUint32(s[96:], 0x80)
+	binary.LittleEndian.PutUint32(s[336:], 0xffffffff)
+	if _, err := ext4Bytes(s); err == nil {
+		t.Fatal("accepted overflowing block count")
+	}
+}
