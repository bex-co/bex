+// entryBucket is a token bucket refilled by each entry's own timestamp, not
+// by the clock when the stage sees the entry: rate.Limiter refills by the
+// wall clock at the moment a file tailer hands the pipeline a batch, so which
+// lines of a flood it keeps depends on read timing. Tokens are whole, one per
+// 1/rate step of the timestamp on a grid fixed to the Unix epoch, capped at
+// burst. A bucket starts full at its first entry's step, and an entry stamped
+// at or before the last step it counted (stderr behind stdout, equal stamps)
+// refills nothing. Two such buckets fed the same entries keep the same ones
+// once a flood has drained both or a quiet spell has filled both, however
+// late each reads them: their difference is a whole number of tokens that
+// never grows and shrinks each time only one of them admits.
+type entryBucket struct {
+	step          int64 // nanoseconds per token
+	burst, tokens int64
+	last          int64 // the step of the latest entry counted
+	started       bool
+}
+
+func newEntryBucket(rate float64, burst int) *entryBucket {
+	return &entryBucket{step: max(int64(float64(time.Second)/rate), 1), burst: int64(burst)}
+}
+
+// allow spends a token on an entry stamped at, after the refill its step
+// brings, and reports whether there was one.
+func (b *entryBucket) allow(at time.Time) bool {
+	step := at.UnixNano() / b.step
+	switch {
+	case !b.started:
+		b.tokens, b.last, b.started = b.burst, step, true
+	case step > b.last:
+		b.tokens, b.last = min(b.burst, b.tokens+step-b.last), step
+	}
+	if b.tokens < 1 {
+		return false
+	}
+	b.tokens--
+	return true
+}
+
 // Name implements Stage
 func (m *limitStage) Name() string {
 	return StageTypeLimit
