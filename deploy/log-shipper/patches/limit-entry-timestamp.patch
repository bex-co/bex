+
+// The table bex's live tail is checked against too
+// (lego/backend/internal/logs/testdata/linecap-shared.json in bex-co/bex,
+// copied in by deploy/log-shipper/Dockerfile): stamped lines in file order and
+// whether each pod's bucket keeps them.
+type limitEntryTimeTable struct {
+	Rate  float64 `json:"rate"`
+	Burst int     `json:"burst"`
+	Lines []struct {
+		Pod   string    `json:"pod"`
+		TS    time.Time `json:"ts"`
+		Admit bool      `json:"admit"`
+	} `json:"lines"`
+}
+
+func TestLimitRefillByEntryTimestamp(t *testing.T) {
+	raw, err := os.ReadFile("testdata/linecap-shared.json")
+	require.NoError(t, err)
+	var table limitEntryTimeTable
+	require.NoError(t, json.Unmarshal(raw, &table))
+	require.NotEmpty(t, table.Lines)
+
+	// limit runs every table line of the pods kept through one stage.limit,
+	// handed over at once as a file tailer hands over a backlog, and returns
+	// the lines it keeps.
+	limit := func(args string, keep func(pod string) bool) []string {
+		cfg := fmt.Sprintf("stage.limit {\n\trate = %v\n\tburst = %d\n\tdrop = true\n%s\n}", table.Rate, table.Burst, args)
+		pl, err := NewPipeline(util_log.Logger, loadConfig(cfg), &plName, prometheus.NewRegistry(), featuregate.StabilityGenerallyAvailable)
+		require.NoError(t, err)
+		var entries []Entry
+		for i, l := range table.Lines {
+			if keep(l.Pod) {
+				entries = append(entries, newEntry(nil, model.LabelSet{"pod": model.LabelValue(l.Pod)}, fmt.Sprintf("%s %d", l.Pod, i), l.TS))
+			}
+		}
+		var kept []string
+		for _, e := range processEntries(pl, entries...) {
+			kept = append(kept, e.Line)
+		}
+		return kept
+	}
+	want := func(keep func(pod string) bool) []string {
+		var out []string
+		for i, l := range table.Lines {
+			if keep(l.Pod) && l.Admit {
+				out = append(out, fmt.Sprintf("%s %d", l.Pod, i))
+			}
+		}
+		return out
+	}
+	every := func(string) bool { return true }
+	first := func(pod string) bool { return pod == table.Lines[0].Pod }
+
+	byLabel := "\tby_label_name = \"pod\"\n\trefill_by_entry_timestamp = true"
+	assert.Equal(t, want(every), limit(byLabel, every), "each pod's bucket must keep the table's lines")
+	assert.Equal(t, want(first), limit("\trefill_by_entry_timestamp = true", first), "one bucket must keep the table's lines of one pod")
+	// The wall clock keeps a different set of the same batch: the table
+	// tells the two rules apart.
+	assert.NotEqual(t, want(every), limit("\tby_label_name = \"pod\"", every))
+}
+
+func TestLimitRefillByEntryTimestampMustDrop(t *testing.T) {
+	err := validateLimitConfig(LimitConfig{Rate: 1, Burst: 1, RefillByEntryTimestamp: true})
+	assert.ErrorIs(t, err, ErrLimitStageByEntryTimeMustDrop)
+	assert.NoError(t, validateLimitConfig(LimitConfig{Rate: 1, Burst: 1, Drop: true, RefillByEntryTimestamp: true}))
+}
