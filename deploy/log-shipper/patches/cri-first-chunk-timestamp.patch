+func TestCRI_partialKeepsFirstChunkTime(t *testing.T) {
+	p, err := NewCRI(util_log.Logger, DefaultCRIConfig, prometheus.DefaultRegisterer, featuregate.StabilityGenerallyAvailable)
+	require.NoError(t, err)
+
+	var got []Entry
+	for _, line := range []string{
+		"2026-10-11T10:35:00.100000001Z stdout P first-",
+		"2026-10-11T10:35:00.150000000Z stdout P middle-",
+		"2026-10-11T10:35:01.220000002Z stdout F last",
+		"2026-10-11T10:35:01.300000003Z stdout F control",
+	} {
+		got = append(got, processEntries(p, newEntry(nil, model.LabelSet{"foo": "bar"}, line, time.Now()))...)
+	}
+
+	require.Len(t, got, 2)
+	assert.Equal(t, "first-middle-last", got[0].Line)
+	assert.Equal(t, time.Date(2026, 10, 11, 10, 35, 0, 100000001, time.UTC), got[0].Timestamp.UTC())
+	assert.Equal(t, "2026-10-11T10:35:00.100000001Z", got[0].Extracted["time"])
+	assert.Equal(t, "control", got[1].Line)
+	assert.Equal(t, time.Date(2026, 10, 11, 10, 35, 1, 300000003, time.UTC), got[1].Timestamp.UTC())
+}
