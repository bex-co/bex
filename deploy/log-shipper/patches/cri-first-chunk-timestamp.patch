+// keepFirstChunkTime stamps a reassembled record with its first chunk's time,
+// as the kubelet's own log reader does, instead of the last chunk's.
+func keepFirstChunkTime(e *Entry, first Entry) {
+	e.Timestamp = first.Timestamp
+	if t, ok := first.Extracted["time"]; ok {
+		e.Extracted["time"] = t
+	}
+}
+
 func (c *cri) ensureTruncateIfRequired(e *Entry) {
