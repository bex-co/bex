{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.79",
        "--browser",
        "chromium",
        "--output-dir",
        ".playwright-mcp"
      ],
      "env": {}
    },
    "expo": {
      "type": "streamable-http",
      "url": "https://mcp.expo.dev/mcp"
    }
  }
}