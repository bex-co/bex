# bex CI secrets — TEMPLATE (safe to commit; no real values here).
#
# These are GitHub Actions secrets, NOT a local runtime env. The workflows
# (infra.yml / app-cluster.yml / deploy.yml) read them via ${{ secrets.* }}.
#
# Usage:
#   cp .env.template .env        # .env is gitignored — NEVER commit the filled one
#   <fill in the values below>
#   bash scripts/gh-secrets.sh   # pushes them into GitHub Actions secrets via `gh`
#
# Or set them by hand: GitHub → repo Settings → Secrets and variables → Actions.

# --- Hetzner Cloud ---
# Console → project → Security → API Tokens → generate (Read & Write).
HCLOUD_TOKEN=

# --- SSH key for the infra node (give the FILE PATHS, not the key material) ---
# Create once:  ssh-keygen -t ed25519 -f ~/.ssh/bex -C bex
BEX_SSH_PUBLIC_KEY_FILE=$HOME/.ssh/bex.pub
BEX_SSH_PRIVATE_KEY_FILE=$HOME/.ssh/bex

# --- Terraform remote state: Hetzner Object Storage (S3-compatible) ---
# Create the bucket once (the one out-of-band "bottom turtle"), then its S3 creds.
TF_STATE_BUCKET=bex-tfstate
TF_STATE_ENDPOINT=https://fsn1.your-objectstorage.com
TF_STATE_REGION=fsn1
TF_STATE_ACCESS_KEY=
TF_STATE_SECRET_KEY=

# --- Platform auth: Ory Kratos + Hydra (docs/auth.md) ---
# LOCAL runtime keys (not GitHub secrets): scripts/auth-secrets.sh reads them
# and creates the auth/kratos + auth/hydra k8s Secrets out-of-band of GitOps.
# Generate each with:  openssl rand -hex 16   (32 hex chars — exactly the
# length KRATOS_SECRETS_CIPHER requires).
KRATOS_SECRETS_DEFAULT=
KRATOS_SECRETS_COOKIE=
KRATOS_SECRETS_CIPHER=
HYDRA_SECRETS_SYSTEM=
HYDRA_SECRETS_COOKIE=
HYDRA_OIDC_PAIRWISE_SALT=
# Secret of the seeded `bex-bootstrap` OAuth2 client (the platform's first API
# key; scripts/auth-bootstrap-client.sh). Generate: openssl rand -hex 16
BEX_BOOTSTRAP_CLIENT_SECRET=
# OpenFGA API preshared key (authorization service, cluster-internal).
OPENFGA_PRESHARED_KEY=

# --- bex-api runtime knobs (docs/usage-metering.md) ---
# Usage hot window: calendar months (current included) kept at hourly detail
# before compaction folds older months into monthly aggregates. Blank => 3.
BEX_USAGE_RETENTION_MONTHS=

# --- bex-api runtime knobs (audit log, w4/m10) ---
# Audit-event retention: days an audit_events row survives before the daily
# sweep purges it. Blank => 90.
BEX_AUDIT_RETENTION_DAYS=

# --- Platform secrets: OpenBao (docs/secrets.md) ---
# Leave these BLANK in the template. The values are generated by the one-time
# manual prod init (scripts/bao-init.sh against the prod kubeconfig, which
# writes them into your local .env). Copy those four values here so
# scripts/gh-secrets.sh pushes them into GitHub Actions secrets — deploy.yml
# then reads them to unseal prod OpenBao idempotently on every deploy. Never
# printed. Mirror of the same keys in .env.example.
BAO_UNSEAL_KEY_1=
BAO_UNSEAL_KEY_2=
BAO_UNSEAL_KEY_3=
BAO_ROOT_TOKEN=
