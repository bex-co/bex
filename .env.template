# bex CI secrets — TEMPLATE (safe to commit; no real values here).
#
# These are GitHub Actions secrets, NOT a local runtime env. The workflows
# (infra.yml / app-cluster.yml / deploy.yml) read them via ${{ secrets.* }}.
#
# Usage:
#   cp .env.template .env        # .env is gitignored — NEVER commit the filled one
#   <fill in the values below>
#   bash scripts/gh-secrets.sh   # pushes them into GitHub Actions secrets via `gh`
#
# Or set them by hand: GitHub → repo Settings → Secrets and variables → Actions.

# --- Hetzner Cloud ---
# Console → project → Security → API Tokens → generate (Read & Write).
HCLOUD_TOKEN=

# --- SSH key for the infra node (give the FILE PATHS, not the key material) ---
# Create once:  ssh-keygen -t ed25519 -f ~/.ssh/bex -C bex
BEX_SSH_PUBLIC_KEY_FILE=$HOME/.ssh/bex.pub
BEX_SSH_PRIVATE_KEY_FILE=$HOME/.ssh/bex

# --- Terraform remote state: Hetzner Object Storage (S3-compatible) ---
# Create the bucket once (the one out-of-band "bottom turtle"), then its S3 creds.
TF_STATE_BUCKET=bex-tfstate
TF_STATE_ENDPOINT=https://fsn1.your-objectstorage.com
TF_STATE_REGION=fsn1
TF_STATE_ACCESS_KEY=
TF_STATE_SECRET_KEY=

# --- Platform auth: Ory Kratos + Hydra (docs/ADR012-auth.md) ---
# LOCAL runtime keys (not GitHub secrets): scripts/auth-secrets.sh reads them
# and creates the auth/kratos + auth/hydra k8s Secrets out-of-band of GitOps.
# Generate each with:  openssl rand -hex 16   (32 hex chars — exactly the
# length KRATOS_SECRETS_CIPHER requires).
KRATOS_SECRETS_DEFAULT=
KRATOS_SECRETS_COOKIE=
KRATOS_SECRETS_CIPHER=
HYDRA_SECRETS_SYSTEM=
HYDRA_SECRETS_COOKIE=
HYDRA_OIDC_PAIRWISE_SALT=
# Secret of the seeded `bex-bootstrap` OAuth2 client (the platform's first API
# key; scripts/auth-bootstrap-client.sh). Generate: openssl rand -hex 16
BEX_BOOTSTRAP_CLIENT_SECRET=
# OpenFGA API preshared key (authorization service, cluster-internal).
OPENFGA_PRESHARED_KEY=
# Sign in with GitHub via Kratos oidc (docs/ADR012-auth.md § Social login). Optional:
# BOTH set => deploy.yml's auth-secrets step enables the GitHub provider button;
# unset => social login off. Create your own GitHub OAuth app, callback URL
# https://auth.<base-domain>/self-service/methods/oidc/callback/github.
BEX_GITHUB_OIDC_CLIENT_ID=
BEX_GITHUB_OIDC_CLIENT_SECRET=

# --- Platform email: one SMTP relay for Kratos's courier + bex-api's mailer (docs/ADR012-auth.md §11) ---
# deploy.yml's "apply auth secrets" step reads these and writes them into the
# out-of-band Secrets (kratos → smtpConnectionURI; bex-system/bex-smtp → username,
# password). Prod = SendGrid (a plain SMTP relay, no SDK — provider-agnostic).
# Kratos courier connection URI (REQUIRED — the courier is enabled in the values).
#   SendGrid:  smtp://apikey:<sendgrid-api-key>@smtp.sendgrid.net:587  (username is literally "apikey")
#     Port 587 + STARTTLS, NOT 465: Hetzner blocks outbound 25/465 (implicit TLS);
#     587/2525 are open. :465 silently never delivers (docs/ADR012-auth.md §11).
KRATOS_COURIER_SMTP_URI=
# bex-api workspace-invite mailer (w4/m12). Same relay as the courier. ADDR/FROM are
# non-secret (baked into the bex-api deployment); USERNAME/PASSWORD ride bex-smtp.
# All unset => invites recorded but not emailed. Mirror of the same keys in .env.example.
BEX_SMTP_ADDR=
BEX_SMTP_FROM=
BEX_SMTP_USERNAME=
BEX_SMTP_PASSWORD=

# --- bex-api runtime knobs (docs/ADR023-usage-metering.md) ---
# Usage hot window: calendar months (current included) kept at hourly detail
# before compaction folds older months into monthly aggregates. Blank => 3.
BEX_USAGE_RETENTION_MONTHS=

# --- bex-api runtime knobs (audit log, w4/m10) ---
# Audit-event retention: days an audit_events row survives before the daily
# sweep purges it. Blank => 90.
BEX_AUDIT_RETENTION_DAYS=

# --- GitHub App integration (docs/ADR026-github-integration.md) ---
# Self-hosted GitHub App for private-repo deploys + zero-config push-to-deploy.
# Create your own app (GitHub app-manifest flow), then fill these. Any of the
# three unset => every git-connect verb 503s. Private key is PEM (out-of-band).
BEX_GITHUB_APP_ID=
BEX_GITHUB_APP_PRIVATE_KEY=
BEX_GITHUB_APP_SLUG=
# The app's webhook HMAC key (w2/m9): second accepted key on /v1/webhooks/git so
# GitHub-App-signed pushes redeploy without a per-repo webhook. Unset => only
# BEX_WEBHOOK_SECRET is accepted.
BEX_GITHUB_WEBHOOK_SECRET=

# --- Platform secrets: OpenBao (docs/ADR013-secrets.md) ---
# Leave these BLANK in the template. The values are generated by the one-time
# manual prod init (scripts/bao-init.sh against the prod kubeconfig, which
# writes them into your local .env). Copy those four values here so
# scripts/gh-secrets.sh pushes them into GitHub Actions secrets — deploy.yml
# then reads them to unseal prod OpenBao idempotently on every deploy. Never
# printed. Mirror of the same keys in .env.example.
BAO_UNSEAL_KEY_1=
BAO_UNSEAL_KEY_2=
BAO_UNSEAL_KEY_3=
BAO_ROOT_TOKEN=

# --- bex-api rate limits + request caps (docs/ADR006-bex-api.md#rate-limits) ---
# Defaults apply when unset; 0 disables the respective cap entirely.
BEX_RATE_LIMIT=
BEX_RATE_BURST=
BEX_MAX_BODY_BYTES=
BEX_MAX_QUERY_HOURS=
BEX_MAX_SSE_CONNS=
