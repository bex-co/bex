+func TestKeyValuePersistenceStaleStatusCannotAcknowledgeNewerDesiredMode(t *testing.T) {
+	kv, sts, pod := persistenceControllerObjects("journal-snapshot", "journal-snapshot")
+	kv.Status.AppliedPersistenceMode = "snapshot"
+	r := persistenceController(t, kv, sts, pod)
+	if err := r.Get(t.Context(), client.ObjectKeyFromObject(kv), kv); err != nil {
+		t.Fatal(err)
+	}
+	stale := kv.DeepCopy()
+	kv.Spec.PersistenceMode = "off"
+	kv.Generation++
+	if err := r.Update(t.Context(), kv); err != nil {
+		t.Fatal(err)
+	}
+	_, err := r.updateKeyValueReadiness(t.Context(), stale, sts, 1, "credentials-current")
+	if !apierrors.IsConflict(err) {
+		t.Fatalf("old Journal acknowledgement must conflict with a newer Off request: %v", err)
+	}
+	if err := r.Get(t.Context(), client.ObjectKeyFromObject(kv), kv); err != nil {
+		t.Fatal(err)
+	}
+	if kv.Spec.PersistenceMode != "off" || kv.Status.AppliedPersistenceMode != "snapshot" {
+		t.Fatalf("stale completion replaced newer intent or applied state: spec=%q applied=%q", kv.Spec.PersistenceMode, kv.Status.AppliedPersistenceMode)
+	}
+}
