+func TestKeyValuePersistenceRetainedStorageCannotBecomeFreshBootstrap(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		applied    string
+		hasPVC     bool
+		readError  bool
+		wantSource string
+	}{
+		{"retained journal", "journal-snapshot", true, false, "journal-snapshot"},
+		{"retained snapshot", "snapshot", true, false, "snapshot"},
+		{"retained Off", "off", true, false, "off"},
+		{"retained unknown mode", "", true, false, ""},
+		{"retained invalid mode", "unknown", true, false, ""},
+		{"previous storage is missing", "snapshot", false, false, ""},
+		{"storage lookup failed", "", false, true, ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			kv, _, _ := persistenceControllerObjects("snapshot", "journal-snapshot")
+			kv.Status.AppliedPersistenceMode = tc.applied
+			objects := []client.Object{kv}
+			if tc.hasPVC {
+				objects = append(objects, &corev1.PersistentVolumeClaim{ObjectMeta: metav1.ObjectMeta{
+					Name: keyValuePVCName(kv.Name), Namespace: kv.Namespace, UID: "retained-persistence",
+				}})
+			}
+			r := persistenceController(t, objects...)
+			readErr := errors.New("PVC cache unavailable")
+			if tc.readError {
+				r.Client = interceptor.NewClient(r.Client.(client.WithWatch), interceptor.Funcs{
+					Get: func(ctx context.Context, c client.WithWatch, key client.ObjectKey, obj client.Object, opts ...client.GetOption) error {
+						if _, ok := obj.(*corev1.PersistentVolumeClaim); ok {
+							return readErr
+						}
+						return c.Get(ctx, key, obj, opts...)
+					},
+				})
+			}
+			bootstrap, err := r.keyValuePersistenceBootstrap(t.Context(), kv, &appsv1.StatefulSet{})
+			if bootstrap != tc.wantSource || (err != nil) != (tc.wantSource == "") {
+				t.Fatalf("replacement source=%q err=%v, want retained source=%q or a closed gate", bootstrap, err, tc.wantSource)
+			}
+			if tc.readError && !errors.Is(err, readErr) {
+				t.Fatalf("storage lookup failure was hidden as fresh bootstrap: %v", err)
+			}
+		})
+	}
+}
