+func TestKeyValuePersistenceFreshBootstrapSurvivesDesiredChange(t *testing.T) {
+	kv, sts, _ := persistenceControllerObjects("journal-snapshot", "snapshot")
+	kv.Status = appv1alpha1.KeyValueStatus{}
+	// The user changed modes before the first pod initialized its volume. The
+	// replacement must retain explicit fresh-volume authority, rather than
+	// treating missing Journal files as corruption of a legacy data source.
+	sts.Spec.Template.Annotations[keyValuePersistenceBootstrapAnnotation] = "new:journal-snapshot"
+	r := persistenceController(t, kv, sts)
+	bootstrap, err := r.keyValuePersistenceBootstrap(t.Context(), kv, sts)
+	if err != nil || bootstrap != "new:journal-snapshot" {
+		t.Fatalf("early desired change lost fresh-volume authority: source=%q err=%v", bootstrap, err)
+	}
+	intent := persistenceControllerIntent(kv)
+	intent.persistenceBootstrapMode = bootstrap
+	applyKeyValueStatefulSet(sts, kv, intent)
+	server := sts.Spec.Template.Spec.Containers[0]
+	if len(server.Command) == 0 || len(server.Args) < 2 || server.Args[0] != "new:journal-snapshot" || server.Args[1] != "snapshot" {
+		t.Fatal("replacement did not preserve fresh initialization across the mode change")
+	}
+}
