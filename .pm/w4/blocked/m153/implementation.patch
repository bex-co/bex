+func persistenceController(t *testing.T, objects ...client.Object) *KeyValueReconciler {
+	t.Helper()
+	scheme := datastoreSecretScheme(t)
+	cl := fake.NewClientBuilder().WithScheme(scheme).WithObjects(objects...).
+		WithStatusSubresource(&appv1alpha1.KeyValue{}).Build()
+	return &KeyValueReconciler{Client: cl, Scheme: scheme}
+}
+
+func persistenceControllerIntent(kv *appv1alpha1.KeyValue) keyValueIntent {
+	plan, storageGB := resolveKVPlan(kv.Spec)
+	intent := keyValueIntentFor(kv, plan, storageGB, "")
+	intent.authSecretName = kv.Name + "-auth"
+	intent.credentialRevision = "credentials-current"
+	return intent
+}
+
+func persistenceControllerObjects(source, desired string) (*appv1alpha1.KeyValue, *appsv1.StatefulSet, *corev1.Pod) {
+	kv := &appv1alpha1.KeyValue{
+		ObjectMeta: metav1.ObjectMeta{Name: "red-persistence", Namespace: "default", UID: "keyvalue-owned", Generation: 2},
+		Spec:       appv1alpha1.KeyValueSpec{PersistenceMode: source},
+		Status: appv1alpha1.KeyValueStatus{
+			Phase: appv1alpha1.KVPhaseReady, AppliedPersistenceMode: effectiveKeyValuePersistence(source),
+			CredentialRevision: "credentials-current",
+			Conditions:         []metav1.Condition{{Type: appv1alpha1.ConditionReady, Status: metav1.ConditionTrue, Reason: "Provisioned", ObservedGeneration: 1}},
+		},
+	}
+	sts := &appsv1.StatefulSet{ObjectMeta: metav1.ObjectMeta{Name: kv.Name, Namespace: kv.Namespace, UID: "statefulset-owned", Generation: 1,
+		OwnerReferences: []metav1.OwnerReference{*metav1.NewControllerRef(kv, appv1alpha1.SchemeGroupVersion.WithKind("KeyValue"))},
+	}}
+	applyKeyValueStatefulSet(sts, kv, persistenceControllerIntent(kv))
+	sts.CreationTimestamp = metav1.Now()
+	sts.Status = appsv1.StatefulSetStatus{
+		ObservedGeneration: 1, CurrentRevision: "source-revision", UpdateRevision: "source-revision",
+		CurrentReplicas: 1, UpdatedReplicas: 1, ReadyReplicas: 1, AvailableReplicas: 1,
+	}
+	pod := &corev1.Pod{
+		ObjectMeta: metav1.ObjectMeta{Name: kv.Name + "-0", Namespace: kv.Namespace, UID: "pod-owned",
+			Labels:          map[string]string{labelKeyValue: kv.Name, appsv1.StatefulSetRevisionLabel: "source-revision"},
+			OwnerReferences: []metav1.OwnerReference{*metav1.NewControllerRef(sts, appsv1.SchemeGroupVersion.WithKind("StatefulSet"))},
+		},
+		Spec:   *sts.Spec.Template.Spec.DeepCopy(),
+		Status: corev1.PodStatus{Conditions: []corev1.PodCondition{{Type: corev1.PodReady, Status: corev1.ConditionTrue}}},
+	}
+	kv.Spec.PersistenceMode = desired
+	return kv, sts, pod
+}
