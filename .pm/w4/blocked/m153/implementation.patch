+func TestKeyValuePersistenceBootstrapRejectsUntrustedOrUnknownSources(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		mutate func(*appsv1.StatefulSet, *corev1.Pod)
+		noPod  bool
+	}{
+		{"foreign StatefulSet", func(sts *appsv1.StatefulSet, _ *corev1.Pod) { sts.OwnerReferences[0].UID = "another-keyvalue" }, false},
+		{"foreign annotated StatefulSet", func(sts *appsv1.StatefulSet, _ *corev1.Pod) {
+			sts.OwnerReferences[0].UID = "another-keyvalue"
+			sts.Spec.Template.Annotations[keyValuePersistenceBootstrapAnnotation] = "snapshot"
+		}, false},
+		{"foreign pod", func(_ *appsv1.StatefulSet, pod *corev1.Pod) { pod.OwnerReferences[0].UID = "another-statefulset" }, false},
+		{"invalid frozen mode", func(sts *appsv1.StatefulSet, _ *corev1.Pod) {
+			sts.Spec.Template.Annotations[keyValuePersistenceBootstrapAnnotation] = "unknown"
+		}, false},
+		{"unknown serving command", func(_ *appsv1.StatefulSet, pod *corev1.Pod) {
+			pod.Spec.Containers[0].Command = []string{"unknown-server"}
+		}, false},
+		{"missing source during pending rollout", func(sts *appsv1.StatefulSet, _ *corev1.Pod) {
+			sts.Status.UpdateRevision = "pending-journal"
+		}, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			kv, sts, pod := persistenceControllerObjects("snapshot", "journal-snapshot")
+			tc.mutate(sts, pod)
+			objects := []client.Object{kv, sts}
+			if !tc.noPod {
+				objects = append(objects, pod)
+			}
+			r := persistenceController(t, objects...)
+			if bootstrap, err := r.keyValuePersistenceBootstrap(t.Context(), kv, sts); err == nil || bootstrap != "" {
+				t.Fatalf("untrusted source accepted: source=%q err=%v", bootstrap, err)
+			}
+		})
+	}
+}
