+
+package controller
+
+import (
+	"context"
+	"fmt"
+	"slices"
+	"strings"
+
+	appsv1 "k8s.io/api/apps/v1"
+	corev1 "k8s.io/api/core/v1"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+
+	appv1alpha1 "github.com/bex-co/bex/lego/types/v1alpha1"
+)
+
+const (
+	keyValuePersistenceBootstrapAnnotation = "app.bex.co/persistence-bootstrap-mode"
+	keyValuePersistenceNewPrefix           = "new:"
+	keyValuePersistenceSnapshot            = "snapshot"
+	valkeyPersistenceModePath              = "/data/.bex-persistence-mode"
+)
+
+func effectiveKeyValuePersistence(mode string) string {
+	if mode == "" {
+		return "journal-snapshot"
+	}
+	return mode
+}
+
+func validKeyValuePersistence(mode string) bool {
+	return slices.Contains([]string{"journal-snapshot", keyValuePersistenceSnapshot, "off"}, mode)
+}
+
+// Freeze the first conversion's source independently of later desired modes.
+// Once adopted, the PVC marker is the authority across pod/controller restarts.
+// Unchanged legacy stores keep their existing command and do not roll merely
+// because the operator was upgraded.
+func (r *KeyValueReconciler) keyValuePersistenceBootstrap(ctx context.Context, kv *appv1alpha1.KeyValue, sts *appsv1.StatefulSet) (string, error) {
+	desired := effectiveKeyValuePersistence(kv.Spec.PersistenceMode)
+	if !validKeyValuePersistence(desired) {
+		return "", fmt.Errorf("invalid desired persistence mode")
+	}
+	if sts.UID != "" && !metav1.IsControlledBy(sts, kv) {
+		return "", fmt.Errorf("persistence workload is not owned by this Key Value")
+	}
+	if source := sts.Spec.Template.Annotations[keyValuePersistenceBootstrapAnnotation]; source != "" {
+		if !validKeyValuePersistence(strings.TrimPrefix(source, keyValuePersistenceNewPrefix)) {
+			return "", fmt.Errorf("invalid persistence bootstrap mode")
+		}
+		return source, nil
+	}
+	if sts.UID == "" {
+		var pvc corev1.PersistentVolumeClaim
+		err := r.Get(ctx, client.ObjectKey{Namespace: kv.Namespace, Name: keyValuePVCName(kv.Name)}, &pvc)
+		if err == nil {
+			if !validKeyValuePersistence(kv.Status.AppliedPersistenceMode) {
+				return "", fmt.Errorf("retained persistence storage has no known applied mode")
+			}
+			// A committed PVC marker still supersedes this last observed mode.
+			return kv.Status.AppliedPersistenceMode, nil
+		}
+		if !apierrors.IsNotFound(err) {
+			return "", err
+		}
+		if kv.Status.AppliedPersistenceMode != "" {
+			return "", fmt.Errorf("previous persistence storage is missing")
+		}
+		return keyValuePersistenceNewPrefix + desired, nil
+	}
+	source, err := keyValueLegacyPersistence(sts.Spec.Template.Spec)
+	if err != nil {
+		return "", err
+	}
+	var pod corev1.Pod
+	err = r.Get(ctx, client.ObjectKey{Namespace: kv.Namespace, Name: kv.Name + "-0"}, &pod)
+	if err == nil {
+		if !metav1.IsControlledBy(&pod, sts) {
+			return "", fmt.Errorf("persistence pod is not owned by this StatefulSet")
+		}
+		current, err := keyValueLegacyPersistence(pod.Spec)
+		if err != nil {
+			return "", err
+		}
+		// Stop a legacy rollout from selecting a stale journal: the serving pod
+		// is the authority even if a previous operator already changed the STS.
+		source = current
+	} else if !apierrors.IsNotFound(err) {
+		return "", err
+	} else if sts.Status.CurrentRevision != "" && sts.Status.CurrentRevision != sts.Status.UpdateRevision {
+		return "", fmt.Errorf("waiting for the persistence source pod before conversion")
+	}
+	if source == desired {
+		return "", nil
+	}
+	return source, nil
+}
+
+func keyValueLegacyPersistence(spec corev1.PodSpec) (string, error) {
+	for _, container := range spec.Containers {
+		if container.Name != "valkey" {
+			continue
+		}
+		if len(container.Command) != 0 {
+			return "", fmt.Errorf("unrecognized Valkey startup command")
+		}
+		for i := 0; i+1 < len(container.Args); i++ {
+			if container.Args[i] != "--appendonly" {
+				continue
+			}
+			switch container.Args[i+1] {
+			case "yes":
+				return "journal-snapshot", nil
+			case "no":
+				for j := 0; j+1 < len(container.Args); j++ {
+					if container.Args[j] == "--save" && container.Args[j+1] == "" {
+						return "off", nil
+					}
+				}
+				return keyValuePersistenceSnapshot, nil
+			}
+		}
+	}
+	return "", fmt.Errorf("cannot determine the previous persistence mode")
+}
+
+// Conversion runs without client listeners. Both durable representations are
+// complete before the mode marker is committed, so any interruption can retry
+// from the previous mode without replaying an older dataset. In particular, an
+// online CONFIG SET followed by a later pod rollout would leave a process-
+// restart race between the runtime setting and the old startup arguments.
+const valkeyPersistenceStartup = `
+set -eu
+umask 077
+initial=$1
+desired=$2
+shift 2
+marker="` + valkeyPersistenceModePath + `"
+fail() { echo "Valkey persistence handoff failed: $1" >&2; exit 1; }
+valid_mode() { case "$1" in journal-snapshot|snapshot|off) return 0;; *) return 1;; esac; }
+source=$initial
+initialize=no
+case "$source" in new:*) source=${source#new:}; initialize=yes;; esac
+valid_mode "$source" && valid_mode "$desired" || fail "invalid mode"
+if [ -e "$marker" ]; then
+  source=$(cat "$marker") || fail "cannot read applied mode"
+  initialize=no
+fi
+valid_mode "$source" || fail "invalid applied mode"
+commit_mode() {
+  printf '%s\n' "$1" > "$marker.next" || fail "cannot record applied mode"
+  sync
+  mv "$marker.next" "$marker" || fail "cannot commit applied mode"
+  sync
+}
+
+# Off is an explicit discard, including a reversal after Off was committed but
+# cleanup was interrupted. Disabling save points alone still loads old RDBs.
+if [ "$desired" = off ] || [ "$source" = off ]; then
+  commit_mode off
+  rm -rf /data/dump.rdb /data/appendonly.aof /data/appendonlydir || fail "cannot discard disabled persistence"
+  sync
+  if [ "$desired" = off ]; then
+    exec valkey-server "$@"
+  fi
+  source=$desired
+  initialize=yes
+fi
+
+# Initialize durable files before committing the first mode marker. Thereafter
+# a missing source is corruption, including on same-mode ordinary restarts.
+if [ "$source" = journal-snapshot ]; then
+  if [ ! -f /data/appendonlydir/appendonly.aof.manifest ] && [ ! -f /data/appendonly.aof ]; then
+    [ "$initialize" = yes ] && [ ! -e /data/dump.rdb ] && [ ! -e /data/appendonlydir ] || fail "source journal is missing"
+  fi
+else
+  if [ ! -f /data/dump.rdb ]; then
+    [ "$initialize" = yes ] && [ ! -e /data/appendonly.aof ] && [ ! -e /data/appendonlydir ] || fail "source snapshot is missing"
+  fi
+fi
+if [ "$source" != "$desired" ] || [ "$initialize" = yes ]; then
+  private=/tmp/bex-valkey-persistence
+  mkdir -p "$private"
+  chmod 700 "$private"
+  socket="$private/socket"
+  rm -f "$socket"
+  child=
+  cleanup() {
+	if [ -n "$child" ] && kill -0 "$child" 2>/dev/null; then
+      kill -TERM "$child" 2>/dev/null || true
+      waited=0
+      while kill -0 "$child" 2>/dev/null && [ "$waited" -lt 5 ]; do
+        sleep 1
+        waited=$((waited+1))
+      done
+      kill -KILL "$child" 2>/dev/null || true
+      wait "$child" 2>/dev/null || true
+    fi
+    rm -f "$socket"
+  }
+  trap cleanup EXIT
+  trap 'exit 143' TERM INT
+  aof=no
+  [ "$source" != journal-snapshot ] || aof=yes
+  valkey-server --port 0 --tls-port 0 --unixsocket "$socket" --unixsocketperm 600 --dir /data --save '' --appendonly "$aof" --auto-aof-rewrite-percentage 0 > "$private/server.log" 2>&1 &
+  child=$!
+  tries=0
+  until [ "$(timeout 5 valkey-cli -e --raw -s "$socket" PING 2>/dev/null)" = PONG ]; do
+    kill -0 "$child" 2>/dev/null || fail "source engine did not start"
+    tries=$((tries+1))
+    [ "$tries" -lt 120 ] || fail "source engine did not become ready"
+    sleep 1
+  done
+  # Install authentication over the private socket using stdin, never argv.
+  # AUTH follows CONFIG so valkey-cli's pipe completion check is authenticated.
+  export LC_ALL=C
+  {
+    printf '*4\r\n$6\r\nCONFIG\r\n$3\r\nSET\r\n$11\r\nrequirepass\r\n$%s\r\n%s\r\n' "${#VALKEY_PASSWORD}" "$VALKEY_PASSWORD"
+    printf '*2\r\n$4\r\nAUTH\r\n$%s\r\n%s\r\n' "${#VALKEY_PASSWORD}" "$VALKEY_PASSWORD"
+  } | timeout 10 valkey-cli -e -s "$socket" --pipe > /dev/null 2>&1 || fail "private authentication failed"
+  export REDISCLI_AUTH="$VALKEY_PASSWORD"
+  cli() { timeout 10 valkey-cli -e --raw -s "$socket" "$@" 2>/dev/null; }
+  if [ "$desired" = journal-snapshot ] && [ "$source" != journal-snapshot ]; then
+    reply=$(cli CONFIG SET appendonly yes) || fail "journal could not be enabled"
+    [ "$reply" = OK ] || fail "journal could not be enabled"
+    tries=0
+    while :; do
+      state=$(cli INFO persistence | tr -d '\r') || fail "cannot inspect journal conversion"
+      field() { printf '%s\n' "$state" | awk -F: -v key="$1" '$1 == key {print $2}'; }
+      [ "$(field aof_enabled)" = 1 ] || fail "journal is not enabled"
+      [ "$(field aof_last_bgrewrite_status)" = ok ] || fail "journal rewrite failed"
+      [ "$(field aof_last_write_status)" = ok ] || fail "journal write failed"
+      running=$(field aof_rewrite_in_progress)
+      scheduled=$(field aof_rewrite_scheduled)
+      case "$running:$scheduled" in
+        0:0)
+          rewrites=$(field aof_rewrites)
+          elapsed=$(field aof_last_rewrite_time_sec)
+          case "$rewrites:$elapsed" in *[!0-9:]*|:*|*:) fail "journal completion was not observed";; esac
+          [ "$rewrites" -ge 1 ] || fail "journal rewrite did not complete"
+          break;;
+        0:1|1:0|1:1) ;;
+        *) fail "unknown journal conversion state";;
+      esac
+      tries=$((tries+1))
+      [ "$tries" -lt 120 ] || fail "journal conversion timed out"
+      sleep 1
+    done
+  fi
+  # SAVE must succeed before shutdown, which keeps a journal source enabled.
+  # No client writes can enter between the saved dataset and marker commit.
+  reply=$(timeout 120 valkey-cli -e --raw -s "$socket" SAVE 2>/dev/null) || fail "snapshot handoff failed"
+  [ "$reply" = OK ] || fail "snapshot handoff failed"
+  timeout 120 valkey-cli -e --raw -s "$socket" SHUTDOWN NOSAVE > /dev/null 2>&1 || fail "source engine did not stop safely"
+  wait "$child" || fail "source engine shutdown failed"
+  child=
+  trap - EXIT TERM INT
+  rm -f "$socket"
+fi
+commit_mode "$desired"
+exec valkey-server "$@"
+`
