+func TestKeyValuePersistenceBootstrapWithoutRunningPod(t *testing.T) {
+	for _, mode := range []string{"", "journal-snapshot", "snapshot", "off"} {
+		t.Run("new mode="+mode, func(t *testing.T) {
+			kv, _, _ := persistenceControllerObjects(mode, mode)
