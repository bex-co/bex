+func TestKeyValuePersistenceBootstrapUsesTheServingPod(t *testing.T) {
+	kv, sts, pod := persistenceControllerObjects("snapshot", "journal-snapshot")
+	// The old operator already accepted the requested journal flags, but its
+	// Snapshot pod remains the last writer. Following the pending STS template
+	// here would replay the old journal without converting the current RDB.
+	applyKeyValueStatefulSet(sts, kv, persistenceControllerIntent(kv))
+	sts.Generation = 2
+	sts.Status.UpdateRevision = "pending-journal"
+	r := persistenceController(t, kv, sts, pod)
+	bootstrap, err := r.keyValuePersistenceBootstrap(t.Context(), kv, sts)
+	if err != nil || bootstrap != "snapshot" {
+		t.Fatalf("pending legacy rollout lost the serving source: source=%q err=%v", bootstrap, err)
+	}
+	intent := persistenceControllerIntent(kv)
+	intent.persistenceBootstrapMode = bootstrap
+	applyKeyValueStatefulSet(sts, kv, intent)
+	server := sts.Spec.Template.Spec.Containers[0]
+	if len(server.Command) == 0 || len(server.Args) < 2 || server.Args[0] != "snapshot" || server.Args[1] != "journal-snapshot" {
+		t.Fatalf("replacement does not hand off Snapshot to Journal before serving: command=%v args prefix=%v", server.Command[:min(2, len(server.Command))], server.Args[:min(2, len(server.Args))])
+	}
+}
