+func TestKeyValuePersistenceLeavesUnchangedLegacyWorkloadsAlone(t *testing.T) {
+	for _, mode := range []string{"", "journal-snapshot", "snapshot", "off"} {
+		t.Run("mode="+mode, func(t *testing.T) {
+			kv, sts, pod := persistenceControllerObjects(mode, mode)
+			r := persistenceController(t, kv, sts, pod)
+			bootstrap, err := r.keyValuePersistenceBootstrap(t.Context(), kv, sts)
+			if err != nil || bootstrap != "" {
+				t.Fatalf("unchanged legacy store adopted conversion: source=%q err=%v", bootstrap, err)
+			}
+			before := sts.Spec.Template.DeepCopy()
+			intent := persistenceControllerIntent(kv)
+			intent.persistenceBootstrapMode = bootstrap
+			applyKeyValueStatefulSet(sts, kv, intent)
+			if !reflect.DeepEqual(*before, sts.Spec.Template) {
+				t.Fatal("operator upgrade changed an unchanged legacy pod template and would roll the store")
+			}
+		})
+	}
+}
