+func TestKeyValuePersistenceReadinessRequiresTheWrittenGeneration(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		generation int64
+		podReady   bool
+		readError  bool
+		wantReady  bool
+	}{
+		{"cached previous generation is Ready", 1, true, false, false},
+		{"current generation and pod are Ready", 2, true, false, true},
+		{"current pod is not Ready", 2, false, false, false},
+		{"StatefulSet read failed", 2, true, true, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			kv, observed, pod := persistenceControllerObjects("snapshot", "journal-snapshot")
+			written := observed.DeepCopy()
+			written.Generation = 2
+			intent := persistenceControllerIntent(kv)
+			intent.persistenceBootstrapMode = "snapshot"
+			applyKeyValueStatefulSet(written, kv, intent)
+			if tc.generation == 2 {
+				observed = written.DeepCopy()
+				observed.Status.ObservedGeneration = 2
+				observed.Status.CurrentRevision = "journal-revision"
+				observed.Status.UpdateRevision = "journal-revision"
+				pod.Spec = *observed.Spec.Template.Spec.DeepCopy()
+				pod.Labels[appsv1.StatefulSetRevisionLabel] = "journal-revision"
+			}
+			if !tc.podReady {
+				pod.Status.Conditions[0].Status = corev1.ConditionFalse
+			}
+			r := persistenceController(t, kv, observed, pod)
+			if tc.readError {
+				r.Client = interceptor.NewClient(r.Client.(client.WithWatch), interceptor.Funcs{
+					Get: func(ctx context.Context, c client.WithWatch, key client.ObjectKey, obj client.Object, opts ...client.GetOption) error {
+						if _, ok := obj.(*appsv1.StatefulSet); ok {
+							return errors.New("StatefulSet cache unavailable")
+						}
+						return c.Get(ctx, key, obj, opts...)
+					},
+				})
+			}
+			if err := r.Get(t.Context(), client.ObjectKeyFromObject(kv), kv); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := r.updateKeyValueReadiness(t.Context(), kv, written, 1, "credentials-current"); err != nil {
+				t.Fatal(err)
+			}
+			if err := r.Get(t.Context(), client.ObjectKeyFromObject(kv), kv); err != nil {
+				t.Fatal(err)
+			}
+			wantMode, wantPhase, wantCondition := "snapshot", appv1alpha1.KVPhaseProvisioning, metav1.ConditionFalse
+			if tc.wantReady {
+				wantMode, wantPhase, wantCondition = "journal-snapshot", appv1alpha1.KVPhaseReady, metav1.ConditionTrue
+			}
+			condition := meta.FindStatusCondition(kv.Status.Conditions, appv1alpha1.ConditionReady)
+			if kv.Status.AppliedPersistenceMode != wantMode || kv.Status.Phase != wantPhase || condition == nil || condition.Status != wantCondition || condition.ObservedGeneration != kv.Generation {
+				t.Fatalf("applied=%q phase=%s Ready=%+v; want applied=%q phase=%s Ready=%s for generation %d", kv.Status.AppliedPersistenceMode, kv.Status.Phase, condition, wantMode, wantPhase, wantCondition, kv.Generation)
+			}
+		})
+	}
+}
