+			r := persistenceController(t, kv)
+			bootstrap, err := r.keyValuePersistenceBootstrap(t.Context(), kv, &appsv1.StatefulSet{})
+			want := mode
+			if want == "" {
+				want = "journal-snapshot"
+			}
+			want = "new:" + want
+			if err != nil || bootstrap != want {
+				t.Fatalf("new store source=%q err=%v, want %q", bootstrap, err, want)
+			}
+		})
+	}
+	// A settled, suspended legacy store has no running pod. Its last stable
+	// template still identifies the files to convert when it resumes.
+	kv, sts, _ := persistenceControllerObjects("", "snapshot")
+	kv.Spec.Suspended = true
+	r := persistenceController(t, kv, sts)
+	if bootstrap, err := r.keyValuePersistenceBootstrap(t.Context(), kv, sts); err != nil || bootstrap != "journal-snapshot" {
+		t.Fatalf("suspended legacy journal source=%q err=%v", bootstrap, err)
+	}
