+
+// Accepted configuration is visible immediately, but only the operator can
+// declare the handoff and replacement workload ready. All adapters preserve
+// that distinction; a successful mode write is not data-survival evidence.
+func TestPersistenceModeReadinessAcrossSurfaces(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		phase     appv1alpha1.KeyValuePhase
+		observed  int64
+		ready     metav1.ConditionStatus
+		reason    string
+		want      string
+		applied   string
+		suspended bool
+	}{
+		{"accepted before reconcile", appv1alpha1.KVPhaseReady, 1, metav1.ConditionTrue, "Provisioned", "config_restart", "snapshot", false},
+		{"handoff pending", appv1alpha1.KVPhaseProvisioning, 2, metav1.ConditionFalse, "PersistenceConverting", "config_restart", "snapshot", false},
+		{"handoff failed", appv1alpha1.KVPhaseFailed, 2, metav1.ConditionFalse, "PersistenceSourceUnavailable", "unavailable", "snapshot", false},
+		{"handoff and rollout complete", appv1alpha1.KVPhaseReady, 2, metav1.ConditionTrue, "Provisioned", "available", "journal-snapshot", false},
+		{"suspended awaiting conversion", appv1alpha1.KVPhaseProvisioning, 2, metav1.ConditionFalse, "PersistenceAwaitingResume", "suspended", "snapshot", true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			kv := &appv1alpha1.KeyValue{
+				ObjectMeta: metav1.ObjectMeta{Name: "red-persistence", Namespace: "default", Generation: 2},
+				Spec:       appv1alpha1.KeyValueSpec{Name: "cache", Plan: "free", PersistenceMode: "journal-snapshot", Suspended: tc.suspended},
+				Status: appv1alpha1.KeyValueStatus{
+					Phase: tc.phase, CredentialRevision: "served-revision", AppliedPersistenceMode: tc.applied,
+					Conditions: []metav1.Condition{{
+						Type: appv1alpha1.ConditionReady, Status: tc.ready, Reason: tc.reason, ObservedGeneration: tc.observed,
+					}},
+				},
+			}
+			svc, _ := newService(kv)
+			check := func(surface, status, mode string) {
+				t.Helper()
+				if status != tc.want || mode != "journal_snapshot" {
+					t.Fatalf("%s: status/mode = %q/%q, want %q/journal_snapshot", surface, status, mode, tc.want)
+				}
+			}
+			rest := serveREST(svc, http.MethodGet, "/v1/key-value/"+kv.Name, "")
+			if rest.Code != http.StatusOK {
+				t.Fatalf("REST: %d %s", rest.Code, rest.Body)
+			}
+			var restView renderKeyValue
+			if err := json.Unmarshal(rest.Body.Bytes(), &restView); err != nil {
+				t.Fatal(err)
+			}
+			check("REST", restView.Status, restView.Options.PersistenceMode)
+
+			schema, err := kvGQLSchema(svc)
+			if err != nil {
+				t.Fatal(err)
+			}
+			gql := graphql.Do(graphql.Params{Schema: schema, Context: ctxAs("user-a"), RequestString: `{ keyValue(id:"red-persistence") { status persistenceMode } }`})
+			if len(gql.Errors) > 0 {
+				t.Fatal(gql.Errors)
+			}
+			gqlView := gql.Data.(map[string]any)["keyValue"].(map[string]any)
+			check("GraphQL", gqlView["status"].(string), gqlView["persistenceMode"].(string))
+
+			call, cleanup := kvMCPClient(t, svc)
+			defer cleanup()
+			mcpView := call("get_key_value", map[string]any{"keyValueId": kv.Name})
+			check("MCP", mcpView["status"].(string), mcpView["persistenceMode"].(string))
+		})
+	}
+}
+
+func TestPersistenceModePreviewsDoNotStartAHandoff(t *testing.T) {
+	for _, surface := range []string{"REST", "GraphQL", "MCP"} {
+		t.Run(surface, func(t *testing.T) {
+			kv := &appv1alpha1.KeyValue{
+				ObjectMeta: metav1.ObjectMeta{Name: "red-persistence", Namespace: "default", Generation: 1},
+				Spec:       appv1alpha1.KeyValueSpec{Name: "cache", Plan: "free", PersistenceMode: "snapshot"},
+				Status:     appv1alpha1.KeyValueStatus{Phase: appv1alpha1.KVPhaseReady},
+			}
+			svc, cl := newService(kv)
+			for _, mode := range []struct{ input, want string }{
+				{"journal_snapshot", "journal_snapshot"},
+				{"journal-snapshot", "journal_snapshot"},
+				{"off", "off"},
+			} {
+				var preview string
+				switch surface {
+				case "REST":
+					res := serveREST(svc, http.MethodPatch, "/v1/key-value/"+kv.Name,
+						fmt.Sprintf(`{"persistenceMode":%q,"dryRun":true}`, mode.input))
+					if res.Code != http.StatusOK {
+						t.Fatalf("REST preview: %d %s", res.Code, res.Body)
+					}
+					var view renderKeyValue
+					if err := json.Unmarshal(res.Body.Bytes(), &view); err != nil {
+						t.Fatal(err)
+					}
+					preview = view.Options.PersistenceMode
+				case "GraphQL":
+					schema, err := kvGQLSchema(svc)
+					if err != nil {
+						t.Fatal(err)
+					}
+					res := graphql.Do(graphql.Params{Schema: schema, Context: ctxAs("user-a"), RequestString: fmt.Sprintf(
+						`mutation { setKeyValuePersistenceMode(id:"red-persistence",persistenceMode:%q,dryRun:true) { persistenceMode } }`, mode.input)})
+					if len(res.Errors) > 0 {
+						t.Fatal(res.Errors)
+					}
+					preview = res.Data.(map[string]any)["setKeyValuePersistenceMode"].(map[string]any)["persistenceMode"].(string)
+				case "MCP":
+					call, cleanup := kvMCPClient(t, svc)
+					defer cleanup()
+					preview = call("update_key_value", map[string]any{
+						"keyValueId": kv.Name, "persistenceMode": mode.input, "dryRun": true,
+					})["persistenceMode"].(string)
+				}
+				if preview != mode.want {
+					t.Fatalf("preview mode = %q, want %q", preview, mode.want)
+				}
+				actual := getKeyValueCR(t, cl, kv.Name)
+				if actual.Spec.PersistenceMode != "snapshot" || actual.Generation != 1 || actual.Status.Phase != appv1alpha1.KVPhaseReady {
+					t.Fatalf("preview changed the stored resource: %+v", actual)
+				}
+			}
+		})
+	}
+}
