+func TestKeyValuePersistenceBootstrapSurvivesDesiredReversal(t *testing.T) {
+	kv, sts, pod := persistenceControllerObjects("snapshot", "journal-snapshot")
+	intent := persistenceControllerIntent(kv)
+	intent.persistenceBootstrapMode = "snapshot"
+	applyKeyValueStatefulSet(sts, kv, intent)
+	// The wrapper may or may not have committed its PVC marker. Reverting the
+	// desired mode cannot remove it or change the fallback source on restart.
+	kv.Spec.PersistenceMode = "snapshot"
+	kv.Generation++
+	r := persistenceController(t, kv, sts, pod)
+	bootstrap, err := r.keyValuePersistenceBootstrap(t.Context(), kv, sts)
+	if err != nil || bootstrap != "snapshot" {
+		t.Fatalf("reversal discarded the frozen source: source=%q err=%v", bootstrap, err)
+	}
+	intent = persistenceControllerIntent(kv)
+	intent.persistenceBootstrapMode = bootstrap
+	applyKeyValueStatefulSet(sts, kv, intent)
+	server := sts.Spec.Template.Spec.Containers[0]
+	if len(server.Command) == 0 || server.Args[0] != "snapshot" || server.Args[1] != "snapshot" {
+		t.Fatal("reversal bypassed the persistent marker reader")
+	}
+}
