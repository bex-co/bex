+	"time"
+
+	appv1alpha1 "github.com/bex-co/bex/lego/types/v1alpha1"
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+)
+
+// TestValkeyPersistenceEngine exercises the actual pinned engines and persisted
+// files. Run with BEX_TEST_VALKEY=1; each fixture owns one Docker volume and a
+// isolated network namespace, and removes both on success or failure.
+func TestValkeyPersistenceEngine(t *testing.T) {
+	if os.Getenv("BEX_TEST_VALKEY") != "1" {
+		t.Skip("set BEX_TEST_VALKEY=1 to run the persisted-volume Valkey regression")
+	}
+	for _, version := range permittedValkeyVersions(t) {
+		t.Run(version, func(t *testing.T) {
+			t.Parallel()
+			t.Run("saved snapshot survives journal adoption", func(t *testing.T) {
+				engine := newPersistenceEngine(t, version)
+				engine.startLegacy("journal-snapshot")
+				expiry := engine.seed()
+				engine.cli("SAVE")
+				engine.restartLegacy("snapshot")
+				engine.cli("SET", "snapshot-marker", "new-snapshot-value")
+				engine.cli("SET", "counter", "23")
+				engine.cli("SAVE")
+				// Keep the finding's ordinary maxmemory-policy restart control.
+				engine.stop()
+				engine.startCommand(append(legacyValkeyCommand("snapshot"), "--maxmemory-policy", "noeviction"))
+				engine.assertData("23", "new-snapshot-value", expiry)
+				engine.stop()
+				engine.start("journal-snapshot")
+				engine.assertData("23", "new-snapshot-value", expiry)
+				engine.assertAOF(true)
+				// Conversion must still be safe after the handoff process and
+				// controller have gone away; exercise another ordinary restart.
+				engine.restart("journal-snapshot")
+				engine.assertData("23", "new-snapshot-value", expiry)
+			})
+			t.Run("snapshot without a prior journal", func(t *testing.T) {
+				engine := newPersistenceEngine(t, version)
+				engine.startLegacy("snapshot")
+				expiry := engine.seed()
+				engine.cli("SET", "snapshot-marker", "no-prior-journal")
+				engine.cli("SAVE")
+				engine.stop()
+				engine.start("journal-snapshot")
+				engine.assertData("1", "no-prior-journal", expiry)
+				engine.assertAOF(true)
+			})
+			t.Run("desired mode can change before first boot", func(t *testing.T) {
+				engine := newPersistenceEngine(t, version)
+				engine.bootstrapMode = keyValuePersistenceNewPrefix + "journal-snapshot"
+				engine.start("snapshot")
+				engine.assertEmpty()
+				engine.assertAOF(false)
+				expiry := engine.seed()
+				engine.cli("SET", "snapshot-marker", "first-boot-reversal")
+				engine.restart("journal-snapshot")
+				engine.assertData("1", "first-boot-reversal", expiry)
+				engine.assertAOF(true)
+			})
+			t.Run("interrupted handoff retries from the current snapshot", func(t *testing.T) {
+				engine := newPersistenceEngine(t, version)
+				engine.startLegacy("snapshot")
+				expiry := engine.seed()
+				engine.cli("SET", "snapshot-marker", "interrupted-conversion")
+				engine.cli("SAVE")
+				engine.stop()
+				engine.launch(engine.projectedCommand("journal-snapshot"), `#!/bin/sh
+set -eu
+/usr/local/bin/valkey-cli "$@"
+case " $* " in
+  *" CONFIG SET appendonly yes "*)
+    touch /data/test-after-aof-enable
+    while :; do sleep 1; done
+    ;;
+esac
+`)
+				engine.waitForFile("/data/test-after-aof-enable")
+				if reply, err := engine.tryCLI("PING"); err == nil && reply == "PONG" {
+					t.Fatal("conversion exposed a serving socket before its handoff completed")
+				}
+				engine.docker("rm", "-f", engine.name)
+				engine.start("journal-snapshot")
+				engine.assertData("1", "interrupted-conversion", expiry)
+				engine.assertAOF(true)
+			})
+			t.Run("failed journal creation preserves the snapshot for retry", func(t *testing.T) {
+				engine := newPersistenceEngine(t, version)
+				engine.startLegacy("journal-snapshot")
+				expiry := engine.seed()
+				engine.cli("SAVE")
+				engine.restartLegacy("snapshot")
+				engine.cli("SET", "snapshot-marker", "rewrite-failure-current-value")
+				engine.cli("SET", "counter", "23")
+				engine.cli("SAVE")
+				engine.stop()
+				engine.volumeCommand("chmod", "0500", "/data/appendonlydir")
+				engine.launch(engine.projectedCommand("journal-snapshot"), "")
+				engine.waitFailed()
+				engine.docker("rm", engine.name)
+				engine.volumeCommand("chmod", "0700", "/data/appendonlydir")
+				// A superseding return to Snapshot must still load the current
+				// RDB. Retrying the original request must then succeed too.
+				engine.start("snapshot")
+				engine.assertData("23", "rewrite-failure-current-value", expiry)
+				engine.restart("journal-snapshot")
+				engine.assertData("23", "rewrite-failure-current-value", expiry)
+				engine.assertAOF(true)
+			})
+			t.Run("scheduled and running rewrites finish before serving", func(t *testing.T) {
+				engine := newPersistenceEngine(t, version)
+				engine.startLegacy("snapshot")
+				expiry := engine.seed()
+				engine.cli("SET", "snapshot-marker", "scheduled-rewrite")
+				engine.cli("EVAL", "for i=1,20 do redis.call('SET','padding:'..i,'value') end return 20", "0")
+				engine.cli("SAVE")
+				engine.stop()
+				engine.launch(engine.projectedCommand("journal-snapshot"), `#!/bin/sh
+set -eu
+case " $* " in
+  *" CONFIG SET appendonly yes "*)
+    /usr/local/bin/valkey-cli -e -s /tmp/bex-valkey-persistence/socket CONFIG SET rdb-key-save-delay 100000 >/dev/null
+    /usr/local/bin/valkey-cli -e -s /tmp/bex-valkey-persistence/socket BGSAVE >/dev/null
+    ;;
+esac
+reply=$(/usr/local/bin/valkey-cli "$@")
+case " $* " in
+  *" -s /tmp/bex-valkey-persistence/socket "*)
+    case "$reply" in *aof_rewrite_scheduled:1*) touch /data/test-rewrite-scheduled;; esac
+    case "$reply" in *aof_rewrite_in_progress:1*) touch /data/test-rewrite-running;; esac
+    case "$reply" in
+      *aof_rewrite_in_progress:0*)
+        if [ -f /data/test-rewrite-running ]; then
+          /usr/local/bin/valkey-cli -e -s /tmp/bex-valkey-persistence/socket CONFIG SET rdb-key-save-delay 0 >/dev/null
+        fi
+        ;;
+    esac
+    ;;
+esac
+printf '%s\n' "$reply"
+`)
+				engine.waitForFile("/data/test-rewrite-scheduled")
+				if reply, err := engine.tryCLI("PING"); err == nil && reply == "PONG" {
+					t.Fatal("scheduled rewrite exposed a serving socket")
+				}
+				engine.waitReady()
+				engine.docker("exec", engine.name, "test", "-f", "/data/test-rewrite-running")
+				engine.assertData("1", "scheduled-rewrite", expiry)
+				engine.assertAOF(true)
+			})
+			t.Run("asynchronous rewrite failure stays closed and can retry", func(t *testing.T) {
+				engine := newPersistenceEngine(t, version)
+				engine.startLegacy("snapshot")
+				expiry := engine.seed()
+				engine.cli("SET", "snapshot-marker", "failed-rewrite")
+				engine.cli("SAVE")
+				engine.stop()
+				engine.launch(engine.projectedCommand("journal-snapshot"), `#!/bin/sh
+set -eu
+case " $* " in
+  *" CONFIG SET appendonly yes "*)
+    /usr/local/bin/valkey-cli -e -s /tmp/bex-valkey-persistence/socket CONFIG SET rdb-key-save-delay 2000000 >/dev/null
+    /usr/local/bin/valkey-cli "$@"
+    pid=$(ps -o pid,args | awk '/[v]alkey-aof-rewrite|[r]edis-aof-rewrite/ {print $1}')
+    [ -n "$pid" ]
+    chmod 0500 /data/appendonlydir
+    kill -KILL "$pid"
+    touch /data/test-rewrite-killed
+    ;;
+  *) exec /usr/local/bin/valkey-cli "$@";;
+esac
+`)
+				engine.waitFailed()
+				engine.volumeCommand("test", "-f", "/data/test-rewrite-killed")
+				engine.docker("rm", engine.name)
+				engine.volumeCommand("chmod", "0700", "/data/appendonlydir")
+				engine.start("journal-snapshot")
+				engine.assertData("1", "failed-rewrite", expiry)
+				engine.assertAOF(true)
+			})
+			for _, corruption := range []string{"missing", "corrupt"} {
+				t.Run(corruption+" initialized journal manifest fails closed", func(t *testing.T) {
+					engine := newPersistenceEngine(t, version)
+					engine.start("journal-snapshot")
+					expiry := engine.seed()
+					engine.cli("SET", "snapshot-marker", "valid-journal")
+					engine.cli("SAVE")
+					engine.stop()
+					const manifest = "/data/appendonlydir/appendonly.aof.manifest"
+					engine.volumeCommand("mv", manifest, "/data/test-original.manifest")
+					if corruption == "corrupt" {
+						engine.volumeCommand("sh", "-ec", "printf 'invalid manifest\\n' > /data/appendonlydir/appendonly.aof.manifest")
+					}
+					engine.launch(engine.projectedCommand("journal-snapshot"), "")
+					engine.waitFailed()
+					engine.docker("rm", engine.name)
+					engine.volumeCommand("mv", "/data/test-original.manifest", manifest)
+					engine.start("journal-snapshot")
+					engine.assertData("1", "valid-journal", expiry)
+				})
+			}
+			for _, source := range []string{"journal-snapshot", "snapshot", "off"} {
+				for _, target := range []string{"journal-snapshot", "snapshot", "off"} {
+					t.Run(source+" to "+target, func(t *testing.T) {
+						engine := newPersistenceEngine(t, version)
+						engine.start(source)
+						expiry := engine.seed()
+						engine.cli("SET", "snapshot-marker", "current-dataset")
+						engine.restart(target)
+						if source == "off" || target == "off" {
+							engine.assertEmpty()
+						} else {
+							engine.assertData("1", "current-dataset", expiry)
+						}
+						engine.assertAOF(target == "journal-snapshot")
+					})
+				}
+			}
+			t.Run("legacy empty mode is journal mode", func(t *testing.T) {
+				engine := newPersistenceEngine(t, version)
+				engine.start("")
+				expiry := engine.seed()
+				engine.cli("SET", "snapshot-marker", "legacy-mode")
+				for _, mode := range []string{"snapshot", "", "journal-snapshot"} {
+					engine.restart(mode)
+					engine.assertData("1", "legacy-mode", expiry)
+					engine.assertAOF(mode != "snapshot")
+				}
+			})
+			t.Run("old startup flags replay the stale journal", func(t *testing.T) {
+				engine := newPersistenceEngine(t, version)
+				engine.startLegacy("journal-snapshot")
+				expiry := engine.seed()
+				engine.cli("SAVE")
+				engine.restartLegacy("snapshot")
+				engine.cli("SET", "snapshot-marker", "new-snapshot-value")
+				engine.cli("SET", "counter", "23")
+				engine.cli("SAVE")
+				engine.restartLegacy("snapshot")
+				engine.assertData("23", "new-snapshot-value", expiry)
+				engine.restartLegacy("journal-snapshot")
+				// This negative control proves that the fixture contains an old
+				// journal, not just an RDB that any restart happens to preserve.
+				engine.assertData("1", "", expiry)
+			})
+			t.Run("old Off flags reload historical snapshots", func(t *testing.T) {
+				engine := newPersistenceEngine(t, version)
+				engine.startLegacy("snapshot")
+				engine.cli("SET", "historical", "before-off")
+				engine.cli("SAVE")
+				engine.restartLegacy("off")
+				if got := engine.cli("GET", "historical"); got != "before-off" {
+					t.Fatalf("old Off projection did not expose the stale-RDB control: %q", got)
+				}
+			})
+		})
+	}
+}
+
+const persistenceEnginePassword = "isolated-engine-test-password"
+
+type persistenceEngine struct {
+	t             *testing.T
+	image         string
+	name          string
+	initName      string
+	volume        string
+	bootstrapMode string
+}
+
+func newPersistenceEngine(t *testing.T, version string) *persistenceEngine {
+	t.Helper()
+	suffix := make([]byte, 6)
+	if _, err := rand.Read(suffix); err != nil {
+		t.Fatal(err)
+	}
+	name := "bex-kv-persistence-test-" + hex.EncodeToString(suffix)
+	engine := &persistenceEngine{
+		t: t, image: valkeyImage(version), name: name, initName: name + "-init", volume: name + "-data",
+	}
+	t.Cleanup(engine.cleanup)
+	engine.docker("volume", "create", engine.volume)
+	// Match the production pod's non-root identity and fsGroup preparation.
+	engine.docker("run", "--rm", "--name", engine.initName, "--network", "none", "--mount", "type=volume,src="+engine.volume+",dst=/data",
+		engine.image, "chown", "999:1000", "/data")
+	return engine
+}
+
+func (engine *persistenceEngine) cleanup() {
+	engine.t.Helper()
+	// A timed-out Docker client can leave its operation running in the daemon.
+	// Always try every owned resource, even after an earlier removal failed.
+	for _, args := range [][]string{
+		{"rm", "-f", engine.initName},
+		{"rm", "-f", engine.name},
+		{"volume", "rm", engine.volume},
+	} {
+		out, err := engine.tryDocker(args...)
+		detail := strings.ToLower(out)
+		missing := strings.Contains(detail, "no such container") || strings.Contains(detail, "no such volume")
+		if err != nil && !missing {
+			engine.t.Errorf("fixture cleanup %v failed: %v\n%s", args, err, out)
+		}
+	}
+}
+
+func (engine *persistenceEngine) docker(args ...string) string {
+	engine.t.Helper()
+	out, err := engine.tryDocker(args...)
+	if err != nil {
+		engine.t.Fatalf("Docker %s failed: %v\n%s", args[0], err, out)
+	}
+	return out
+}
+
+func (engine *persistenceEngine) tryDocker(args ...string) (string, error) {
+	// Shared Docker hosts can queue create/exec/removal behind unrelated I/O.
+	// This orchestration budget does not change the engine's conversion bounds.
+	ctx, cancel := context.WithTimeout(context.Background(), 120*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, "docker", args...)
+	cmd.Env = append(os.Environ(), "VALKEY_PASSWORD="+persistenceEnginePassword, "REDISCLI_AUTH="+persistenceEnginePassword)
+	out, err := cmd.CombinedOutput()
+	return strings.TrimSpace(strings.ReplaceAll(string(out), persistenceEnginePassword, "[test credential]")), err
+}
+
+// start uses the production pod projection, including its persistent startup
+// configuration. Only the Kubernetes Secret and volume plumbing are replaced
+// by the isolated test credential and the fixture's named Docker volume.
+func (engine *persistenceEngine) start(mode string) {
+	engine.t.Helper()
+	engine.startCommand(engine.projectedCommand(mode))
+}
+
+func (engine *persistenceEngine) projectedCommand(mode string) []string {
+	engine.t.Helper()
+	if engine.bootstrapMode == "" {
+		engine.bootstrapMode = keyValuePersistenceNewPrefix + effectiveKeyValuePersistence(mode)
+	}
+	kv := &appv1alpha1.KeyValue{
+		ObjectMeta: metav1.ObjectMeta{Name: "red-engine", Namespace: "engine-test"},
+		Spec:       appv1alpha1.KeyValueSpec{PersistenceMode: mode},
+	}
+	plan, _ := resolveKVPlan(kv.Spec)
+	var pod corev1.PodSpec
+	applyValkeyPodSpec(&pod, kv, keyValueIntent{
+		plan: plan, authSecretName: "red-engine-auth", persistenceBootstrapMode: engine.bootstrapMode,
+	})
+	container := pod.Containers[0]
+	command := container.Command
+	if len(command) == 0 {
+		command = []string{"valkey-server"}
+	}
+	return append(append([]string{}, command...), container.Args...)
+}
+
+func (engine *persistenceEngine) startLegacy(mode string) {
+	engine.t.Helper()
+	engine.bootstrapMode = mode
+	if mode == "" {
+		engine.bootstrapMode = "journal-snapshot"
+	}
+	engine.startCommand(legacyValkeyCommand(mode))
+}
+
+func legacyValkeyCommand(mode string) []string {
+	args := []string{"valkey-server", "--requirepass", "$(VALKEY_PASSWORD)", "--appendonly", "yes"}
+	if mode == "snapshot" || mode == "off" {
+		args[len(args)-1] = "no"
+	}
+	if mode == "off" {
+		args = append(args, "--save", "")
+	}
+	return args
+}
+
+func (engine *persistenceEngine) startCommand(command []string) {
+	engine.t.Helper()
+	engine.launch(command, "")
+	engine.waitReady()
+}
+
+// A CLI interceptor observes or stops an actual engine command at a precise
+// crash boundary. It delegates every protocol exchange to the image's real
+// valkey-cli; production startup logic and persisted files are unchanged.
+func (engine *persistenceEngine) launch(command []string, interceptor string) {
+	engine.t.Helper()
+	for i := range command {
+		// Kubernetes performs this substitution in command/args. The value is
+		// fixture-only; failure output is scrubbed in tryDocker.
+		command[i] = strings.ReplaceAll(command[i], "$(VALKEY_PASSWORD)", persistenceEnginePassword)
+	}
+	args := []string{"create", "--name", engine.name, "--user", "999:1000",
+		"--network", "none", "--env", "VALKEY_PASSWORD",
+		"--mount", "type=volume,src=" + engine.volume + ",dst=/data"}
+	if interceptor != "" {
+		args = append(args, "--env", "PATH=/tmp:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin")
+	}
+	args = append(args, "--entrypoint", command[0], engine.image)
+	engine.docker(append(args, command[1:]...)...)
+	if interceptor != "" {
+		path := filepath.Join(engine.t.TempDir(), "valkey-cli")
+		if err := os.WriteFile(path, []byte(interceptor), 0o755); err != nil {
+			engine.t.Fatal(err)
+		}
+		engine.docker("cp", path, engine.name+":/tmp/valkey-cli")
+	}
+	engine.docker("start", engine.name)
+}
+
+func (engine *persistenceEngine) waitReady() {
+	engine.t.Helper()
+	deadline := time.Now().Add(15 * time.Second)
+	for time.Now().Before(deadline) {
+		if out, err := engine.tryCLI("PING"); err == nil && out == "PONG" {
+			return
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+	engine.t.Fatalf("Valkey did not become ready: %s", engine.docker("logs", engine.name))
+}
+
+func (engine *persistenceEngine) waitForFile(path string) {
+	engine.t.Helper()
+	deadline := time.Now().Add(15 * time.Second)
+	for time.Now().Before(deadline) {
+		if _, err := engine.tryDocker("exec", engine.name, "test", "-f", path); err == nil {
+			return
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+	engine.t.Fatalf("conversion did not reach the injected crash boundary: %s", engine.docker("logs", engine.name))
+}
+
+func (engine *persistenceEngine) waitFailed() {
+	engine.t.Helper()
+	deadline := time.Now().Add(15 * time.Second)
+	for time.Now().Before(deadline) {
+		if reply, err := engine.tryCLI("PING"); err == nil && reply == "PONG" {
+			engine.t.Fatal("failed conversion exposed a serving socket")
+		}
+		if engine.docker("inspect", "--format", "{{.State.Running}}", engine.name) == "false" {
+			if engine.docker("inspect", "--format", "{{.State.ExitCode}}", engine.name) == "0" {
+				engine.t.Fatal("failed conversion exited successfully")
+			}
+			return
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+	privateLog, _ := engine.tryDocker("exec", engine.name, "cat", "/tmp/bex-valkey-persistence/server.log")
+	engine.t.Fatalf("conversion did not stop after the injected failure: %s\n%s", engine.docker("logs", engine.name), privateLog)
+}
+
+func (engine *persistenceEngine) volumeCommand(command ...string) {
+	engine.t.Helper()
+	args := make([]string, 0, 11+len(command))
+	args = append(args, "run", "--rm", "--name", engine.initName, "--network", "none", "--user", "999:1000",
+		"--mount", "type=volume,src="+engine.volume+",dst=/data", engine.image)
+	engine.docker(append(args, command...)...)
+}
+
+func (engine *persistenceEngine) stop() {
+	engine.t.Helper()
+	engine.docker("stop", "--time", "15", engine.name)
+	engine.docker("rm", engine.name)
+}
+
+func (engine *persistenceEngine) restartLegacy(mode string) {
+	engine.t.Helper()
+	engine.stop()
+	engine.startLegacy(mode)
+}
+
+func (engine *persistenceEngine) restart(mode string) {
+	engine.t.Helper()
+	engine.stop()
+	engine.start(mode)
+}
+
+func (engine *persistenceEngine) cli(args ...string) string {
+	engine.t.Helper()
+	out, err := engine.tryCLI(args...)
+	if err != nil {
+		engine.t.Fatalf("Valkey %s failed: %v\n%s", args[0], err, out)
+	}
+	return out
+}
+
+func (engine *persistenceEngine) tryCLI(args ...string) (string, error) {
+	prefix := make([]string, 0, 8+len(args))
+	prefix = append(prefix, "exec", "--env", "REDISCLI_AUTH", engine.name, "valkey-cli", "--raw", "--no-auth-warning", "-e")
+	return engine.tryDocker(append(prefix, args...)...)
+}
+
+func (engine *persistenceEngine) seed() string {
+	engine.t.Helper()
+	engine.cli("SET", "baseline", "original-value")
+	engine.cli("SET", "expiring", "original-ttl", "PX", "900000")
+	engine.cli("SET", "counter", "1")
+	return engine.cli("PEXPIRETIME", "expiring")
+}
+
+func (engine *persistenceEngine) assertData(counter, marker, expiry string) {
+	engine.t.Helper()
+	for key, want := range map[string]string{
+		"baseline": "original-value", "counter": counter, "snapshot-marker": marker, "expiring": "original-ttl",
+	} {
+		if got := engine.cli("GET", key); got != want {
+			engine.t.Errorf("GET %s = %q, want %q", key, got, want)
+		}
+	}
+	if got := engine.cli("PEXPIRETIME", "expiring"); got != expiry {
+		engine.t.Errorf("expiration deadline = %s, want the original deadline %s", got, expiry)
+	}
+	if got := engine.cli("PTTL", "baseline"); got != "-1" {
+		engine.t.Errorf("non-expiring baseline TTL = %q, want -1", got)
+	}
+}
+
+func (engine *persistenceEngine) persistence() map[string]string {
+	engine.t.Helper()
+	state := make(map[string]string)
+	for line := range strings.SplitSeq(engine.cli("INFO", "persistence"), "\n") {
+		if key, value, ok := strings.Cut(strings.TrimSpace(line), ":"); ok {
+			state[key] = value
+		}
+	}
+	return state
+}
+
+func (engine *persistenceEngine) assertAOF(enabled bool) {
+	engine.t.Helper()
+	want := "0"
+	if enabled {
+		want = "1"
+	}
+	if got := engine.persistence()["aof_enabled"]; got != want {
+		engine.t.Errorf("aof_enabled = %q, want %q", got, want)
+	}
+}
+
+func (engine *persistenceEngine) assertEmpty() {
+	engine.t.Helper()
+	if got := engine.cli("DBSIZE"); got != "0" {
+		engine.t.Errorf("Off transition retained or resurrected %s keys, want an empty store", got)
+	}
+}
