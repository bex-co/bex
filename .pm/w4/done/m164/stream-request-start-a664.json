  "fixtureSource": "const http=require('node:http'),crypto=require('node:crypto');const boot=crypto.randomUUID();http.createServer((q,s)=>{if(q.url==='/events'){s.writeHead(200,{'Content-Type':'text/event-stream','Cache-Control':'no-cache','Connection':'keep-alive','X-Accel-Buffering':'no'});s.flushHeaders();let seq=0;const emit=()=>s.write('event: ping\\ndata: '+JSON.stringify({marker:'QA_A664',boot,seq:seq++,at:new Date().toISOString()})+'\\n\\n');emit();const timer=setInterval(emit,15000);const end=setTimeout(()=>{clearInterval(timer);s.end('event: done\\ndata: '+JSON.stringify({marker:'QA_A664_DONE',boot,seq})+'\\n\\n')},380000);s.on('close',()=>{clearInterval(timer);clearTimeout(end)})}else{s.writeHead(200,{'Content-Type':'application/json'});s.end(JSON.stringify({marker:'QA_A664',boot}))}}).listen(8080,'0.0.0.0');\n",
  "clientSource": "const https=require('node:https'),fs=require('node:fs');const out='.playwright-mcp/qa-a664-stream-results.json';const start=Date.now();const state={startedAt:new Date(start).toISOString(),status:'connecting',frames:[],errors:[]};let finished=false,buffer='',timer;\nfunction save(){fs.writeFileSync(out,JSON.stringify({...state,updatedAt:new Date().toISOString(),elapsedMs:Date.now()-start},null,2)+'\\n')}\nfunction finish(reason,error){if(finished)return;finished=true;clearTimeout(timer);state.status='finished';state.finishedAt=new Date().toISOString();state.reason=reason;if(error)state.errors.push(String(error));state.pings=state.frames.filter(f=>f.event==='ping').length;state.sawDone=state.frames.some(f=>f.event==='done'&&f.data?.marker==='QA_A664_DONE');state.complete=reason==='end'&&state.sawDone;save();console.log(JSON.stringify({finishedAt:state.finishedAt,reason,elapsedMs:Date.now()-start,pings:state.pings,sawDone:state.sawDone,complete:state.complete,errors:state.errors}));}\nconst req=https.get('https://qa-20261016-a664-stream.onbex.co/events',{headers:{'Accept':'text/event-stream','User-Agent':'Mozilla/5.0'}},res=>{state.status='streaming';state.httpStatus=res.statusCode;state.headers=res.headers;state.headersAt=new Date().toISOString();state.firstHeaderMs=Date.now()-start;save();console.log(JSON.stringify({headersAt:state.headersAt,status:res.statusCode,firstHeaderMs:state.firstHeaderMs,type:res.headers['content-type']}));res.setEncoding('utf8');res.on('data',chunk=>{buffer+=chunk;let end;while((end=buffer.indexOf('\\n\\n'))>=0){const raw=buffer.slice(0,end);buffer=buffer.slice(end+2);const event=raw.split('\\n').find(l=>l.startsWith('event: '))?.slice(7);const data=raw.split('\\n').find(l=>l.startsWith('data: '))?.slice(6);let parsed;try{parsed=JSON.parse(data)}catch{state.errors.push('unparsed event');continue}state.frames.push({receivedAt:new Date().toISOString(),elapsedMs:Date.now()-start,event,data:parsed});save();if(state.frames.length===1||state.frames.length%2===0||event==='done')console.log(JSON.stringify({at:new Date().toISOString(),frames:state.frames.length,event,seq:parsed.seq,elapsedMs:Date.now()-start}))}});res.on('end',()=>finish('end'));res.on('aborted',()=>finish('aborted'));res.on('error',e=>finish('response-error',e))});req.setTimeout(25000,()=>req.destroy(new Error('no stream data for25seconds')));req.on('error',e=>finish('request-error',e));timer=setTimeout(()=>{finish('total-timeout');req.destroy()},410000);save();\n\n",
