  "scope": "Passing controls for m219's allowlist. No resource created, no endpoint submitted, no outbound webhook sent.",
  "startupControlFactory": "function(width){return `async(page)=>{\nawait page.setViewportSize({width:${width},height:844});await page.goto(\"about:blank\",{waitUntil:\"commit\"});let release,released=false;const gate=new Promise(r=>release=r),scripts=[],tasks=[];const pattern=\"https://dashboard.bex.co/assets/index-D60ymwlM.js\";const handler=async route=>{const task=(async()=>{const r=await route.fetch();scripts.push({url:route.request().url(),status:r.status(),bytes:(await r.body()).length,delayApplied:!released});await gate;await route.fulfill({response:r});})();tasks.push(task);await task;};await page.route(pattern,handler);\ntry{\nawait page.goto(\"https://dashboard.bex.co/webhooks/new\",{waitUntil:\"commit\"});for(let i=0;i<60&&!scripts.length;i++)await page.waitForTimeout(100);if(!scripts.length)throw Error(\"Startup entry not intercepted\");await page.waitForTimeout(1200);\nconst before={nameCount:await page.getByRole(\"textbox\",{name:\"Name\",exact:true}).count(),urlCount:await page.getByRole(\"textbox\",{name:\"Destination URL\",exact:true}).count(),main:await page.locator(\"main\").ariaSnapshot()};released=true;release();await Promise.allSettled(tasks);\nconst name=page.getByRole(\"textbox\",{name:\"Name\",exact:true}),url=page.getByRole(\"textbox\",{name:\"Destination URL\",exact:true});await name.waitFor({timeout:15000});const ready=await name.evaluate(e=>({enabled:!e.disabled,reactProps:Object.keys(e).some(k=>k.startsWith(\"__reactProps$\"))}));await name.click();await page.keyboard.insertText(\"qa-a805-startup-ready\");await url.click();await page.keyboard.insertText(\"https://example.com/qa-a805\");await page.waitForTimeout(1500);return{at:new Date().toISOString(),width:${width},scripts,before,ready,after:{name:await name.inputValue(),url:await url.inputValue()},noSubmit:true};\n}finally{released=true;release();await Promise.allSettled(tasks);await page.unroute(pattern,handler);}\n}`}",
  "catalogRecoveryFactory": "function(width){return `async(page)=>{\nawait page.setViewportSize({width:${width},height:844});await page.goto(\"about:blank\",{waitUntil:\"commit\"});const records=[],tasks=[];let attempt=0;\nconst handler=async route=>{let a;try{const q=route.request().postDataJSON();a=Array.isArray(q)?q:[q];}catch{return route.continue();}const idx=a.findIndex(x=>x.operationName===\"WebhookEventTypes\");if(idx<0)return route.continue();const n=++attempt;const task=(async()=>{const response=await route.fetch();const raw=await response.json(),entry=Array.isArray(raw)?raw[idx]:raw;const served=n<=2?{data:{webhookEventTypes:null},errors:[{message:\"qa-a805-synthetic-event-catalog-failure\",path:[\"webhookEventTypes\"]}]}:entry;records.push({attempt:n,request:a[idx],status:response.status(),realEntry:entry,servedEntry:served,synthetic:n<=2,siblingOperations:a.filter((_,i)=>i!==idx).map(x=>x.operationName),siblingBodiesPreserved:true});if(n<=2){const body=Array.isArray(raw)?raw.map((x,i)=>i===idx?served:x):served;await route.fulfill({response,body:JSON.stringify(body)});}else await route.fulfill({response});})();tasks.push(task);await task;};\nawait page.route(\"**/graphql\",handler);\nconst state=async()=>({name:await page.getByRole(\"textbox\",{name:\"Name\",exact:true}).inputValue(),url:await page.getByRole(\"textbox\",{name:\"Destination URL\",exact:true}).inputValue(),alerts:await page.getByRole(\"alert\").allTextContents(),retryCount:await page.getByRole(\"button\",{name:\"Retry event types\",exact:true}).count(),createDisabled:await page.getByRole(\"button\",{name:\"Create webhook\",exact:true}).isDisabled(),checkboxCount:await page.getByRole(\"checkbox\").count()});\ntry{\nawait page.goto(\"https://dashboard.bex.co/webhooks/new\");await page.getByRole(\"button\",{name:\"Retry event types\",exact:true}).waitFor({timeout:15000});await page.getByRole(\"textbox\",{name:\"Name\",exact:true}).fill(\"qa-a805-catalog\");await page.getByRole(\"textbox\",{name:\"Destination URL\",exact:true}).fill(\"https://example.com/qa-a805\");const first=await state();await page.getByRole(\"button\",{name:\"Retry event types\",exact:true}).click();for(let i=0;i<100&&records.length<2;i++)await page.waitForTimeout(100);await page.getByRole(\"button\",{name:\"Retry event types\",exact:true}).waitFor({timeout:10000});const second=await state();await page.getByRole(\"button\",{name:\"Retry event types\",exact:true}).click();await page.getByRole(\"checkbox\",{name:\"Deploy Ended\",exact:true}).waitFor({timeout:15000});await page.getByRole(\"checkbox\",{name:\"Deploy Ended\",exact:true}).check();const recovered=await state();await page.waitForTimeout(500);return{at:new Date().toISOString(),width:${width},first,second,recovered,records,noEndpointSubmitted:true,widths:await page.evaluate(()=>({viewport:innerWidth,document:document.documentElement.scrollWidth}))};\n}finally{await Promise.allSettled(tasks);await page.unroute(\"**/graphql\",handler);}\n}`}",
  "catalogQualification": "Only the selected WebhookEventTypes response entry was replaced for the first two requests per viewport. All real upstream replies were healthy HTTP200 with53 types. Third response and all sibling entries were released unchanged. This is local recovery simulation, not a production outage.",
