    "postgresDialogCode": "async(page)=>{\nawait page.setViewportSize({width:390,height:844});await page.goto(\"about:blank\",{waitUntil:\"commit\"});\nlet release,released=false;const gate=new Promise(r=>release=r),scripts=[],tasks=[];\nconst pattern=\"https://dashboard.bex.co/assets/index-D60ymwlM.js\";\nconst handler=async route=>{const task=(async()=>{const response=await route.fetch();scripts.push({url:route.request().url(),status:response.status(),bytes:(await response.body()).length,delayApplied:!released});await gate;await route.fulfill({response})})();tasks.push(task);await task};\nawait page.route(pattern,handler);\ntry{\n await page.goto(\"https://dashboard.bex.co/?new=database\",{waitUntil:\"commit\"});\n for(let i=0;i<60&&scripts.length===0;i++)await page.waitForTimeout(100);\n if(!scripts.length)throw Error(\"Startup script was not intercepted\");\n await page.waitForTimeout(1200);\n const before={nameInputs:await page.getByRole(\"textbox\",{name:\"Name\",exact:true}).count(),dialogs:await page.getByRole(\"dialog\").count(),main:await page.locator(\"main\").ariaSnapshot()};\n released=true;release();await Promise.allSettled(tasks);\n const n=page.getByRole(\"dialog\",{name:\"New Postgres\",exact:true}).getByRole(\"textbox\",{name:\"Name\",exact:true});await n.waitFor({timeout:15000});\n const ready=await n.evaluate(e=>({enabled:!e.disabled,reactProps:Object.keys(e).some(k=>k.startsWith(\"__reactProps$\"))}));\n await n.click();await page.keyboard.insertText(\"qa-a800-dialog-ready\");await page.waitForTimeout(1500);\n return {at:new Date().toISOString(),url:page.url(),width:390,scripts,before,ready,after:await n.inputValue(),noCreateClicked:true};\n}finally{released=true;release();await Promise.allSettled(tasks);await page.unroute(pattern,handler);}\n}"
  },
