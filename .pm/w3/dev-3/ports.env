# Port assignments for the dev-3 isolated environment (workstream w3).
# Non-secret — safe to commit.
#
# GENERATED RECORD, not the source of truth: scripts/dev-env.sh derives every
# value below from N alone, and scripts/dev-env.test.sh fails if this file and
# that derivation disagree. Before w1/m72 each workstream kept its own copy and
# they drifted — two of them claimed 58000+N*10 for different services, and the
# Hydra issuer in eight of the ten pointed at a port nothing served.
#
#   DASHBOARD_PORT     = 50000 + N*10
#   KRATOS_PUBLIC_PORT = 51000 + N*10
#   HYDRA_ADMIN_PORT   = 52000 + N*10
#   MAILPIT_HTTP_PORT  = 53000 + N*10
#   BEX_API_PORT       = 54000 + N*10
#   BEX_DB_PORT        = 55000 + N*10
#   BEX_CP_PORT        = 56000 + N*10 (bex-api's internal control-plane API)
#   KRATOS_ADMIN_PORT  = 57000 + N*10 (Kratos' admin API — BEX_KRATOS_ADMIN_URL)
#   HYDRA_PUBLIC_PORT  = 58000 + N*10 (Hydra's public issuer — BEX_OAUTH_ISSUER)
#   LOKI_PORT          = 59000 + N*10 (the log store — BEX_LOKI_URL)
#   MAILPIT_SMTP_PORT  = 60000 + N*10 (bex-api's invite mailer — BEX_SMTP_ADDR)
#
# None of these collide with the standard local-dev ports (5173/4433/4445/8090/
# 8091/5432) or with any other workstream's dev-N.

DEV_NS=dev-3
DEV_AUTH_NS=dev-3-auth

DASHBOARD_PORT=50030
KRATOS_PUBLIC_PORT=51030
HYDRA_ADMIN_PORT=52030
MAILPIT_HTTP_PORT=53030
BEX_API_PORT=54030
BEX_DB_PORT=55030
BEX_CP_PORT=56030
KRATOS_ADMIN_PORT=57030
HYDRA_PUBLIC_PORT=58030
LOKI_PORT=59030
MAILPIT_SMTP_PORT=60030
