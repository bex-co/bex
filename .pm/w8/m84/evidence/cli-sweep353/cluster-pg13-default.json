{
  "case": "pg13-default",
  "cluster_spec": {
    "bootstrap": {
      "initdb": {
        "database": "dpg_qa353",
        "owner": "dpg_qa353_user",
        "postInitSQL": [
          "CREATE EXTENSION IF NOT EXISTS pg_stat_statements"
        ]
      }
    },
    "enablePDB": false,
    "imageName": "ghcr.io/cloudnative-pg/postgresql:13@sha256:bd12cfd185d2a5cb09ac51dd7c61cb7801da6250e8d9bd72d2891fcdedace32b",
    "instances": 1,
    "managed": {
      "roles": [
        {
          "ensure": "present",
          "inRoles": [
            "pg_monitor"
          ],
          "login": true,
          "name": "dpg_qa353_user"
        }
      ]
    },
    "postgresql": {
      "parameters": {
        "pg_stat_statements.track": "all"
      },
      "shared_preload_libraries": [
        "pg_stat_statements"
      ]
    },
    "resources": {
      "limits": {
        "cpu": "100m",
        "memory": "256Mi"
      },
      "requests": {
        "cpu": "100m",
        "memory": "256Mi"
      }
    },
    "storage": {
      "size": "1Gi",
      "storageClass": "hcloud-volumes"
    }
  },
  "database": "dpg_qa353",
  "identity_and_reviewed_image_control": true,
  "owner": "dpg_qa353_user",
  "qualification": "unchanged real cluster serializer; no CNPG runtime, new child resource or successful vector install executed; repository-wide caller census is separate",
  "vector_in_cluster_projection": false
}