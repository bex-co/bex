ensor COLLATE \"C\"))::text FROM (SELECT time_bucket(interval '1 hour',observed_at) AS bucket,sensor,count(*) AS n,sum(cents) AS total FROM readings GROUP BY 1,2) q; DELETE FROM readings WHERE id=1; SELECT jsonb_build_object('phase','delete','rows',jsonb_agg(jsonb_build_array(extract(epoch from bucket)::bigint,sensor,n,total) ORDER BY bucket,sensor COLLATE \"C\"))::text FROM (SELECT time_bucket(interval '1 hour',observed_at) AS bucket,sensor,count(*) AS n,sum(cents) AS total FROM readings GROUP BY 1,2) q; ROLLBACK;"
