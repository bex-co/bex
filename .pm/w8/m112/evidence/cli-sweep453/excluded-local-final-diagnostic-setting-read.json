        "-c",
        "BEGIN; SET LOCAL statement_timeout='20s'; SET LOCAL timezone='UTC'; CREATE SCHEMA qa453_local; SET LOCAL search_path=qa453_local,public; CREATE TABLE readings(id integer NOT NULL, observed_at timestamptz NOT NULL,sensor text NOT NULL,cents integer NOT NULL,PRIMARY KEY(observed_at,sensor)); INSERT INTO readings VALUES (1,'1969-12-31T23:59:59.999999+00:00','café:李',1999),(2,'1970-01-01T00:00:00+00:00','north',1250),(3,'1970-01-01T00:59:59.999999+00:00','north',725),(4,'1970-01-01T01:00:00+00:00','north',-499),(5,'1970-01-01T02:30:00+00:00','west',0); SELECT jsonb_build_object('phase','initial','rows',jsonb_agg(jsonb_build_array(extract(epoch from bucket)::bigint,sensor,n,total) ORDER BY bucket,sensor COLLATE \"C\"))::text FROM (SELECT date_bin(interval '1 hour',observed_at,timestamptz '1970-01-01 00:00:00+00') AS bucket,sensor,count(*) AS n,sum(cents) AS total FROM readings GROUP BY 1,2) q; INSERT INTO readings VALUES(6,'1970-01-01T01:30:00+00:00','north',300); SELECT jsonb_build_object('phase','insert','rows',jsonb_agg(jsonb_build_array(extract(epoch from bucket)::bigint,sensor,n,total) ORDER BY bucket,sensor COLLATE \"C\"))::text FROM (SELECT date_bin(interval '1 hour',observed_at,timestamptz '1970-01-01 00:00:00+00') AS bucket,sensor,count(*) AS n,sum(cents) AS total FROM readings GROUP BY 1,2) q; UPDATE readings SET cents=-125 WHERE id=3; SELECT jsonb_build_object('phase','update','rows',jsonb_agg(jsonb_build_array(extract(epoch from bucket)::bigint,sensor,n,total) ORDER BY bucket,sensor COLLATE \"C\"))::text FROM (SELECT date_bin(interval '1 hour',observed_at,timestamptz '1970-01-01 00:00:00+00') AS bucket,sensor,count(*) AS n,sum(cents) AS total FROM readings GROUP BY 1,2) q; DELETE FROM readings WHERE id=1; SELECT jsonb_build_object('phase','delete','rows',jsonb_agg(jsonb_build_array(extract(epoch from bucket)::bigint,sensor,n,total) ORDER BY bucket,sensor COLLATE \"C\"))::text FROM (SELECT date_bin(interval '1 hour',observed_at,timestamptz '1970-01-01 00:00:00+00') AS bucket,sensor,count(*) AS n,sum(cents) AS total FROM readings GROUP BY 1,2) q; ROLLBACK;"
