 def accepted_exit(launch, status):
     return type(status) is int and (status == 0 or (launch != "direct" and status == 143) or (launch == "yarn" and status == 1))
+
+
+
+def stopped_projection(state):
+    """Exactly the fields checked by the original Go stopped-container gate."""
+    return {**{key: state[key] for key in ("ID", "Image", "Running", "ExitCode", "Network")},
+            "owner": state["Labels"]["co.bex.native-qualification"]}
+
+
+def running_port(state):
+    """Docker's raw carrier spells HostIp; no artifact key normalization."""
+    ports = state["Ports"]
+    need(set(ports) == {"10000/tcp"} and len(ports["10000/tcp"]) == 1, "original one-port transport")
+    row = ports["10000/tcp"][0]
+    need(row.get("HostIp") == "127.0.0.1" and isinstance(row.get("HostPort"), str)
+         and re.fullmatch(r"[+-]?[0-9]+", row["HostPort"]) is not None
+         and 1 <= int(row["HostPort"]) <= 65535, "original localhost-only transport")
+    return int(row["HostPort"])
 
 
