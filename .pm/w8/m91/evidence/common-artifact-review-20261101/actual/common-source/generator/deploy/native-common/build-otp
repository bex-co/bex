#!/bin/sh
# Same-release fallback when no exact Bookworm OTP artifact is published.
# Its source checksum comes from the selected immutable official image history.
set -eu
[ "$#" -eq 2 ]
printf '%s\n' "$1" | grep -Eq '^[0-9]+(\.[0-9]+){1,3}$'
printf '%s\n' "$2" | grep -Eq '^[a-f0-9]{64}$'
. /etc/os-release
[ "$VERSION_CODENAME" = bookworm ]
version=$1
checksum=$2
check_version() {
  actual=$(erl -noshell -eval '{ok,B}=file:read_file(filename:join([code:root_dir(),"releases",erlang:system_info(otp_release),"OTP_VERSION"])), io:put_chars(string:trim(binary_to_list(B))), halt(0).')
  [ "$actual" = "$version" ]
}
check_features() {
  /usr/bin/python3 -I /usr/libexec/bex-native/otp-features.py /opt/bex-otp-reference /usr/local/lib/erlang
}
if [ -x /usr/local/bin/erl ]; then
  check_version
  if check_features; then
    echo 'Exact Bookworm OTP donor retains the selected application/NIF/header inventory'
    exit 0
  else
    result=$?
    [ "$result" -eq 1 ] || exit "$result"
  fi
fi
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
curl --proto '=https' --fail --location --retry 3 --connect-timeout 30 \
  --max-time 600 --max-filesize 268435456 \
  "https://github.com/erlang/otp/releases/download/OTP-$version/otp_src_$version.tar.gz" \
  -o "$work/otp.tar.gz"
printf '%s  %s\n' "$checksum" "$work/otp.tar.gz" | sha256sum -c -
mkdir "$work/source"
tar -xzf "$work/otp.tar.gz" -C "$work/source" --strip-components=1
# Avoid merging a reduced provider build with a differently configured one.
# shellcheck disable=SC2114 # This is the isolated common-base runtime builder; tools live outside /usr/local.
rm -rf /usr/local
mkdir -p /usr/local
cd "$work/source"
export ERL_TOP="$PWD"
./otp_build autoconf
./configure --build="$(dpkg-architecture --query DEB_HOST_GNU_TYPE)"
make -j2
make -j2 docs DOC_TARGETS=chunks
make install install-docs DOC_TARGETS=chunks
# Keep the same release identity before the final image copies this tree.
check_version
check_features
