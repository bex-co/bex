or\nimage would ask CNPG for a major upgrade.\n\nt001 also records the read-only production inventory: every tenant\ndatabase is C/C, with no libc collations in use, so moving to the\nbookworm base needs no reindex.","timestamp":"2026-10-31T09:45:30Z","author":{"name":"Tian Pan","email":"puncsky@gmail.com"},"committer":{"name":"Tian Pan","email":"puncsky@gmail.com"}},"repository":{"id":793852040,"node_id":"R_kgDOL1E4iA","name":"bex","full_name":"bex-co/bex","private":false,"owner":{"login":"bex-co","id":79443195,"node_id":"MDEyOk9yZ2FuaXphdGlvbjc5NDQzMTk1","avatar_url":"https://avatars.githubusercontent.com/u/79443195?v=4","gravatar_id":"","url":"https://api.github.com/users/bex-co","html_url":"https://github.com/bex-co","followers_url":"https://api.github.com/users/bex-co/followers","following_url":"https://api.github.com/users/bex-co/following{/other_user}","gists_url":"https://api.github.com/users/bex-co/gists{/gist_id}","starred_url":"https://api.github.com/users/bex-co/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bex-co/subscriptions","organizations_url":"https://api.github.com/users/bex-co/orgs","repos_url":"https://api.github.com/users/bex-co/repos","events_url":"https://api.github.com/users/bex-co/events{/privacy}","received_events_url":"https://api.github.com/users/bex-co/received_events","type":"Organization","user_view_type":"public","site_admin":false},"html_url":"https://github.com/bex-co/bex","description":"The open-source Render alternative — AI-native. Git push → build → deploy on your own infrastructure; agents are first-class users.","fork":false,"url":"https://api.github.com/repos/bex-co/bex","forks_url":"https://api.github.com/repos/bex-co/bex/forks","keys_url":"https://api.github.com/repos/bex-co/bex/keys{/key_id}","collaborators_url":"https://api.github.com/repos/bex-co/bex/collaborators{/collaborator}","teams_url":"https://api.github.com/repos/bex-co/bex/teams","hooks_url":"https://api.github.com/repos/bex-co/bex/h