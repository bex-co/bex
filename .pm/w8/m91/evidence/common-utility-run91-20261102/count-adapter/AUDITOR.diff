 def check(condition, reason):
     if not condition:
         raise AssertionError(reason)
+
+def bootstrap_manifest_rows(retained, bootstrap):
+    # Exact 7ad producer: 355 one-attempt rows, plus two raw files per retry.
+    attempts = bootstrap.get('attempts')
+    check(type(attempts) is list and 1 <= len(attempts) <= 3
+          and bootstrap.get('maximum_attempts') == 3, 'bootstrap attempt count differs')
+    expected = set()
+    for number, attempt in enumerate(attempts, 1):
+        check(type(attempt.get('number')) is int and attempt['number'] == number,
+              'bootstrap attempt numbering differs')
+        for stream in ('stdout', 'stderr'):
+            name = 'bootstrap-' + str(number) + '.' + stream + '.log'
+            descriptor = attempt.get(stream)
+            check(type(descriptor) is dict and descriptor.get('path') == name,
+                  'bootstrap raw path differs')
+            check(name in retained and type(descriptor.get('bytes')) is int
+                  and descriptor['bytes'] >= 0
+                  and descriptor['bytes'] == retained[name]['bytes']
+                  and descriptor.get('sha256') == retained[name]['sha256'],
+                  'bootstrap raw manifest custody differs')
+            expected.add(name)
+    check({name for name in retained if name.startswith('bootstrap-')} == expected,
+          'unexpected or missing bootstrap raw member')
+    return 355 + len(expected) - 2
 
