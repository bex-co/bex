+import copy
+from pathlib import Path
+import tempfile
+import unittest
+import zlib
+
+import check
+
+
+class ProfileControls(unittest.TestCase):
+    def test_unicode_arithmetic_and_native_results(self):
+        for runtime, pure, name, checksum, arithmetic in (
