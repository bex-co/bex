    "build": "set -e\ncat > qa400-app.cjs <<'QA400_QA400_APP_CJS'\nconst fs=require('node:fs'),crypto=require('node:crypto'),http=require('node:http'),zlib=require('node:zlib');\nconst ref=JSON.parse(fs.readFileSync('qa400-reference.json')),marker=fs.readFileSync('qa400-marker','utf8').trim(),phase=process.argv[2],sha=b=>crypto.createHash('sha256').update(b).digest('hex');\nconst files=Object.fromEntries(Object.keys(ref.files).map(p=>{const b=fs.readFileSync(p);return[p,{bytes:b.length,sha256:sha(b)}]}));if(JSON.stringify(files)!==JSON.stringify(ref.files))throw Error('source differs');\nconst snapshot={marker,node:process.version,files,phase};if(phase==='build'){fs.writeFileSync('qa400-build.json',JSON.stringify(snapshot));console.log('QA400_BUILD '+JSON.stringify(snapshot));process.exit(0);}\nconst built=JSON.parse(fs.readFileSync('qa400-build.json')),boot=crypto.randomUUID(),json=(res,status,v)=>{res.writeHead(status,{'Content-Type':'application/json','Cache-Control':'no-store'});res.end(JSON.stringify(v))};\nhttp.createServer((req,res)=>{const path=new URL(req.url,'http://qa.invalid').pathname;\n if(path==='/upload'&&req.method==='POST'){const start=Date.now(),raw=crypto.createHash('sha256'),decoded=crypto.createHash('sha256');let rawBytes=0,bytes=0,chunks=0,first=null;req.on('data',b=>{if(first===null)first=Date.now();rawBytes+=b.length;raw.update(b)});const input=req.headers['content-encoding']==='gzip'?req.pipe(zlib.createGunzip()):req;input.on('data',b=>{bytes+=b.length;chunks++;decoded.update(b)});input.on('error',e=>json(res,400,{marker,error:e.code||'decode'}));input.on('end',()=>{const v={marker,boot,id:req.headers['x-qa-case'],bytes,sha256:decoded.digest('hex'),rawBytes,rawSha256:raw.digest('hex'),encoding:req.headers['content-encoding']||null,length:req.headers['content-length']||null,transfer:req.headers['transfer-encoding']||null,upstream_http:req.httpVersion,chunks,firstMs:first===null?null:first-start,durationMs:Date.now()-start};console.log('QA400_UPLOAD '+JSON.stringify(v));json(res,200,v)});return;}\n json(res,200,{marker,boot,built,runtime:snapshot});\n}).listen(Number(process.env.PORT),'0.0.0.0');\nQA400_QA400_APP_CJS\ncat > qa400-reference.json <<'QA400_QA400_REFERENCE_JSON'\n{\"repo\": \"https://github.com/git-fixtures/basic\", \"branch\": \"master\", \"commit\": \"6ecf0ef2c2dffb796033e5a02219af86ec6584e5\", \"files\": {\"LICENSE\": {\"bytes\": 1072, \"sha256\": \"20b064910b32bce1bc04595a5b20477a28c503995ef8528929a311d6cb7a3b09\"}, \"CHANGELOG\": {\"bytes\": 18, \"sha256\": \"9c65e366055edd9a0f6ab9c7b8a37fc92803cfe1d30ffa727ceed0c63939c2e5\"}}, \"qualification\": \"public Git carrier only; qa400 chunked/gzip upload observer is an explicitly authored functional fixture\"}\nQA400_QA400_REFERENCE_JSON\ncat > qa400-marker <<'QA400_QA400_MARKER'\nQA400_LOCAL\nQA400_QA400_MARKER\nnode qa400-app.cjs build",
    "start": "node qa400-app.cjs runtime",
    "program": "const fs=require('node:fs'),crypto=require('node:crypto'),http=require('node:http'),zlib=require('node:zlib');\nconst ref=JSON.parse(fs.readFileSync('qa400-reference.json')),marker=fs.readFileSync('qa400-marker','utf8').trim(),phase=process.argv[2],sha=b=>crypto.createHash('sha256').update(b).digest('hex');\nconst files=Object.fromEntries(Object.keys(ref.files).map(p=>{const b=fs.readFileSync(p);return[p,{bytes:b.length,sha256:sha(b)}]}));if(JSON.stringify(files)!==JSON.stringify(ref.files))throw Error('source differs');\nconst snapshot={marker,node:process.version,files,phase};if(phase==='build'){fs.writeFileSync('qa400-build.json',JSON.stringify(snapshot));console.log('QA400_BUILD '+JSON.stringify(snapshot));process.exit(0);}\nconst built=JSON.parse(fs.readFileSync('qa400-build.json')),boot=crypto.randomUUID(),json=(res,status,v)=>{res.writeHead(status,{'Content-Type':'application/json','Cache-Control':'no-store'});res.end(JSON.stringify(v))};\nhttp.createServer((req,res)=>{const path=new URL(req.url,'http://qa.invalid').pathname;\n if(path==='/upload'&&req.method==='POST'){const start=Date.now(),raw=crypto.createHash('sha256'),decoded=crypto.createHash('sha256');let rawBytes=0,bytes=0,chunks=0,first=null;req.on('data',b=>{if(first===null)first=Date.now();rawBytes+=b.length;raw.update(b)});const input=req.headers['content-encoding']==='gzip'?req.pipe(zlib.createGunzip()):req;input.on('data',b=>{bytes+=b.length;chunks++;decoded.update(b)});input.on('error',e=>json(res,400,{marker,error:e.code||'decode'}));input.on('end',()=>{const v={marker,boot,id:req.headers['x-qa-case'],bytes,sha256:decoded.digest('hex'),rawBytes,rawSha256:raw.digest('hex'),encoding:req.headers['content-encoding']||null,length:req.headers['content-length']||null,transfer:req.headers['transfer-encoding']||null,upstream_http:req.httpVersion,chunks,firstMs:first===null?null:first-start,durationMs:Date.now()-start};console.log('QA400_UPLOAD '+JSON.stringify(v));json(res,200,v)});return;}\n json(res,200,{marker,boot,built,runtime:snapshot});\n}).listen(Number(process.env.PORT),'0.0.0.0');\n"
