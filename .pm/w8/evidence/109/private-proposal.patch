+// isBexNativeShortRoute excludes a registered native endpoint when the legacy
+// router matches a longer Render template with empty trailing parameters.
+func isBexNativeShortRoute(contract *renderOpenAPIContract, pattern, matchedPath string) bool {
+ _, path, ok := bexPatternPath(pattern)
+ if !ok || strings.Contains(path, "...}") || contract.document.Paths.Find(path) != nil { return false }
+ have, want := strings.Split(strings.Trim(path, "/"), "/"), strings.Split(strings.Trim(matchedPath, "/"), "/")
+ if len(have) >= len(want) { return false }
+ parameter := func(s string) bool { return strings.HasPrefix(s, "{") && strings.HasSuffix(s, "}") }
+ for i, segment := range have { if !parameter(want[i]) && segment != want[i] { return false } }
+ for _, segment := range want[len(have):] { if !parameter(segment) { return false } }
+ return true
+}
