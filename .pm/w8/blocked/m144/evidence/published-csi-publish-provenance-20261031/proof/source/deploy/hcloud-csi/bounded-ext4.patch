diff --git a/internal/volumes/bounded.go b/internal/volumes/bounded.go
new file mode 100644
index 0000000..fdefcc8
--- /dev/null
+++ b/internal/volumes/bounded.go
@@ -0,0 +1,94 @@
+package volumes
+
+import (
+	"context"
+	"encoding/binary"
+	"fmt"
+	"k8s.io/utils/exec"
+	"os"
+	"strconv"
+	"strings"
+)
+
+// ValidateFilesystemBytes bounds the opt-in ext4 contract before any node I/O.
+func ValidateFilesystemBytes(bytes int64) error {
+	if bytes < 1<<30 || bytes > 10000<<30 || bytes%4096 != 0 {
+		return fmt.Errorf("filesystem capacity must be 4KiB-aligned within 1..10000GiB")
+	}
+	return nil
+}
+
+// boundedExt4 works on the unlocked device selected by the trusted CSI node.
+// It never shrinks or reformats an existing filesystem. Empty-device formatting
+// is allowed only when Publish initialized LUKS in that call, never by
+// expansion or a read-only mount.
+func boundedExt4(ctx context.Context, executor exec.Interface, device string, bytes int64, allowFormat, readonly bool) error {
+	if err := ValidateFilesystemBytes(bytes); err != nil {
+		return err
+	}
+	physical, err := blockDeviceBytes(device)
+	if err != nil {
+		return err
+	}
+	// LUKS consumes a header inside the provider volume. Its mapping can be a
+	// little smaller than the logical request once the request reaches the floor.
+	if uint64(bytes) > physical && uint64(bytes)-physical > 16<<20 {
+		return fmt.Errorf("logical capacity exceeds unlocked block device beyond LUKS header overhead")
+	}
+	target := min(uint64(bytes), physical) / 4096 * 4096
+	if target == 0 {
+		return fmt.Errorf("empty block device")
+	}
+	output, inspectErr := executor.CommandContext(ctx, "blkid", "-p", "-s", "TYPE", "-o", "value", device).CombinedOutput()
+	if inspectErr != nil {
+		exit, ok := inspectErr.(exec.ExitError)
+		if !ok || exit.ExitStatus() != 2 || len(output) != 0 || !allowFormat || readonly {
+			return fmt.Errorf("refuse to format uninspectable or non-writable block device: %w", inspectErr)
+		}
+		_, err = executor.CommandContext(ctx, "mkfs.ext4", "-F", "-m0", "-b4096", device, strconv.FormatUint(target/4096, 10)).CombinedOutput()
+		return err
+	}
+	if strings.TrimSpace(string(output)) != "ext4" {
+		return fmt.Errorf("bounded filesystem requires ext4, found %q", output)
+	}
+	f, err := os.Open(device)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	super := make([]byte, 1024)
+	if _, err = f.ReadAt(super, 1024); err != nil {
+		return err
+	}
+	current, err := ext4Bytes(super)
+	if err != nil {
+		return err
+	}
+	if current > target {
+		return fmt.Errorf("refuse filesystem shrink: current=%d target=%d; offline migration required", current, target)
+	}
+	if current == target || readonly {
+		return nil
+	}
+	_, err = executor.CommandContext(ctx, "resize2fs", device, strconv.FormatUint(target/1024, 10)+"K").CombinedOutput()
+	return err
+}
+
+func ext4Bytes(super []byte) (uint64, error) {
+	if len(super) < 1024 || binary.LittleEndian.Uint16(super[56:]) != 0xef53 {
+		return 0, fmt.Errorf("invalid ext4 superblock")
+	}
+	logBlock := binary.LittleEndian.Uint32(super[24:])
+	if logBlock > 6 {
+		return 0, fmt.Errorf("invalid ext4 block size")
+	}
+	blocks := uint64(binary.LittleEndian.Uint32(super[4:]))
+	if binary.LittleEndian.Uint32(super[96:])&0x80 != 0 {
+		blocks |= uint64(binary.LittleEndian.Uint32(super[336:])) << 32
+	}
+	blockSize := uint64(1024) << logBlock
+	if blocks == 0 || blocks > ^uint64(0)/blockSize {
+		return 0, fmt.Errorf("invalid ext4 block count")
+	}
+	return blocks * blockSize, nil
+}
diff --git a/internal/volumes/bounded_kernel_test.go b/internal/volumes/bounded_kernel_test.go
new file mode 100644
index 0000000..715f6c8
--- /dev/null
+++ b/internal/volumes/bounded_kernel_test.go
@@ -0,0 +1,169 @@
+//go:build linux
+
+package volumes
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"errors"
+	"k8s.io/utils/exec"
+	"os"
+	osexec "os/exec"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"testing"
+)
+
+// This deliberately uses a disposable local loop device, never a provider volume.
+// Run only in an explicitly authorized privileged test container.
+func TestBoundedExt4Kernel(t *testing.T) {
+	if os.Getenv("BEX_CSI_KERNEL_TEST") != "1" {
+		t.Skip("privileged disposable-container test")
+	}
+	if _, err := os.Stat("/.dockerenv"); err != nil {
+		t.Fatal("kernel test requires its disposable Docker container")
+	}
+	ctx := context.Background()
+	dir := t.TempDir()
+	image := filepath.Join(dir, "disk.img")
+	mountpoint := filepath.Join(dir, "mount")
+	f, err := os.Create(image)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = f.Truncate(10 << 30); err != nil {
+		t.Fatal(err)
+	}
+	f.Close()
+	run := func(name string, args ...string) string {
+		t.Helper()
+		out, err := osexec.Command(name, args...).CombinedOutput()
+		if err != nil {
+			t.Fatalf("%s %v: %v: %s", name, args, err, out)
+		}
+		return strings.TrimSpace(string(out))
+	}
+	loop := run("losetup", "--find", "--show", image)
+	mapping := "bex-csi-test-" + rand.Text()
+	device := "/dev/mapper/" + mapping
+	mounted := false
+	opened := false
+	t.Cleanup(func() {
+		if mounted {
+			if out, err := osexec.Command("umount", mountpoint).CombinedOutput(); err != nil {
+				t.Errorf("cleanup unmount: %v %s", err, out)
+			}
+		}
+		if opened {
+			if out, err := osexec.Command("cryptsetup", "close", mapping).CombinedOutput(); err != nil {
+				t.Errorf("cleanup mapping: %v %s", err, out)
+			}
+		}
+		if out, err := osexec.Command("losetup", "-d", loop).CombinedOutput(); err != nil {
+			t.Errorf("cleanup loop: %v %s", err, out)
+		}
+	})
+	crypt := func(args ...string) {
+		t.Helper()
+		cmd := osexec.Command("cryptsetup", args...)
+		cmd.Stdin = strings.NewReader("disposable-kernel-test-only")
+		if out, err := cmd.CombinedOutput(); err != nil {
+			t.Fatalf("cryptsetup: %v %s", err, out)
+		}
+	}
+	crypt("luksFormat", "--type", "luks1", "--batch-mode", "--key-file=-", loop)
+	crypt("open", "--key-file=-", loop, mapping)
+	opened = true
+	if err := boundedExt4(ctx, exec.New(), device, 1<<30, true, false); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.Mkdir(mountpoint, 0700); err != nil {
+		t.Fatal(err)
+	}
+	run("mount", device, mountpoint)
+	mounted = true
+	sentinel := []byte("bounded-filesystem-data-preservation\n")
+	sentinelPath := filepath.Join(mountpoint, "sentinel")
+	if err = os.WriteFile(sentinelPath, sentinel, 0600); err != nil {
+		t.Fatal(err)
+	}
+	fullPath := filepath.Join(mountpoint, "full")
+	full, err := os.Create(fullPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	chunk := make([]byte, 1<<20)
+	written := 0
+	fullErr := error(nil)
+	for written < 1100<<20 {
+		n, e := full.Write(chunk)
+		written += n
+		if e != nil {
+			fullErr = e
+			break
+		}
+	}
+	if err = full.Sync(); err != nil && fullErr == nil {
+		fullErr = err
+	}
+	full.Close()
+	if !errors.Is(fullErr, syscall.ENOSPC) || written > 1<<30 {
+		t.Fatalf("cap missing: written=%d error=%v", written, fullErr)
+	}
+	t.Logf("1GiB bounded filesystem returned ENOSPC at %d bytes", written)
+	if err = boundedExt4(ctx, exec.New(), device, 5<<30, false, false); err != nil {
+		t.Fatal(err)
+	}
+	full, err = os.OpenFile(fullPath, os.O_APPEND|os.O_WRONLY, 0600)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = full.Write(bytes.Repeat([]byte("g"), 64<<20)); err != nil {
+		t.Fatal(err)
+	}
+	full.Close()
+	if err = boundedExt4(ctx, exec.New(), device, 1<<30, false, false); err == nil {
+		t.Fatal("accepted shrink")
+	}
+	check := func() {
+		t.Helper()
+		got, e := os.ReadFile(sentinelPath)
+		if e != nil || sha256.Sum256(got) != sha256.Sum256(sentinel) {
+			t.Fatalf("data changed: %v", e)
+		}
+	}
+	check()
+	run("umount", mountpoint)
+	mounted = false
+	run("cryptsetup", "close", mapping)
+	opened = false
+	crypt("open", "--key-file=-", loop, mapping)
+	opened = true
+	run("mount", device, mountpoint)
+	mounted = true
+	check()
+	// Ordinary file-level backup/restore leaves the filesystem boundary intact.
+	archive := filepath.Join(dir, "snapshot.tgz")
+	run("tar", "-czf", archive, "-C", mountpoint, ".")
+	if err = os.Remove(fullPath); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.Remove(sentinelPath); err != nil {
+		t.Fatal(err)
+	}
+	run("tar", "-xzf", archive, "-C", mountpoint)
+	check()
+	if err = boundedExt4(ctx, exec.New(), device, 5<<30, false, true); err != nil {
+		t.Fatal(err)
+	}
+	t.Log("5GiB online grow, retained data, LUKS remount and file-level snapshot restore passed")
+	// The pre-patch resize command is a mutation control: it removes the bound.
+	run("resize2fs", device)
+	if err = boundedExt4(ctx, exec.New(), device, 5<<30, false, false); err == nil {
+		t.Fatal("unbounded resize control was not detected")
+	}
+	t.Log("whole-device resize control detected; no automatic shrink/reformat attempted")
+}
