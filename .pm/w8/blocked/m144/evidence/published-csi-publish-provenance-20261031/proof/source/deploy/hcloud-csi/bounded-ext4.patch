+// Keep mount-utils v0.36.2's fsck policy without its fallback to formatting.
+func (s *LinuxMountService) checkBoundedFilesystem(source string) error {
+	out, err := s.mounter.Exec.Command("fsck", "-a", source).CombinedOutput()
+	if err == nil {
+		return nil
+	}
+	exit, isExitError := err.(exec.ExitError)
+	switch {
+	case err == exec.ErrExecutableNotFound:
+		s.logger.Warn("fsck unavailable; continuing mount", "device", source)
+	case isExitError && exit.ExitStatus() == 1:
+		s.logger.Info("fsck corrected filesystem errors", "device", source)
+	case isExitError && exit.ExitStatus() == 4:
+		return mount.NewMountError(mount.HasFilesystemErrors, "'fsck' found errors on device %s but could not correct them: %s", source, string(out))
+	case isExitError && exit.ExitStatus() > 4:
+		s.logger.Info("fsck error; continuing mount", "device", source, "output", string(out))
+	default:
+		s.logger.Warn("fsck failed; continuing mount", "device", source, "error", err, "output", string(out))
+	}
+	return nil
+}
