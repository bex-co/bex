index 0000000..48f25e4
--- /dev/null
+++ b/internal/volumes/bounded_publish_linux_test.go
@@ -0,0 +1,337 @@
+//go:build linux
+
+package volumes
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	mount "k8s.io/mount-utils"
+	utilexec "k8s.io/utils/exec"
+	testingexec "k8s.io/utils/exec/testing"
+	"log/slog"
+	"os"
+	osexec "os/exec"
+	"path/filepath"
+	"reflect"
+	"regexp"
+	"slices"
+	"strings"
+	"testing"
+)
+
+type failureVolumeState struct {
+	UUID     string
+	Geometry string
+	Sentinel [32]byte
+}
+
+func captureFailureState(t *testing.T, device, mountpoint string) failureVolumeState {
+	t.Helper()
+	readCommand := func(name string, args ...string) string {
+		t.Helper()
+		out, err := osexec.Command(name, args...).CombinedOutput()
+		if err != nil {
+			t.Fatalf("read-only %s: %v: %s", name, err, out)
+		}
+		return strings.TrimSpace(string(out))
+	}
+	uuid := readCommand("blkid", "-s", "UUID", "-o", "value", device)
+	var geometry []string
+	for _, line := range strings.Split(readCommand("dumpe2fs", "-h", device), "\n") {
+		if strings.HasPrefix(line, "Block count:") || strings.HasPrefix(line, "Block size:") {
+			geometry = append(geometry, strings.Join(strings.Fields(line), " "))
+		}
+	}
+	if uuid == "" || len(geometry) != 2 {
+		t.Fatal("independent filesystem identity/geometry unavailable")
+	}
+	data, err := os.ReadFile(filepath.Join(mountpoint, "sentinel"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return failureVolumeState{uuid, strings.Join(geometry, ";"), sha256.Sum256(data)}
+}
+
+type boundedMountFailure struct{ *mount.FakeMounter }
+
+func (m boundedMountFailure) MountSensitive(string, string, string, []string, []string) error {
+	return errors.New("simulated mount failure")
+}
+
+// Reuse the reviewed two-volume owner: only command results and mounts are mocked.
+// No test command formats, resizes, unmounts or edits either healthy filesystem.
+func TestBoundedPublishOwnedTransitions(t *testing.T) {
+	if os.Getenv("BEX_CSI_PUBLISH_FIX_TEST") != "1" {
+		t.Skip("explicitly authorized owned Linux fixture required")
+	}
+	if _, err := os.Stat("/.dockerenv"); err != nil {
+		t.Fatal(err)
+	}
+	nonce := os.Getenv("BEX_CSI_PUBLISH_FIX_NONCE")
+	if !regexp.MustCompile(`^[0-9a-f]{16}$`).MatchString(nonce) {
+		t.Fatal("own nonce required")
+	}
+	mapping := "m144t006-" + nonce + "-a"
+	device := "/dev/mapper/" + mapping
+	var ready struct{ LoopA, MappingA, MappingB string }
+	data, err := os.ReadFile("/proof/ready.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal(data, &ready); err != nil {
+		t.Fatal(err)
+	}
+	if ready.MappingA != mapping || ready.MappingB != "m144t006-"+nonce+"-b" || !regexp.MustCompile(`^/dev/loop[0-9]+$`).MatchString(ready.LoopA) {
+		t.Fatal("owned fixture identity mismatch")
+	}
+	beforeA := captureFailureState(t, device, "/scratch/mount-a")
+	beforeB := captureFailureState(t, "/dev/mapper/"+ready.MappingB, "/scratch/mount-b")
+	outcomes := map[string]bool{}
+	t.Cleanup(func() {
+		a := captureFailureState(t, device, "/scratch/mount-a")
+		b := captureFailureState(t, "/dev/mapper/"+ready.MappingB, "/scratch/mount-b")
+		if a != beforeA || b != beforeB {
+			t.Error("owned A/B geometry, UUID or sentinel changed")
+		}
+		proof := map[string]any{"scope": "Actual healthy own blockdevices; crypto format, inner blkid, fsck, mkfs results and mount are simulated; every real mutation refused", "BeforeA": beforeA, "BeforeB": beforeB, "AfterA": a, "AfterB": b, "AUnchanged": a == beforeA, "BUnchanged": b == beforeB, "cases": outcomes, "TestFailed": t.Failed()}
+		encoded, e := json.MarshalIndent(proof, "", "  ")
+		if e == nil {
+			e = os.WriteFile("/proof/fixed-publish-result.json", append(encoded, '\n'), 0600)
+		}
+		if e != nil {
+			t.Error(e)
+		}
+	})
+	raw := filepath.Join("/scratch", mapping)
+	if err := os.Symlink(ready.LoopA, raw); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if e := os.Remove(raw); e != nil {
+			t.Error(e)
+		}
+	})
+	actual := &mount.SafeFormatAndMount{Exec: utilexec.New()}
+	kind, err := actual.GetDiskFormat(raw)
+	if err != nil || kind != "crypto_LUKS" {
+		t.Fatalf("actual outer=%q err=%v", kind, err)
+	}
+	realCrypt, err := osexec.LookPath("cryptsetup")
+	if err != nil {
+		t.Fatal(err)
+	}
+	realCrypt, err = filepath.Abs(realCrypt)
+	if err != nil || !regexp.MustCompile(`^/[A-Za-z0-9_./-]+$`).MatchString(realCrypt) {
+		t.Fatal("fixed cryptsetup path required")
+	}
+	status, err := osexec.Command(realCrypt, "status", mapping).CombinedOutput()
+	if err != nil {
+		t.Fatalf("actual status: %v %s", err, status)
+	}
+	var backing string
+	for _, line := range strings.Split(string(status), "\n") {
+		f := strings.Fields(line)
+		if len(f) == 2 && f[0] == "device:" {
+			backing = f[1]
+		}
+	}
+	if backing != ready.LoopA {
+		t.Fatal("active own mapping backing differs")
+	}
+	mountinfo, err := os.ReadFile("/proc/self/mountinfo")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var guardMount string
+	for _, line := range strings.Split(string(mountinfo), "\n") {
+		f := strings.Fields(line)
+		if len(f) > 6 && f[4] == "/guard-bin" {
+			guardMount = line
+			break
+		}
+	}
+	f := strings.Fields(guardMount)
+	if len(f) < 6 || !strings.Contains(guardMount, " - tmpfs ") {
+		t.Fatal("own guard tmpfs absent")
+	}
+	flags := "," + f[5] + ","
+	if strings.Contains(flags, ",noexec,") || !strings.Contains(flags, ",nosuid,") || !strings.Contains(flags, ",nodev,") {
+		t.Fatal("guard mount flags differ")
+	}
+	if err := os.WriteFile("/proof/fixed-guard-mountinfo.txt", []byte(guardMount+"\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	outer := func(t *testing.T, blank bool) testingexec.FakeCommandAction {
+		args := []string{"-p", "-s", "TYPE", "-s", "PTTYPE", "-o", "export", raw}
+		if blank {
+			return boundedTestCommand(t, "blkid", args, "", utilexec.CodeExitError{Err: errors.New("simulated command exit"), Code: 2})
+		}
+		return func(name string, got ...string) utilexec.Cmd {
+			if name != "blkid" || !reflect.DeepEqual(got, args) {
+				t.Fatalf("unexpected outer command %s %v", name, got)
+			}
+			return utilexec.New().Command(name, got...)
+		}
+	}
+	inner := func(t *testing.T, blank bool) testingexec.FakeCommandAction {
+		out, e := "ext4\n", error(nil)
+		if blank {
+			out, e = "", utilexec.CodeExitError{Err: errors.New("simulated command exit"), Code: 2}
+		}
+		return boundedTestCommand(t, "blkid", []string{"-p", "-s", "TYPE", "-o", "value", device}, out, e)
+	}
+	fsck := func(t *testing.T, e error) testingexec.FakeCommandAction {
+		return boundedTestCommand(t, "fsck", []string{"-a", device}, "fsck-result", e)
+	}
+	mkfs := func(t *testing.T, e error) testingexec.FakeCommandAction {
