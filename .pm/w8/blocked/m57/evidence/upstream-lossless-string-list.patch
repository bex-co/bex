+					i++
+					continue
+				}
+				inQuotes = false
+			default:
+				current.WriteByte(ch)
+			}
+			continue
+		}
+
+		switch ch {
+		case ',':
+			values = append(values, current.String())
+			current.Reset()
+			quotedField = false
+			fieldStart = true
+		case '"':
+			if !fieldStart {
+				return nil, fmt.Errorf("parse comma-separated list: quote in unquoted field")
