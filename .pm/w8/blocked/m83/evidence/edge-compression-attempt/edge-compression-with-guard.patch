+
+package controller
+
+import (
+	"context"
+	"slices"
+	"strings"
+	"testing"
+
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	"k8s.io/apimachinery/pkg/types"
+	"sigs.k8s.io/controller-runtime/pkg/client/fake"
+
+	networkingv1 "k8s.io/api/networking/v1"
+
+	appv1alpha1 "github.com/bex-co/bex/lego/types/v1alpha1"
+)
+
+// A public web service's route compresses its responses at the edge, as
+// Render's load balancer does (w8/m83): three App-owned Middlewares — the
+// guard's outer phase, Traefik's compress (Brotli then gzip, compressible
+// types only, no event stream) and the guard's inner phase — sit in that
+// order after the access layers and before the WebSocket meter. Unexposing
+// the service removes them with its Ingress.
+func TestWebServiceEdgeCompressionProjection(t *testing.T) {
+	scheme := newIPAllowListScheme()
+	app := appWithAllowList("edge", nil, appv1alpha1.TypeWebService)
+	cl := fake.NewClientBuilder().WithScheme(scheme).WithObjects(app).WithStatusSubresource(&appv1alpha1.App{}).Build()
+	r := &AppReconciler{Client: cl, Scheme: scheme, Mode: ModeKubernetes, BaseDomain: "onbex.co", ClusterIssuer: "letsencrypt-prod"}
+	ctx := context.Background()
+	nn := types.NamespacedName{Name: "edge", Namespace: "default"}
+	middleware := func(name string) (*unstructured.Unstructured, error) {
+		o := &unstructured.Unstructured{}
+		o.SetGroupVersionKind(traefikHTTPMiddlewareGVK)
+		return o, cl.Get(ctx, types.NamespacedName{Name: name, Namespace: "default"}, o)
+	}
+	reconcileTwice(t, r, nn)
+
+	for name, phase := range map[string]string{"edge-compress-outer": "outer", "edge-compress-inner": "inner"} {
+		mw, err := middleware(name)
+		if err != nil {
+			t.Fatalf("%s: %v", name, err)
+		}
+		if got, _, _ := unstructured.NestedString(mw.Object, "spec", "plugin", "bexCompressGuard", "phase"); got != phase {
+			t.Errorf("%s guard phase = %q, want %q", name, got, phase)
+		}
+		if owners := mw.GetOwnerReferences(); len(owners) != 1 || owners[0].Name != "edge" || owners[0].Controller == nil || !*owners[0].Controller {
+			t.Errorf("%s owners = %+v, want the App as controller", name, owners)
+		}
+	}
+	mw, err := middleware("edge-compress")
+	if err != nil {
+		t.Fatalf("compress: %v", err)
+	}
+	encodings, _, _ := unstructured.NestedStringSlice(mw.Object, "spec", "compress", "encodings")
+	contentTypes, _, _ := unstructured.NestedStringSlice(mw.Object, "spec", "compress", "includedContentTypes")
+	if !slices.Equal(encodings, []string{"br", "gzip"}) || !slices.Contains(contentTypes, "text/html") || !slices.Contains(contentTypes, "application/json") ||
+		slices.Contains(contentTypes, "text/event-stream") || slices.ContainsFunc(contentTypes, func(t string) bool { return strings.HasPrefix(t, "image/") && t != "image/svg+xml" }) {
+		t.Errorf("compress spec = encodings %v, types %v", encodings, contentTypes)
+	}
+
+	ing := &networkingv1.Ingress{}
+	if err := cl.Get(ctx, nn, ing); err != nil {
+		t.Fatal(err)
+	}
+	want := "default-edge-compress-outer@kubernetescrd,default-edge-compress@kubernetescrd,default-edge-compress-inner@kubernetescrd,default-edge-ws-egress@kubernetescrd"
+	if got := ing.Annotations[traefikRouterMiddlewaresAnnotation]; got != want {
+		t.Fatalf("router middlewares = %q, want %q", got, want)
+	}
+
+	updateApp(t, cl, nn, func(a *appv1alpha1.App) { a.Spec.Expose = false })
+	reconcileOnce(t, r, nn)
+	for _, name := range []string{"edge-compress-outer", "edge-compress", "edge-compress-inner"} {
+		if _, err := middleware(name); !apierrors.IsNotFound(err) {
+			t.Errorf("%s after unexposing: %v, want removed", name, err)
+		}
+	}
+}
diff --git a/lego/operator/internal/controller/edge_compression_traefik_test.go b/lego/operator/internal/controller/edge_compression_traefik_test.go
new file mode 100644
index 000000000..b5bc8a3be
--- /dev/null
+++ b/lego/operator/internal/controller/edge_compression_traefik_test.go
@@ -0,0 +1,235 @@
+/*
+Copyright 2026.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package controller
+
+import (
+	"bytes"
+	"compress/gzip"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	appv1alpha1 "github.com/bex-co/bex/lego/types/v1alpha1"
+)
+
+// edgeTraefikImage is the Traefik the deployed chart runs (base values: chart
+// 41.0.0 = Traefik v3.7.5).
+const edgeTraefikImage = "traefik:v3.7.5"
+
+// TestEdgeCompressionOnTheDeployedTraefik is w8/m83's actual-proxy gate: the
+// operator's own middleware chain, loaded into the deployed Traefik release
+// with the bexCompressGuard plugin, compresses eligible responses and leaves
+// every neighbor the way an origin wrote it. Opt-in: needs Docker.
+func TestEdgeCompressionOnTheDeployedTraefik(t *testing.T) {
+	if os.Getenv("BEX_TRAEFIK_INTEGRATION") == "" {
+		t.Skip("set BEX_TRAEFIK_INTEGRATION=1 to run the chain on the deployed Traefik release")
+	}
+	text := bytes.Repeat([]byte("bex compression probe line\n"), 12000)
+	authored := gzipBytes(t, text)
+	origin := httptest.NewUnstartedServer(http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {
+		h := rw.Header()
+		switch req.URL.Path {
+		case "/text":
+			h.Set("Content-Type", "text/plain; charset=utf-8")
+		case "/etag":
+			h.Set("Content-Type", "text/plain")
+			h.Set("ETag", `"v1"`)
+		case "/no-transform":
+			h.Set("Content-Type", "text/plain")
+			h.Set("Cache-Control", "no-cache, no-transform")
+			h.Set("ETag", `"v1"`)
+		case "/authored":
+			h.Set("Content-Type", "text/plain")
+			h.Set("Content-Encoding", "gzip")
+			_, _ = rw.Write(authored)
+			return
+		case "/forged":
+			h.Set("Content-Type", "text/plain")
+			h.Set("X-Bex-Compress-Held", "1")
+		case "/events":
+			h.Set("Content-Type", "text/event-stream")
+		case "/png":
+			h.Set("Content-Type", "image/png")
+		case "/range":
+			h.Set("Content-Type", "text/plain")
+			http.ServeContent(rw, req, "probe.txt", time.Time{}, bytes.NewReader(text))
+			return
+		}
+		_, _ = rw.Write(text)
+	}))
+	listener, err := net.Listen("tcp", "0.0.0.0:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	origin.Listener = listener
+	origin.Start()
+	t.Cleanup(origin.Close)
+
+	app := &appv1alpha1.App{}
+	app.Name = "probe"
+	names, specs := edgeCompressionMiddlewares(app)
+	middlewares := map[string]any{}
+	for i, name := range names {
+		middlewares[name] = specs[i]
+	}
+	routing := map[string]any{
+		"routers": map[string]any{"web": map[string]any{"rule": "PathPrefix(`/`)", "service": "origin", "middlewares": names}},
+		"services": map[string]any{"origin": map[string]any{"loadBalancer": map[string]any{"servers": []any{
+			map[string]any{"url": fmt.Sprintf("http://host.docker.internal:%d", listener.Addr().(*net.TCPAddr).Port)}}}}},
+	}
+	if len(middlewares) > 0 {
+		routing["middlewares"] = middlewares
+	}
+	dynamic, _ := json.Marshal(map[string]any{"http": routing})
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "dynamic.yml"), dynamic, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	plugin, err := filepath.Abs("../../../../deploy/gitops/charts/traefik-plugins/compressguard")
+	if err != nil {
+		t.Fatal(err)
+	}
+	port := freePort(t)
+	name := fmt.Sprintf("bex-edge-compress-it-%d", os.Getpid())
+	run := exec.Command("docker", "run", "-d", "--rm", "--name", name, "--add-host", "host.docker.internal:host-gateway",
+		"-p", fmt.Sprintf("%d:8000", port), "-v", dir+":/dynamic:ro",
+		"-v", plugin+":/plugins-local/src/github.com/bex-co/bex-compress-guard:ro", edgeTraefikImage,
+		"--entrypoints.web.address=:8000", "--providers.file.filename=/dynamic/dynamic.yml",
+		"--experimental.abortonpluginfailure=true",
+		"--experimental.localPlugins.bexCompressGuard.moduleName=github.com/bex-co/bex-compress-guard")
+	if out, err := run.CombinedOutput(); err != nil {
+		t.Fatalf("docker run: %v\n%s", err, out)
+	}
+	t.Cleanup(func() { _ = exec.Command("docker", "rm", "-f", name).Run() })
+	base := fmt.Sprintf("http://127.0.0.1:%d", port)
+	waitForRoute(t, name, base+"/text")
+
+	for _, tc := range []struct {
+		name, path, acceptEncoding, rangeHeader string
+		wantStatus                              int
+		wantEncoding, wantETag                  string
+		want                                    []byte
+	}{
+		{name: "Brotli preferred", path: "/text", acceptEncoding: "gzip, br", wantStatus: 200, wantEncoding: "br"},
+		{name: "gzip decodes exactly", path: "/text", acceptEncoding: "gzip", wantStatus: 200, wantEncoding: "gzip", want: text},
+		{name: "no offer is identity", path: "/text", wantStatus: 200, want: text},
+		{name: "refused coding is identity", path: "/text", acceptEncoding: "gzip;q=0, br;q=0", wantStatus: 200, want: text},
+		{name: "strong ETag weakened when compressed", path: "/etag", acceptEncoding: "gzip", wantStatus: 200, wantEncoding: "gzip", wantETag: `W/"v1"`, want: text},
+		{name: "strong ETag kept when not", path: "/etag", wantStatus: 200, wantETag: `"v1"`, want: text},
+		{name: "no-transform untouched", path: "/no-transform", acceptEncoding: "gzip, br", wantStatus: 200, wantETag: `"v1"`, want: text},
+		{name: "authored encoding passes through", path: "/authored", acceptEncoding: "br", wantStatus: 200, wantEncoding: "gzip", want: text},
+		{name: "forged marker is not obeyed", path: "/forged", acceptEncoding: "gzip", wantStatus: 200, wantEncoding: "gzip", want: text},
+		{name: "event stream untouched", path: "/events", acceptEncoding: "gzip, br", wantStatus: 200, want: text},
+		{name: "image untouched", path: "/png", acceptEncoding: "gzip, br", wantStatus: 200, want: text},
+		{name: "range untouched", path: "/range", acceptEncoding: "gzip, br", rangeHeader: "bytes=0-99", wantStatus: 206, want: text[:100]},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			req, _ := http.NewRequest(http.MethodGet, base+tc.path, nil)
+			req.Header.Set("Accept-Encoding", tc.acceptEncoding)
+			if tc.acceptEncoding == "" {
+				req.Header.Del("Accept-Encoding")
+			}
+			if tc.rangeHeader != "" {
+				req.Header.Set("Range", tc.rangeHeader)
+			}
+			resp, err := (&http.Transport{DisableCompression: true}).RoundTrip(req)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer func() { _ = resp.Body.Close() }()
+			body, _ := io.ReadAll(resp.Body)
+			if resp.StatusCode != tc.wantStatus || resp.Header.Get("Content-Encoding") != tc.wantEncoding || resp.Header.Get("ETag") != tc.wantETag {
+				t.Fatalf("got %d encoding %q etag %q, want %d %q %q", resp.StatusCode, resp.Header.Get("Content-Encoding"), resp.Header.Get("ETag"),
+					tc.wantStatus, tc.wantEncoding, tc.wantETag)
+			}
+			for key := range resp.Header {
+				if strings.HasPrefix(strings.ToLower(key), "x-bex-compress") {
+					t.Errorf("guard marker %s reached the client", key)
+				}
+			}
+			if tc.wantEncoding != "" && len(body) >= len(text)/10 {
+				t.Errorf("encoded body is %d bytes for a %d-byte response", len(body), len(text))
+			}
+			if tc.wantEncoding == "gzip" {
+				body = gunzipBytes(t, body)
+			}
+			if tc.want != nil && !bytes.Equal(body, tc.want) {
+				t.Errorf("decoded body differs from what the origin wrote (%d vs %d bytes)", len(body), len(tc.want))
+			}
+		})
+	}
+}
+
+func gzipBytes(t *testing.T, b []byte) []byte {
+	t.Helper()
+	var out bytes.Buffer
+	w := gzip.NewWriter(&out)
+	_, _ = w.Write(b)
+	if err := w.Close(); err != nil {
+		t.Fatal(err)
+	}
+	return out.Bytes()
+}
+
+func gunzipBytes(t *testing.T, b []byte) []byte {
+	t.Helper()
+	r, err := gzip.NewReader(bytes.NewReader(b))
+	if err != nil {
+		t.Fatal(err)
+	}
+	out, err := io.ReadAll(r)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return out
+}
+
+func freePort(t *testing.T) int {
+	t.Helper()
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = l.Close() }()
+	return l.Addr().(*net.TCPAddr).Port
+}
+
+// waitForRoute waits until Traefik serves the router, failing with its log.
+func waitForRoute(t *testing.T, container, url string) {
+	t.Helper()
+	deadline := time.Now().Add(60 * time.Second)
+	for time.Now().Before(deadline) {
+		if resp, err := http.Get(url); err == nil {
+			_ = resp.Body.Close()
+			if resp.StatusCode == http.StatusOK {
+				return
+			}
+		}
+		time.Sleep(500 * time.Millisecond)
+	}
+	logs, _ := exec.Command("docker", "logs", container).CombinedOutput()
+	t.Fatalf("Traefik never routed %s:\n%s", url, logs)
+}
