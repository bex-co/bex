diff --git a/deploy/gitops/charts/traefik-plugins/compressguard/compressguard.go b/deploy/gitops/charts/traefik-plugins/compressguard/compressguard.go
new file mode 100644
index 000000000..ec794caa3
--- /dev/null
+++ b/deploy/gitops/charts/traefik-plugins/compressguard/compressguard.go
@@ -0,0 +1,170 @@
+// Copyright 2026.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// Package compressguard is a Traefik local HTTP middleware that brackets
+// Traefik's own compress middleware on a web service's route (w8/m83).
+// Traefik compresses a response the origin marked Cache-Control: no-transform,
+// and keeps a strong ETag on the encoded body it made; HTTP forbids the first
+// and makes the second a validator two different representations share, so a
+// resumed If-Range download could splice identity bytes onto a compressed
+// prefix. Render's edge does neither.
+//
+// One instance runs inside compress ("inner": it sees the origin's headers
+// first) and one outside it ("outer": it sees what compress did). The inner
+// phase holds a no-transform response back from compress by giving it a
+// placeholder Content-Encoding, which compress never re-encodes, and marks a
+// response the origin sent unencoded. The outer phase removes the placeholder
+// and the marks, and weakens a strong ETag on a response compress encoded. The
+// markers never reach the client, and an origin cannot forge them: the inner
+// phase drops any it sent.
+package bex_compress_guard
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"net"
+	"net/http"
+	"strings"
+)
+
+const (
+	// PhaseInner and PhaseOuter name where an instance sits around compress.
+	PhaseInner = "inner"
+	PhaseOuter = "outer"
+
+	heldHeader    = "X-Bex-Compress-Held"
+	plainHeader   = "X-Bex-Compress-Plain"
+	heldEncoding  = "identity"
+	encodingField = "Content-Encoding"
+)
+
+// Config is the middleware's dynamic configuration.
+type Config struct {
+	Phase string `json:"phase,omitempty"`
+}
+
+// CreateConfig returns the default (invalid until a phase is chosen) config.
+func CreateConfig() *Config { return &Config{} }
+
+type guard struct {
+	next  http.Handler
+	inner bool
+}
+
+// New builds one phase of the guard.
+func New(_ context.Context, next http.Handler, config *Config, _ string) (http.Handler, error) {
+	switch config.Phase {
+	case PhaseInner:
+		return &guard{next: next, inner: true}, nil
+	case PhaseOuter:
+		return &guard{next: next}, nil
+	}
+	return nil, fmt.Errorf("bexCompressGuard: phase must be %q or %q, not %q", PhaseInner, PhaseOuter, config.Phase)
+}
+
+func (g *guard) ServeHTTP(rw http.ResponseWriter, req *http.Request) {
+	g.next.ServeHTTP(&writer{ResponseWriter: rw, inner: g.inner}, req)
+}
+
+// writer applies its phase to the final response header block, once, just
+// before it is written; informational (1xx) responses pass untouched.
+type writer struct {
+	http.ResponseWriter
+	inner bool
+	done  bool
+}
+
+func (w *writer) WriteHeader(code int) {
+	if !w.done && code >= http.StatusOK {
+		w.done = true
+		if w.inner {
+			holdNoTransform(w.Header())
+		} else {
+			releaseHeld(w.Header())
+		}
+	}
+	w.ResponseWriter.WriteHeader(code)
+}
+
+func (w *writer) Write(p []byte) (int, error) {
+	if !w.done {
+		w.WriteHeader(http.StatusOK)
+	}
+	return w.ResponseWriter.Write(p)
+}
+
+// Flush writes the header block as net/http would (an implicit 200) before
+// flushing, so a stream that flushes first still gets its phase applied.
+func (w *writer) Flush() {
+	if !w.done {
+		w.WriteHeader(http.StatusOK)
+	}
+	if flusher, ok := w.ResponseWriter.(http.Flusher); ok {
+		flusher.Flush()
+	}
+}
+
+func (w *writer) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	hijacker, ok := w.ResponseWriter.(http.Hijacker)
+	if !ok {
+		return nil, nil, fmt.Errorf("%T does not support hijacking", w.ResponseWriter)
+	}
+	return hijacker.Hijack()
+}
+
+// Unwrap lets http.ResponseController reach the connection's own writer.
+func (w *writer) Unwrap() http.ResponseWriter { return w.ResponseWriter }
+
+// holdNoTransform is the inner phase.
+func holdNoTransform(h http.Header) {
+	h.Del(heldHeader)
+	h.Del(plainHeader)
+	if h.Get(encodingField) != "" {
+		return
+	}
+	h.Set(plainHeader, "1")
+	if noTransform(h) {
+		h.Set(encodingField, heldEncoding)
+		h.Set(heldHeader, "1")
+	}
+}
+
+// releaseHeld is the outer phase.
+func releaseHeld(h http.Header) {
+	held, plain := h.Get(heldHeader) != "", h.Get(plainHeader) != ""
+	h.Del(heldHeader)
+	h.Del(plainHeader)
+	switch {
+	case held:
+		if h.Get(encodingField) == heldEncoding {
+			h.Del(encodingField)
+		}
+	case plain && h.Get(encodingField) != "":
+		if etag := h.Get("ETag"); etag != "" && !strings.HasPrefix(etag, "W/") {
+			h.Set("ETag", "W/"+etag)
+		}
+	}
+}
+
+func noTransform(h http.Header) bool {
+	for _, value := range h.Values("Cache-Control") {
+		for _, directive := range strings.Split(value, ",") {
+			if strings.EqualFold(strings.TrimSpace(directive), "no-transform") {
+				return true
+			}
+		}
+	}
+	return false
+}
diff --git a/deploy/gitops/charts/traefik-plugins/compressguard/compressguard_test.go b/deploy/gitops/charts/traefik-plugins/compressguard/compressguard_test.go
new file mode 100644
index 000000000..aa695a265
--- /dev/null
+++ b/deploy/gitops/charts/traefik-plugins/compressguard/compressguard_test.go
@@ -0,0 +1,159 @@
+// Copyright 2026.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package bex_compress_guard
+
+import (
+	"bufio"
+	"context"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+// fakeCompress stands in for Traefik's compress: it encodes a 200 the way
+// compress does, unless the response already carries a Content-Encoding.
+func fakeCompress(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {
+		next.ServeHTTP(&fakeCompressWriter{ResponseWriter: rw}, req)
+	})
+}
+
+type fakeCompressWriter struct{ http.ResponseWriter }
+
+func (w *fakeCompressWriter) WriteHeader(code int) {
+	if code == http.StatusOK && w.Header().Get("Content-Encoding") == "" {
+		w.Header().Set("Content-Encoding", "br")
+		w.Header().Del("Content-Length")
+	}
+	w.ResponseWriter.WriteHeader(code)
+}
+
+func (w *fakeCompressWriter) Flush() { w.ResponseWriter.(http.Flusher).Flush() }
+
+func chain(t *testing.T, origin http.HandlerFunc) http.Handler {
+	t.Helper()
+	inner, err := New(context.Background(), origin, &Config{Phase: PhaseInner}, "inner")
+	if err != nil {
+		t.Fatal(err)
+	}
+	outer, err := New(context.Background(), fakeCompress(inner), &Config{Phase: PhaseOuter}, "outer")
+	if err != nil {
+		t.Fatal(err)
+	}
+	return outer
+}
+
+func serve(t *testing.T, origin http.HandlerFunc) *httptest.ResponseRecorder {
+	t.Helper()
+	rec := httptest.NewRecorder()
+	chain(t, origin).ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
+	return rec
+}
+
+func TestGuardPhases(t *testing.T) {
+	for _, tc := range []struct {
+		name               string
+		headers            map[string]string
+		wantEncoding, etag string
+	}{
+		{"plain response is compressed and its strong ETag weakened", map[string]string{"ETag": `"v1"`}, "br", `W/"v1"`},
+		{"weak ETag is kept", map[string]string{"ETag": `W/"v1"`}, "br", `W/"v1"`},
+		{"no-transform is held back with its ETag", map[string]string{"Cache-Control": "public, No-Transform", "ETag": `"v1"`}, "", `"v1"`},
+		{"authored encoding is the origin's", map[string]string{"Content-Encoding": "gzip", "ETag": `"v1"`}, "gzip", `"v1"`},
+		{"forged markers are ignored", map[string]string{heldHeader: "1", plainHeader: "1", "ETag": `"v1"`}, "br", `W/"v1"`},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			rec := serve(t, func(rw http.ResponseWriter, _ *http.Request) {
+				for k, v := range tc.headers {
+					rw.Header().Set(k, v)
+				}
+				_, _ = rw.Write([]byte("body"))
+			})
+			if got := rec.Header().Get("Content-Encoding"); got != tc.wantEncoding {
+				t.Errorf("Content-Encoding = %q, want %q", got, tc.wantEncoding)
+			}
+			if got := rec.Header().Get("ETag"); got != tc.etag {
+				t.Errorf("ETag = %q, want %q", got, tc.etag)
+			}
+			if rec.Header().Get(heldHeader) != "" || rec.Header().Get(plainHeader) != "" {
+				t.Errorf("markers reached the client: %v", rec.Header())
+			}
+			if rec.Body.String() != "body" {
+				t.Errorf("body = %q", rec.Body.String())
+			}
+		})
+	}
+}
+
+// A stream that flushes before writing still gets its phases applied, and an
+// informational response passes untouched ahead of the final one.
+func TestGuardFlushFirstAndInformational(t *testing.T) {
+	rec := serve(t, func(rw http.ResponseWriter, _ *http.Request) {
+		rw.Header().Set("Cache-Control", "no-transform")
+		rw.(http.Flusher).Flush()
+		_, _ = rw.Write([]byte("event"))
+	})
+	if rec.Header().Get("Content-Encoding") != "" || rec.Header().Get(heldHeader) != "" {
+		t.Errorf("flush-first no-transform stream headers = %v", rec.Header())
+	}
+	rec = serve(t, func(rw http.ResponseWriter, _ *http.Request) {
+		rw.Header().Set("Link", "</app.css>; rel=preload")
+		rw.WriteHeader(http.StatusEarlyHints)
+		rw.Header().Set("ETag", `"v2"`)
+		rw.WriteHeader(http.StatusOK)
+	})
+	// The recorder keeps the first status it saw (103); the final header block
+	// is what the phases must have treated.
+	if rec.Header().Get("ETag") != `W/"v2"` || rec.Header().Get(plainHeader) != "" {
+		t.Errorf("after early hints: %v", rec.Header())
+	}
+}
+
+type hijackRecorder struct {
+	*httptest.ResponseRecorder
+	hijacked bool
+}
+
+func (h *hijackRecorder) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	h.hijacked = true
+	return nil, nil, nil
+}
+
+func TestGuardPassesHijack(t *testing.T) {
+	for _, phase := range []string{PhaseInner, PhaseOuter} {
+		g, err := New(context.Background(), http.HandlerFunc(func(rw http.ResponseWriter, _ *http.Request) {
+			if _, _, err := rw.(http.Hijacker).Hijack(); err != nil {
+				t.Errorf("%s hijack: %v", phase, err)
+			}
+		}), &Config{Phase: phase}, phase)
+		if err != nil {
+			t.Fatal(err)
+		}
+		rec := &hijackRecorder{ResponseRecorder: httptest.NewRecorder()}
+		g.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/ws", nil))
+		if !rec.hijacked {
+			t.Errorf("%s phase did not reach the connection's hijacker", phase)
+		}
+	}
+}
+
+func TestNewRefusesAnUnknownPhase(t *testing.T) {
+	for _, phase := range []string{"", "middle"} {
+		if _, err := New(context.Background(), http.NotFoundHandler(), &Config{Phase: phase}, "x"); err == nil {
+			t.Errorf("phase %q accepted", phase)
+		}
+	}
+}
