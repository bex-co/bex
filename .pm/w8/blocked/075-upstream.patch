+// WithoutFieldsUnsupportedBy returns s with every type-specific field that
+// serviceType does not accept cleared. Cloning applies it to the source's
+// defaults, so a source of another type does not pass on fields the requested
+// type would refuse; flags the caller set are not filtered and still fail
+// validation.
+func (s ServiceCreateInput) WithoutFieldsUnsupportedBy(serviceType ServiceType) ServiceCreateInput {
+	for _, f := range s.typeSpecificFields() {
+		if !slices.Contains(f.allowed, serviceType) {
+			f.clear(&s)
 		}
 	}
+	return s
+}
+
+type typeSpecificField struct {
+	flag    string
+	allowed []ServiceType
+	set     bool
+	clear   func(*ServiceCreateInput)
+}
 
