+package service
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/render-oss/cli/pkg/client"
+	"github.com/render-oss/cli/pkg/pointers"
+	types "github.com/render-oss/cli/pkg/types"
+	servicetypes "github.com/render-oss/cli/pkg/types/service"
+)
+
+// Cloning into a different service type must not carry over source settings
+// the requested type does not accept: they are defaults the caller never set,
+// so validation must not refuse the clone because of them.
+func TestServiceFromAPIAcrossServiceTypes(t *testing.T) {
+	staticSource := func() *client.Service {
+		return &client.Service{
+			Type:           client.StaticSite,
+			Repo:           pointers.From("https://github.com/org/site"),
+			Branch:         pointers.From("main"),
+			RootDir:        "site",
+			ServiceDetails: mustStaticSiteDetails(t, "", "."),
+		}
+	}
+	webSource := func() *client.Service {
+		var envSpecific client.EnvSpecificDetails
+		require.NoError(t, envSpecific.FromNativeEnvironmentDetails(client.NativeEnvironmentDetails{
+			BuildCommand: "go build -o app .", StartCommand: "./app",
+		}))
+		return &client.Service{
+			Type:    client.WebService,
+			Repo:    pointers.From("https://github.com/org/app"),
+			Branch:  pointers.From("main"),
+			RootDir: "app",
+			ServiceDetails: mustWebServiceDetailsExtended(t, client.WebServiceDetails{
+				Runtime:                 client.ServiceRuntimeGo,
+				Region:                  client.Frankfurt,
+				Plan:                    client.PlanFree,
+				HealthCheckPath:         "/",
+				NumInstances:            1,
+				MaxShutdownDelaySeconds: pointers.From(30),
+				MaintenanceMode:         &client.MaintenanceMode{Enabled: false, Uri: ""},
+				EnvSpecificDetails:      envSpecific,
+			}),
+		}
+	}
+	// Compute targets as a user would request them: type, runtime and commands.
+	target := func(serviceType servicetypes.ServiceType) servicetypes.ServiceCreateInput {
+		region := types.RegionFrankfurt
+		input := servicetypes.ServiceCreateInput{
+			Name: "clone", From: pointers.From("srv-source"), Type: pointers.From(serviceType),
+			Runtime: pointers.From(servicetypes.ServiceRuntimeGo), Region: &region, Plan: pointers.From("free"),
+			BuildCommand: pointers.From("go build -o app ."),
+		}
+		if serviceType == servicetypes.ServiceTypeCronJob {
+			input.CronCommand = pointers.From("./app")
+			input.CronSchedule = pointers.From("0 0 1 1 *")
+		} else {
+			input.StartCommand = pointers.From("./app")
+		}
+		return input
+	}
+	validate := func(input servicetypes.ServiceCreateInput) error {
+		_, err := servicetypes.NormalizeAndValidateCreateInput(servicetypes.NormalizeServiceCreateCLIInput(input), false)
+		return err
+	}
+
+	for _, serviceType := range []servicetypes.ServiceType{
+		servicetypes.ServiceTypeWebService, servicetypes.ServiceTypePrivateService,
+		servicetypes.ServiceTypeBackgroundWorker, servicetypes.ServiceTypeCronJob,
+	} {
+		t.Run("static to "+string(serviceType), func(t *testing.T) {
+			input := target(serviceType)
+			ServiceFromAPI(&input, staticSource())
+			require.Nil(t, input.PublishDirectory)
+			require.Equal(t, "https://github.com/org/site", *input.Repo)
+			require.NoError(t, validate(input))
+			_, err := BuildCreateRequest(input, "tea-test")
+			require.NoError(t, err)
+
+			explicit := target(serviceType)
+			explicit.PublishDirectory = pointers.From("dist")
+			ServiceFromAPI(&explicit, staticSource())
+			require.ErrorContains(t, validate(explicit), "--publish-directory is not supported")
+		})
+	}
+
+	t.Run("web to cron", func(t *testing.T) {
+		input := target(servicetypes.ServiceTypeCronJob)
+		ServiceFromAPI(&input, webSource())
+		require.Nil(t, input.HealthCheckPath)
+		require.Nil(t, input.StartCommand)
+		require.Nil(t, input.NumInstances)
+		require.Nil(t, input.MaxShutdownDelay)
+		require.Nil(t, input.MaintenanceMode)
+		require.Nil(t, input.MaintenanceModeURI)
+		require.NoError(t, validate(input))
+
+		explicit := target(servicetypes.ServiceTypeCronJob)
+		explicit.HealthCheckPath = pointers.From("/healthz")
+		ServiceFromAPI(&explicit, webSource())
+		require.ErrorContains(t, validate(explicit), "--health-check-path is not supported")
+	})
+
+	for _, serviceType := range []servicetypes.ServiceType{servicetypes.ServiceTypePrivateService, servicetypes.ServiceTypeBackgroundWorker} {
+		t.Run("web to "+string(serviceType), func(t *testing.T) {
+			input := target(serviceType)
+			ServiceFromAPI(&input, webSource())
+			require.Nil(t, input.HealthCheckPath)
+			require.Nil(t, input.MaintenanceMode)
+			require.Equal(t, 1, *input.NumInstances)
+			require.Equal(t, 30, *input.MaxShutdownDelay)
+			require.NoError(t, validate(input))
+		})
+	}
+
+	t.Run("same type keeps type-specific settings", func(t *testing.T) {
+		web := servicetypes.ServiceCreateInput{Name: "clone", From: pointers.From("srv-source")}
+		ServiceFromAPI(&web, webSource())
+		require.Equal(t, "/", *web.HealthCheckPath)
+		require.Equal(t, "./app", *web.StartCommand)
+		require.Equal(t, 1, *web.NumInstances)
+		require.Equal(t, 30, *web.MaxShutdownDelay)
+		require.False(t, *web.MaintenanceMode)
+		require.NoError(t, validate(web))
+
+		static := servicetypes.ServiceCreateInput{Name: "clone", From: pointers.From("srv-source")}
+		ServiceFromAPI(&static, staticSource())
+		require.Equal(t, ".", *static.PublishDirectory)
+		require.NoError(t, validate(static))
+	})
+}
