diff -ru a/projects/github-runner/dind-entrypoint.sh b/projects/github-runner/dind-entrypoint.sh
--- a/projects/github-runner/dind-entrypoint.sh	2026-10-18 18:02:38
+++ b/projects/github-runner/dind-entrypoint.sh	2026-10-18 18:02:39
@@ -25,6 +25,21 @@
 rm -f /var/run/docker.sock /var/run/docker.pid
 rm -rf /var/run/docker/containerd
 
+# cgroup v2 nesting, as docker:dind's own entrypoint does. The runner's
+# processes sit in the root of this container's cgroup namespace, and a cgroup
+# that holds processes cannot delegate domain controllers to children. Without
+# this, dockerd's "docker" cgroup ends up threaded and every container started
+# with --memory or --cpus fails: "cannot enter cgroupv2 /sys/fs/cgroup/docker
+# with domain controllers -- it is in threaded mode" (bex w8/122). Move them to
+# an "init" child, then enable every controller for the subtree.
+if [ -f /sys/fs/cgroup/cgroup.controllers ]; then
+    mkdir -p /sys/fs/cgroup/init
+    # A process that exits mid-move (the xargs itself) is not an error.
+    xargs -rn1 < /sys/fs/cgroup/cgroup.procs > /sys/fs/cgroup/init/cgroup.procs 2>/dev/null || :
+    sed -e 's/ / +/g' -e 's/^/+/' < /sys/fs/cgroup/cgroup.controllers \
+        > /sys/fs/cgroup/cgroup.subtree_control
+fi
+
 echo "Starting isolated Docker Engine..."
 # Storage driver: native overlay2 on the volume-backed /var/lib/docker. Compose
 # mounts /var/lib/docker as a volume, so the data-root is NOT itself an overlay
diff -ru a/projects/github-runner/runner-config.test.sh b/projects/github-runner/runner-config.test.sh
--- a/projects/github-runner/runner-config.test.sh	2026-10-18 18:02:39
+++ b/projects/github-runner/runner-config.test.sh	2026-10-18 18:02:39
@@ -120,6 +120,10 @@
 grep -Fq 'YQ_VERSION="4.53.6"' "${SCRIPT_DIR}/Dockerfile"
 grep -Fq 'HELM_VERSION="3.21.4"' "${SCRIPT_DIR}/Dockerfile"
 grep -Fq 'dockerd --host=unix:///var/run/docker.sock --storage-driver=overlay2' "${SCRIPT_DIR}/dind-entrypoint.sh"
+grep -Fq '> /sys/fs/cgroup/init/cgroup.procs' "${SCRIPT_DIR}/dind-entrypoint.sh"
+grep -Fq '> /sys/fs/cgroup/cgroup.subtree_control' "${SCRIPT_DIR}/dind-entrypoint.sh"
+test "$(grep -n 'cgroup.subtree_control' "${SCRIPT_DIR}/dind-entrypoint.sh" | tail -1 | cut -d: -f1)" \
+  -lt "$(grep -n '^dockerd ' "${SCRIPT_DIR}/dind-entrypoint.sh" | cut -d: -f1)"
 grep -Fq 'setpriv --reuid=docker' "${SCRIPT_DIR}/dind-entrypoint.sh"
 grep -Fq 'env HOME=/home/docker USER=docker LOGNAME=docker' "${SCRIPT_DIR}/dind-entrypoint.sh"
 
