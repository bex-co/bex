+	{name: "whitespace", connectionInfo: connectionInfoJSON(" \t\n ")},
+	{name: "missing key", connectionInfo: `{"password":"` + testPostgresPassword + `","internalConnectionString":"postgresql://internal/db","psqlCommand":"psql"}`},
+}
