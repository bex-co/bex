{
  "kind": "isolated cached official PG17 SQL-only pg_partman reference; not Bex/CNPG image acceptance",
  "steps": [
    {
      "label": "start-own-networkless-PG17",
      "command": [
        "docker",
        "run",
        "-d",
        "--pull",
        "never",
        "--network",
        "none",
        "--name",
        "qa428-partman-d61881df",
        "-e",
        "POSTGRES_HOST_AUTH_METHOD=trust",
        "postgres@sha256:67f41722b7a8cbdb868a44a4995c846eddfdc2973bccb291ce937dce88ad5675"
      ],
      "exit": 0,
      "stdout": "0e4abc66148992325cb358a20d18d7358098704d4ba246bbc55ce50056ee2a42\n",
      "stderr": ""
    },
    {
      "label": "own-unix-readiness-0",
      "command": [
        "docker",
        "exec",
        "qa428-partman-d61881df",
        "pg_isready",
        "-U",
        "postgres"
      ],
      "exit": 2,
      "stdout": "/var/run/postgresql:5432 - no response\n",
      "stderr": ""
    },
    {
      "label": "own-unix-readiness-1",
      "command": [
        "docker",
        "exec",
        "qa428-partman-d61881df",
        "pg_isready",
        "-U",
        "postgres"
      ],
      "exit": 0,
      "stdout": "/var/run/postgresql:5432 - accepting connections\n",
      "stderr": ""
    },
    {
      "label": "create-own-ordinary-app-role",
      "command": [
        "docker",
        "exec",
        "qa428-partman-d61881df",
        "psql",
        "-U",
        "postgres",
        "-d",
        "postgres",
        "-X",
        "-q",
        "-t",
        "-A",
        "-v",
        "ON_ERROR_STOP=1",
        "-c",
        "CREATE ROLE qa428_app LOGIN;"
      ],
      "exit": 0,
      "stdout": "",
      "stderr": ""
    },
    {
      "label": "create-own-app-database",
      "command": [
        "docker",
        "exec",
        "qa428-partman-d61881df",
        "createdb",
        "-U",
        "postgres",
        "-O",
        "qa428_app",
        "qa428_db"
      ],
      "exit": 0,
      "stdout": "",
      "stderr": ""
    },
    {
      "label": "original-missing-package",
      "command": [
        "docker",
        "exec",
        "qa428-partman-d61881df",
        "psql",
        "-U",
        "qa428_app",
        "-d",
        "qa428_db",
        "-X",
        "-q",
        "-t",
        "-A",
        "-v",
        "ON_ERROR_STOP=1",
        "-c",
        "CREATE SCHEMA partman; CREATE EXTENSION pg_partman SCHEMA partman;"
      ],
      "exit": 1,
      "stdout": "",
      "stderr": "ERROR:  extension \"pg_partman\" is not available\nDETAIL:  Could not open extension control file \"/usr/share/postgresql/17/extension/pg_partman.control\": No such file or directory.\nHINT:  The extension must first be installed on the system where PostgreSQL is running.\n"
    },
    {
      "label": "copy-control-only-to-own-container",
      "command": [
        "docker",
        "cp",
        "<owned-temp>/sweep428-local-partman-source/pg_partman.control",
        "qa428-partman-d61881df:/usr/share/postgresql/17/extension/pg_partman.control"
      ],
      "exit": 0,
      "stdout": "",
      "stderr": ""
    },
    {
      "label": "copy-actual-assembled-extension-SQL",
      "command": [
        "docker",
        "cp",
        "<owned-temp>/sweep428-local-partman-source/pg_partman--5.5.0.sql",
        "qa428-partman-d61881df:/usr/share/postgresql/17/extension/pg_partman--5.5.0.sql"
      ],
      "exit": 0,
      "stdout": "",
      "stderr": ""
    },
    {
      "label": "install-as-own-ordinary-app",
      "command": [
        "docker",
        "exec",
        "qa428-partman-d61881df",
        "psql",
        "-U",
        "qa428_app",
        "-d",
        "qa428_db",
        "-X",
        "-q",
        "-t",
        "-A",
        "-v",
        "ON_ERROR_STOP=1",
        "-c",
        "CREATE EXTENSION pg_partman SCHEMA partman;"
      ],
      "exit": 1,
      "stdout": "",
      "stderr": "ERROR:  schema \"partman\" does not exist\n"
    },
    {
      "label": "remove-exact-own-container",
      "command": [
        "docker",
        "rm",
        "-f",
        "-v",
        "qa428-partman-d61881df"
      ],
      "exit": 0,
      "stdout": "qa428-partman-d61881df\n",
      "stderr": ""
    },
    {
      "label": "confirm-own-container-absent",
      "command": [
        "docker",
        "container",
        "inspect",
        "qa428-partman-d61881df"
      ],
      "exit": 1,
      "stdout": "[]\n",
      "stderr": "Error response from daemon: No such container: qa428-partman-d61881df\n"
    }
  ],
  "image": "postgres@sha256:67f41722b7a8cbdb868a44a4995c846eddfdc2973bccb291ce937dce88ad5675",
  "container_name": "qa428-partman-d61881df",
  "network": "none; no ports, mounts or other resources",
  "SQL_only_NO_BGW_equivalent_assembly": {
    "official_Makefile_rule": "cat sql/types/*.sql sql/tables/*.sql sql/functions/*.sql sql/procedures/*.sql > sql/pg_partman--5.5.0.sql",
    "files": 45,
    "bytes": 337504,
    "sha256": "cad8133d1fb19c67c448b7fdd117e063b5be2d480ef37bae1a0c9c275f669229",
    "control_superuser_false": true,
    "compiled_BG_worker": false
  },
  "own_container_removed": true
}
