# Port assignments for the dev-6 isolated environment (workstream w6's
# dedicated local dev stack). Non-secret — safe to commit. Every dev-N
# environment (N=1..9, one per workstream, .pm/w$N/dev-$N) uses the same
# derivation so they never collide with each other or with the standard
# local-dev ports (5173/4433/4445/8090/8091/5432):
#   DASHBOARD_PORT     = 50000 + N*10
#   KRATOS_PUBLIC_PORT = 51000 + N*10
#   HYDRA_ADMIN_PORT   = 52000 + N*10
#   MAILPIT_HTTP_PORT  = 53000 + N*10
#   BEX_API_PORT       = 54000 + N*10
#   BEX_DB_PORT        = 55000 + N*10
#   BEX_CP_PORT        = 56000 + N*10 (bex-api's internal control-plane API,
#                        BEX_CP_ADDR — defaults to a fixed :8091 regardless of
#                        BEX_API_ADDR, so every worker needs its own)
# Sourced by up.sh/down.sh/status.sh; also what this directory's values/*.yaml hardcode
# (Helm values aren't dynamic, so if you change a port here, update the
# matching values file too).

DEV_NS=dev-6
DEV_AUTH_NS=dev-6-auth

DASHBOARD_PORT=50060
KRATOS_PUBLIC_PORT=51060
HYDRA_ADMIN_PORT=52060
MAILPIT_HTTP_PORT=53060
BEX_API_PORT=54060
BEX_DB_PORT=55060
BEX_CP_PORT=56060
