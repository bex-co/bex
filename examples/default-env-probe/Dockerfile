# The Docker source of w32/m425's capture: Render passes a service's
# environment to a Docker build as build args, which a Dockerfile sees only
# for the names it declares. This one declares every name probe.sh prints, so
# the build log shows which defaults arrive as build args and the runtime log
# shows the container's environment.
FROM busybox:1.37.0@sha256:bdf57e528e45e4433820e045b29b4597825a1c9e38353532d90a01445013f82e
ARG IS_PULL_REQUEST
ARG RENDER
ARG RENDER_CPU_COUNT
ARG RENDER_DISCOVERY_SERVICE
ARG RENDER_EXTERNAL_HOSTNAME
ARG RENDER_EXTERNAL_URL
ARG RENDER_GIT_BRANCH
ARG RENDER_GIT_COMMIT
ARG RENDER_GIT_REPO_SLUG
ARG RENDER_INSTANCE_ID
ARG RENDER_SERVICE_ID
ARG RENDER_SERVICE_NAME
ARG RENDER_SERVICE_TYPE
ARG RENDER_WEB_CONCURRENCY
ARG WEB_CONCURRENCY
ARG PORT
ARG MIX_ENV
ARG RELEASE_DISTRIBUTION
ARG GO111MODULE
ARG GOPATH
ARG NODE_ENV
ARG NODE_MODULES_CACHE
ARG CI
ARG FORWARDED_ALLOW_IPS
ARG GUNICORN_CMD_ARGS
ARG PIPENV_YES
ARG VENV_ROOT
ARG BUNDLE_APP_CONFIG
ARG BUNDLE_BIN
ARG BUNDLE_DEPLOYMENT
ARG BUNDLE_PATH
ARG GEM_PATH
ARG MALLOC_ARENA_MAX
ARG PASSENGER_ENGINE
ARG PASSENGER_ENVIRONMENT
ARG PASSENGER_PORT
ARG PIDFILE
ARG RAILS_ENV
ARG RAILS_SERVE_STATIC_FILES
ARG RAILS_LOG_TO_STDOUT
ARG CARGO_HOME
ARG ROCKET_ENV
ARG ROCKET_PORT
ARG RUSTUP_HOME
ARG XDG_CACHE_HOME
COPY probe.sh /probe.sh
RUN sh /probe.sh build && mkdir -p /www && echo ok > /www/index.html
CMD ["sh", "-c", "sh /probe.sh runtime && exec httpd -f -p \"${PORT:-10000}\" -h /www"]
