# Port assignments for the dev-alpha isolated environment. Non-secret — safe to
# commit. Chosen to avoid the standard local-dev ports (5173/4433/4445/8090)
# so dev-alpha can run alongside another concurrent session using those.
# Sourced by up.sh/down.sh/status.sh; also what env/dev-alpha/values/*.yaml
# hardcode (Helm values aren't dynamic, so if you change a port here, update
# the matching values file too).

DEV_ALPHA_NS=dev-alpha
DEV_ALPHA_AUTH_NS=dev-alpha-auth

DASHBOARD_PORT=5273
KRATOS_PUBLIC_PORT=15433
HYDRA_ADMIN_PORT=15445
MAILPIT_HTTP_PORT=15825
BEX_API_PORT=18095
BEX_DB_PORT=25432
