# Port assignments for the dev-beta isolated environment. Non-secret — safe to
# commit. Chosen to avoid the standard local-dev ports (5173/4433/4445/8090)
# so dev-beta can run alongside another concurrent session using those.
# Sourced by up.sh/down.sh/status.sh; also what env/dev-beta/values/*.yaml
# hardcode (Helm values aren't dynamic, so if you change a port here, update
# the matching values file too).

DEV_BETA_NS=dev-beta
DEV_BETA_AUTH_NS=dev-beta-auth

DASHBOARD_PORT=5373
KRATOS_PUBLIC_PORT=25433
HYDRA_ADMIN_PORT=25445
MAILPIT_HTTP_PORT=25825
BEX_API_PORT=28095
BEX_DB_PORT=35432
# BEX_CP_ADDR (bex-api's internal control-plane API — the apps-rows->App-CR
# projector) defaults to a fixed :8091 regardless of BEX_API_ADDR; two local
# bex-api instances (dev-alpha + dev-beta) collide there unless each sets its
# own. Not exposed outside the host process; no port-forward needed.
BEX_CP_PORT=28091
