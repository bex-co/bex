# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Hetzner Cloud API token (Terraform provisions infra) ---
HCLOUD_TOKEN=

# --- SSH key for the infra node (give the FILE PATHS, not the key material) ---
# Create once:  ssh-keygen -t ed25519 -f ~/.ssh/bex -C bex
BEX_SSH_PUBLIC_KEY_FILE=$HOME/.ssh/bex.pub
BEX_SSH_PRIVATE_KEY_FILE=$HOME/.ssh/bex

# --- Terraform remote state: Hetzner Object Storage (S3-compatible) ---
TF_STATE_BUCKET=bex-tfstate
TF_STATE_ENDPOINT=https://s3.eu-central-2.wasabisys.com
TF_STATE_REGION=eu-central-2
TF_STATE_ACCESS_KEY=
TF_STATE_SECRET_KEY=

# --- bex-api bearer token (control-plane seed: restart/suspend/resume) ---
# Protects the public REST + GraphQL API at api.onbex.co. Generate a fresh one:
#   openssl rand -hex 24
# Then create the in-cluster Secret from it once:
#   source .env && kubectl -n bex-system create secret generic bex-api-token --from-literal=token=$BEX_API_TOKEN
BEX_API_TOKEN=
