{
  "permissions": {
    "allow": [
      "Bash(make test:*)",
      "Bash(make lint:*)",
      "Bash(make lint-fix:*)",
      "Bash(make build:*)",
      "Bash(make manifests:*)",
      "Bash(make generate:*)",
      "Bash(make fmt:*)",
      "Bash(make vet:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go build:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl rollout status:*)",
      "Bash(kind get:*)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(clusterctl describe:*)",
      "Bash(yq:*)",
      "Bash(python3 scripts/loopx-guard.py:*)"
    ],
    "deny": ["Read(**/*.kubeconfig)"]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f \"$CLAUDE_PROJECT_DIR/scripts/loopx-guard.py\" || exit 0; python3 \"$CLAUDE_PROJECT_DIR/scripts/loopx-guard.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f \"$CLAUDE_PROJECT_DIR/scripts/loopx-guard.py\" || exit 0; python3 \"$CLAUDE_PROJECT_DIR/scripts/loopx-guard.py\" forget"
          }
        ]
      }
    ]
  }
}
